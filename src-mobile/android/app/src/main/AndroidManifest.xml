<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminders (T14). Each is optional: denying any of them leaves the app fully usable. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-granted exact alarms only; USE_EXACT_ALARM is reserved for alarm-clock apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Purchase verification sends Play tokens only; work records stay on device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A user-enabled shift alarm may play alarm audio in its own bounded foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".DoneAtApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DoneAt.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Shift alarms stay private; no automatic screen wake, lock-screen or full-screen launch. -->
        <service android:name=".alarms.ShiftAlarmRingingService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".alarms.ShiftAlarmRingActivity" android:exported="false"
            android:enableOnBackInvokedCallback="true" />
        <receiver android:name=".alarms.ShiftAlarmReceiver" android:exported="false" />
        <receiver android:name=".alarms.ShiftAlarmSystemEventReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Not exported: only the system's alarm delivery reaches it. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- System broadcasts reach non-exported receivers; no other app can trigger a restore. -->
        <receiver
            android:name=".reminders.ReminderSystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen countdown. Exported for the system's widget host only; it draws from the app's own snapshot. -->
        <receiver
            android:name=".widget.DoneAtWidgetReceiver"
            android:exported="true"
            android:label="@string/widgetPickerSmall">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/doneat_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DoneAtWidgetMediumReceiver"
            android:exported="true"
            android:label="@string/widgetPickerMedium">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_info_medium" />
        </receiver>
        <receiver
            android:name=".widget.DoneAtWidgetLargeReceiver"
            android:exported="true"
            android:label="@string/widgetPickerLarge">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_info_large" />
        </receiver>

        <!-- Salary-free widget suite and countdown styles; legacy receivers above stay stable. -->
        <receiver android:name=".widget.DoneAtWidgetBigReceiver" android:exported="true" android:label="@string/widgetStyleBigName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_big" />
        </receiver>
        <receiver android:name=".widget.DoneAtWidgetRingReceiver" android:exported="true" android:label="@string/widgetStyleRingName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_ring" />
        </receiver>
        <receiver android:name=".widget.DoneAtWidgetTimelineReceiver" android:exported="true" android:label="@string/widgetStyleTimelineName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_timeline" />
        </receiver>
        <receiver android:name=".widget.DoneAtWidgetDetailReceiver" android:exported="true" android:label="@string/widgetStyleDetailName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_detail" />
        </receiver>
        <receiver android:name=".widget.DoneAtWeekWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteWeekName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_week" />
        </receiver>
        <receiver android:name=".widget.DoneAtRosterWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteRosterName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_roster" />
        </receiver>
        <receiver android:name=".widget.DoneAtYearWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteYearName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_year" />
        </receiver>
        <receiver android:name=".widget.DoneAtWeekendWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteWeekendName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_weekend" />
        </receiver>
        <receiver android:name=".widget.DoneAtHolidayWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteHolidayName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_holiday" />
        </receiver>
        <receiver android:name=".widget.DoneAtSummaryWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteSummaryName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_summary" />
        </receiver>
        <receiver android:name=".widget.DoneAtLifeWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteLifeName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_life" />
        </receiver>
        <receiver android:name=".widget.DoneAtFocusWidgetReceiver" android:exported="true" android:label="@string/widgetSuiteFocusName">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/doneat_widget_focus" />
        </receiver>

        <!-- Not exported: only the widget's own refresh alarm reaches it. -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter><action android:name="android.intent.action.LOCALE_CHANGED" /></intent-filter>
        </receiver>

        <!-- Not exported: only the countdown notification's own alarm reaches it. -->
        <receiver
            android:name=".ongoing.OngoingReceiver"
            android:exported="false" />

        <!-- Lends the share card to the share sheet, one file in the cache, for that share only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background" android:orientation="vertical"
    android:padding="16dp">
    <include layout="@layout/widget_preview_header" />
    <FrameLayout android:layout_width="1dp" android:layout_height="10dp" />
    <include layout="@layout/widget_preview_badge" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:fontFeatureSettings="tnum"
        android:includeFontPadding="false" android:text="4:00:00"
        android:textColor="@color/widget_primary" android:textSize="38sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="1dp" android:layout_height="8dp" />
    <include layout="@layout/widget_preview_progress" />
    <FrameLayout android:layout_width="1dp" android:layout_height="14dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/comingUp" android:textColor="@color/widget_secondary" android:textSize="11sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/lunchBreak"
        android:textColor="@color/widget_primary" android:textSize="12sp" />
</LinearLayout>

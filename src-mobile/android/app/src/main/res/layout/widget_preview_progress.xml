<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <ProgressBar style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:max="100" android:progress="48"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_track" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="48%"
        android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The platform date picker stays in DoneAt colours. Time entry uses the stable
  Compose dialog, while the framework date dialog follows the app's light or dark theme.
-->
<resources>
    <style name="DoneAt.DatePickerDialog.Light" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">#C2410C</item>
        <item name="android:datePickerStyle">@style/DoneAt.DatePicker.Light</item>
    </style>

    <style name="DoneAt.DatePicker.Light" parent="android:Widget.Material.Light.DatePicker">
        <item name="android:headerBackground">#C2410C</item>
    </style>

    <style name="DoneAt.DatePickerDialog.Dark" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">#FF9A5C</item>
        <item name="android:datePickerStyle">@style/DoneAt.DatePicker.Dark</item>
    </style>

    <style name="DoneAt.DatePicker.Dark" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">#7A3000</item>
    </style>

</resources>

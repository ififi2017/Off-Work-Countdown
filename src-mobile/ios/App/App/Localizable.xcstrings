    "notificationCapabilityNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون إذن الإشعارات، يمكن أن يظهر النشاط الحي على شاشة القفل فقط. ويستمر العد التنازلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Mitteilungsberechtigung kann nur die Live-Aktivität auf dem Sperrbildschirm erscheinen. Der Countdown läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without notification permission, only the Lock Screen Live Activity can appear. The countdown itself keeps running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso de notificaciones solo puede aparecer la Actividad en Vivo de la pantalla bloqueada. La cuenta atrás sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans autorisation de notification, seule l’activité en direct sur écran verrouillé peut apparaître. Le compte à rebours continue."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना अनुमति के बिना केवल लॉक स्क्रीन लाइव एक्टिविटी दिखाई दे सकती है। काउंटडाउन चलता रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa izin notifikasi, hanya Aktivitas Langsung Layar Kunci yang dapat muncul. Hitung mundur tetap berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza autorizzazione alle notifiche può apparire solo l’attività in tempo reale sulla schermata di blocco. Il conto alla rovescia continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可がなくても、ロック画面のライブアクティビティは表示できます。カウントダウンはそのまま続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 없어도 잠금 화면 실시간 현황은 표시될 수 있습니다. 카운트다운은 계속 실행됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना परवानगीशिवाय फक्त लॉक स्क्रीन लाइव्ह अ‍ॅक्टिव्हिटी दिसू शकते. काउंटडाउन सुरू राहते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão de notificações, apenas a Atividade ao Vivo na tela bloqueada pode aparecer. A contagem regressiva continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без разрешения на уведомления может отображаться только Live Activity на экране блокировки. Обратный отсчёт продолжится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีสิทธิ์แจ้งเตือน จะแสดงได้เฉพาะ Live Activity บนหน้าจอล็อก ส่วนการนับถอยหลังยังคงทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni olmadan yalnızca Kilit Ekranı Canlı Etkinliği görünebilir. Geri sayım çalışmaya devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi không có quyền thông báo, chỉ Hoạt động trực tiếp trên Màn hình khóa có thể xuất hiện. Bộ đếm ngược vẫn tiếp tục chạy."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有通知权限时，只会显示锁定屏幕实时活动；倒计时仍会继续运行。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇通知權限時，只會顯示鎖定畫面即時動態；倒數仍會繼續運作。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有通知權限時，只會顯示鎖定畫面即時動態；倒數仍會繼續運作。"
          }
        }
      }
    },
    "notificationDeniedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالإشعارات في إعدادات النظام، ثم فعّل التذكيرات مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen in den Systemeinstellungen und aktiviere die Erinnerungen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications in system settings, then enable reminders again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones en los ajustes del sistema y vuelve a activar los avisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications dans les réglages système, puis réactivez les rappels."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग में सूचनाओं की अनुमति दें, फिर रिमाइंडर दोबारा चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan notifikasi di pengaturan sistem, lalu aktifkan pengingat lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche nelle impostazioni di sistema, quindi riattiva i promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で通知を許可してから、もう一度リマインダーを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 알림을 허용한 다음 미리 알림을 다시 켜세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंगमध्ये सूचनांना परवानगी द्या आणि स्मरणपत्र पुन्हा सुरू करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita notificações nos ajustes do sistema e ative os lembretes novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите уведомления в системных настройках, затем снова включите напоминания."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการแจ้งเตือนในการตั้งค่าระบบ แล้วเปิดการเตือนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ayarlarında bildirimlere izin verip hatırlatıcıları yeniden aç."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép thông báo trong cài đặt hệ thống rồi bật lại lời nhắc."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许通知，然后重新开启提醒。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許通知，然後重新開啟提醒。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許通知，然後重新開啟提醒。"
          }
        }
      }
    },

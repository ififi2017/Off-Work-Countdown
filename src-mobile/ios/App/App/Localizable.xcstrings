    "focusEndBreakBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تكون مستعدًا، يمكنك اختيار مهمة وبدء الجولة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bereit bist, kannst du eine Aufgabe wählen und die nächste Runde starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose a task and start the next round when you are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando estés listo, puedes elegir una tarea y empezar la siguiente sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes prêt, choisissez une tâche pour démarrer la prochaine session."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप तैयार हों, कोई कार्य चुनकर अगला सत्र शुरू कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat siap, pilih tugas dan mulai sesi berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando vuoi, puoi scegliere un’attività e iniziare la prossima sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら、タスクを選んで次の集中を始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비가 되면 작업을 선택하고 다음 집중을 시작할 수 있어요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार झाल्यावर तुम्ही काम निवडून पुढचे सत्र सुरू करू शकता."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando quiser, escolha uma tarefa e inicie a próxima sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда будете готовы, выберите задачу и начните следующий сеанс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อพร้อม คุณสามารถเลือกงานและเริ่มรอบถัดไปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olduğunda bir görev seçip sonraki oturumu başlatabilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi sẵn sàng, bạn có thể chọn công việc và bắt đầu phiên tiếp theo."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好后，你可以选择任务，开始下一轮专注。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好後，你可以選擇任務，開始下一輪專注。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好後，你可以選擇任務，開始下一輪專注。"
          }
        }
      }
    },

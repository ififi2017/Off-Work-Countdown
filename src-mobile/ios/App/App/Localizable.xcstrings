    "recordsNoObservations": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ملاحظات لهذا اليوم — الجدول ما زال موجودًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keine Beobachtung — der Plan bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing recorded for this day — the schedule is still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay observaciones este día; el horario sigue ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de noté pour ce jour — le planning est toujours là."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन अभी कोई अवलोकन नहीं — शिफ्ट वैसी की वैसी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada observasi hari ini — jadwalnya tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna osservazione per questo giorno: il turno c’è ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の観察はまだない。シフトの土台はそのまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날의 관찰은 아직 없습니다. 근무표는 그대로예요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या दिवशी अजून निरीक्षण नाही — शिफ्ट तशीच आहे."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há observações neste dia — o horário continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этот день наблюдений нет — график на месте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ยังไม่มีการสังเกต — ตารางกะยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için gözlem yok — mesai çizelgesi duruyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ghi nhận ngày này — lịch ca vẫn còn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这天还没有观察记录，排班底图还在。"
          }
        },
        "zh-HK": {
          "stringUnit": {

        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어 타이머 종료를 놓칠 수 있습니다. 시스템 설정에서 켤 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",

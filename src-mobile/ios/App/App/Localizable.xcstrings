    "lifeDetailedIncomeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد تاريخ بدء عملك الحالي، ثم أضف الأعمال السابقة من الأحدث إلى الأقدم. ينتهي كل عمل سابق تلقائيًا عند تاريخ بدء العمل التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege das Startdatum deiner aktuellen Stelle fest und ergänze darunter frühere Stellen. Jede frühere Stelle endet automatisch am Startdatum der nächsten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the start date of your current job, then add earlier jobs below. Each earlier job ends automatically when the next one starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la fecha de inicio de tu empleo actual y añade debajo los anteriores, del más reciente al más antiguo. Cada empleo anterior termina automáticamente cuando comienza el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la date de début de votre emploi actuel, puis ajoutez vos emplois précédents en remontant le temps. Chaque emploi précédent se termine automatiquement au début du suivant."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान नौकरी की आरंभ तिथि तय करें, फिर नीचे पिछली नौकरियाँ नई से पुरानी के क्रम में जोड़ें। हर पिछली नौकरी की समाप्ति तिथि अगली नौकरी की आरंभ तिथि से अपने आप जुड़ जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur tanggal mulai pekerjaan saat ini, lalu tambahkan pekerjaan sebelumnya dari yang terbaru. Setiap pekerjaan sebelumnya otomatis berakhir saat pekerjaan berikutnya dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la data di inizio del lavoro attuale, poi aggiungi i lavori precedenti dal più recente. Ogni lavoro precedente termina automaticamente alla data di inizio del successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の仕事の開始日を設定し、その下に以前の仕事を新しい順に追加します。以前の仕事の終了日は、次の仕事の開始日に自動で設定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 직장의 시작일을 설정한 후 이전 경력을 최근 순서대로 추가하세요. 이전 경력의 종료일은 다음 직장의 시작일로 자동 설정됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्याच्या नोकरीची सुरुवातीची तारीख ठरवा, मग खाली आधीच्या नोकऱ्या नव्या ते जुन्या क्रमाने जोडा. प्रत्येक आधीची नोकरी पुढच्या नोकरीच्या सुरुवातीच्या तारखेला आपोआप संपते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a data de início do emprego atual e adicione os anteriores, do mais recente ao mais antigo. Cada emprego anterior termina automaticamente quando começa o seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите дату начала текущей работы, затем добавьте предыдущие места работы от новых к старым. Дата окончания каждого предыдущего места автоматически совпадает с началом следующего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดวันเริ่มงานปัจจุบัน แล้วเพิ่มงานก่อนหน้าจากล่าสุดไปเก่าสุด งานก่อนหน้าแต่ละงานจะสิ้นสุดโดยอัตโนมัติในวันเริ่มงานถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut işinizin başlangıç tarihini belirleyin, ardından önceki işlerinizi yeniden eskiye doğru ekleyin. Her önceki iş, sonraki işin başladığı tarihte otomatik olarak sona erer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt ngày bắt đầu công việc hiện tại, rồi thêm các công việc trước đó từ mới đến cũ. Mỗi công việc trước đó tự động kết thúc vào ngày công việc tiếp theo bắt đầu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "先设置当前工作的开始日期，再依次添加更早的工作经历。每段往期经历的结束日期会自动衔接后一份工作的开始日期。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先設定目前工作的開始日期，再依次加入更早的工作經歷。每段過往經歷的結束日期會自動銜接下一份工作的開始日期。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "先設定目前工作的開始日期，再依序新增更早的工作經歷。每段過往經歷的結束日期會自動銜接下一份工作的開始日期。"
          }
        }
      }
    },

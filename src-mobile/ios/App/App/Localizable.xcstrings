    "languageFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر هذا لغة التطبيق فقط. أما الاسم على الشاشة الرئيسية ومربّعات حوار النظام فتتبع لغة الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ändert nur die Sprache in der App. Der Name auf dem Home-Bildschirm und Systemdialoge folgen weiterhin der Gerätesprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes the language inside the app. The name on your Home Screen and the system's own dialogs still follow your device language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia el idioma dentro de la app. El nombre en la pantalla de inicio y los diálogos del sistema siguen el idioma del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ne change que la langue dans l’app. Le nom sur l’écran d’accueil et les boîtes de dialogue du système suivent la langue de l’appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल ऐप के अंदर की भाषा बदलता है। होम स्क्रीन पर नाम और सिस्टम के संवाद डिवाइस की भाषा का ही पालन करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya mengubah bahasa di dalam aplikasi. Nama di Layar Utama dan dialog sistem tetap mengikuti bahasa perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cambia solo la lingua all’interno dell’app. Il nome nella schermata Home e le finestre di dialogo di sistema seguono la lingua del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定はアプリ内の言語のみを変更します。ホーム画面の名称やシステムのダイアログは端末の言語に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 앱 안의 언어만 바꿉니다. 홈 화면의 이름과 시스템 대화상자는 기기 언어를 따릅니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हे फक्त अ‍ॅपमधील भाषा बदलते. होम स्क्रीनवरील नाव आणि सिस्टम संवाद डिव्हाइसच्या भाषेनुसारच राहतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto altera apenas o idioma dentro do app. O nome na Tela de Início e as caixas de diálogo do sistema continuam seguindo o idioma do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это меняет язык только внутри приложения. Название на экране «Домой» и системные диалоги по-прежнему следуют языку устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่านี้เปลี่ยนเฉพาะภาษาภายในแอป ชื่อบนหน้าจอโฮมและกล่องโต้ตอบของระบบยังคงใช้ภาษาของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca uygulama içindeki dili değiştirir. Ana Ekran’daki ad ve sistem iletişim kutuları cihaz dilini izlemeye devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập này chỉ đổi ngôn ngữ bên trong ứng dụng. Tên trên Màn hình chính và các hộp thoại hệ thống vẫn theo ngôn ngữ của thiết bị."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此设置只改变 App 内的语言。主屏幕上的名称和系统弹窗仍跟随设备语言。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定只改變 App 內的語言。主畫面上的名稱和系統彈窗仍跟隨裝置語言。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定只會變更 App 內的語言。主畫面上的名稱與系統對話框仍跟隨裝置語言。"
          }
        }
      }
    },

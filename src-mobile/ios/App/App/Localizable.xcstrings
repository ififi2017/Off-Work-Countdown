    "liveActivityScheduleNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنجدول التذكير لهذا الدوام. قد تؤثر أوضاع التركيز وقيود النظام في وقت ظهوره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir planen die Erinnerung für diese Schicht. Fokus-Modi und Systemgrenzen können beeinflussen, wann sie erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll schedule the reminder for this shift. Focus modes and system limits may affect when it appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programaremos el recordatorio de esta jornada. Los modos de concentración y los límites del sistema pueden cambiar cuándo aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous programmerons le rappel pour cette journée. Les modes de concentration et les limites du système peuvent modifier le moment où il apparaît."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हम इस शिफ़्ट का रिमाइंडर शेड्यूल करेंगे। फ़ोकस मोड और सिस्टम की सीमाएँ उसके दिखने का समय बदल सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan menjadwalkan pengingat untuk shift ini. Mode fokus dan batasan sistem dapat memengaruhi waktu tampilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmeremo il promemoria per questo turno. Le modalità Full Immersion e i limiti di sistema possono cambiarne il momento di visualizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシフトのリマインダーを予約します。集中モードやシステムの制限により、表示されるタイミングが変わることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 근무의 알림을 예약합니다. 집중 모드나 시스템 제한에 따라 표시 시각이 달라질 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही या शिफ्टसाठी स्मरणपत्र शेड्यूल करू. फोकस मोड आणि सिस्टीम मर्यादा ते कधी दिसेल हे बदलू शकतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos agendar o lembrete deste turno. Modos de foco e limites do sistema podem alterar quando ele aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы запланируем напоминание для этой смены. Режимы фокусирования и системные ограничения могут повлиять на время его показа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะตั้งเวลาแจ้งเตือนสำหรับกะนี้ โหมดโฟกัสและข้อจำกัดของระบบอาจเปลี่ยนเวลาที่การแจ้งเตือนปรากฏ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vardiya için hatırlatıcıyı planlayacağız. Odak modları ve sistem sınırları, ne zaman görüneceğini etkileyebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ lên lịch nhắc cho ca này. Chế độ tập trung và giới hạn hệ thống có thể ảnh hưởng thời điểm hiển thị."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会为这一班安排提醒；专注模式和系统限制可能影响它何时显示。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我哋會為呢一班安排提醒；專注模式同系統限制可能影響佢幾時顯示。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會為這一班安排提醒；專注模式和系統限制可能影響它何時顯示。"
          }
        }
      }
    },

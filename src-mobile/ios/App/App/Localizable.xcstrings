    "scheduleAlternatingDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسابيع بيوم أو يومي راحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochen mit einem und zwei freien Tagen."
          }
        },

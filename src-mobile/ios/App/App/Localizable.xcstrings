    "lifeIncomeDeclinePreview": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من عمر {{age}} حتى التقاعد، يُحسب الدخل بنسبة {{percent}} من الراتب الحالي. هذا عمر بدء التعديل وليس عمر التقاعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab {{age}} Jahren wird das Einkommen bis zum Ruhestand mit {{percent}} des aktuellen Gehalts berechnet. Das Startalter ist nicht das Rentenalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From age {{age}}, income is calculated at {{percent}} of the current salary until retirement. This is the adjustment age, not the retirement age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde los {{age}} años hasta la jubilación, los ingresos se calculan al {{percent}} del salario actual. Es la edad del ajuste, no la de jubilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de {{age}} ans et jusqu’à la retraite, le revenu est calculé à {{percent}} du salaire actuel. Cet âge est celui de l’ajustement, pas de la retraite."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{age}} वर्ष की उम्र से सेवानिवृत्ति तक आय की गणना वर्तमान वेतन के {{percent}} पर होगी। यह समायोजन शुरू होने की उम्र है, सेवानिवृत्ति की नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai usia {{age}} hingga pensiun, penghasilan dihitung sebesar {{percent}} dari gaji saat ini. Ini usia awal penyesuaian, bukan usia pensiun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai {{age}} anni fino alla pensione, il reddito è calcolato al {{percent}} dello stipendio attuale. È l’età dell’adeguamento, non del pensionamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{age}} 歳から退職まで、現在の給与の {{percent}} で収入を計算します。開始年齢は退職年齢ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{age}}세부터 은퇴까지 현재 급여의 {{percent}}로 계산합니다. 시작 나이는 은퇴 나이가 아닙니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "वयाच्या {{age}} वर्षांपासून निवृत्तीपर्यंत उत्पन्न सध्याच्या पगाराच्या {{percent}} प्रमाणे मोजले जाईल. हे समायोजन सुरू होण्याचे वय आहे, निवृत्तीचे नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos {{age}} anos até a aposentadoria, a renda é calculada em {{percent}} do salário atual. É a idade do ajuste, não da aposentadoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С {{age}} лет до пенсии доход рассчитывается как {{percent}} текущей зарплаты. Это возраст снижения дохода, а не выхода на пенсию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งแต่อายุ {{age}} ปีจนเกษียณ จะคำนวณรายได้เป็น {{percent}} ของเงินเดือนปัจจุบัน อายุเริ่มต้นคืออายุที่ปรับรายได้ ไม่ใช่อายุเกษียณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{age}} yaşından emekliliğe kadar gelir, mevcut maaşın {{percent}} oranında hesaplanır. Bu, emeklilik yaşı değil, ayarlamanın başlangıç yaşıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ {{age}} tuổi đến khi nghỉ hưu, thu nhập được tính bằng {{percent}} lương hiện tại. Đây là tuổi bắt đầu điều chỉnh, không phải tuổi nghỉ hưu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从 {{age}} 岁起，收入按当前薪资的 {{percent}} 计算，直到退休。起始年龄是收入开始下调的年龄，并非退休年龄。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "從 {{age}} 歲起，收入按目前薪酬的 {{percent}} 計算，直到退休。起始年齡是收入開始下調的年齡，並非退休年齡。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從 {{age}} 歲起，收入按目前薪資的 {{percent}} 計算，直到退休。起始年齡是收入開始下調的年齡，並非退休年齡。"
          }
        }
      }
    },

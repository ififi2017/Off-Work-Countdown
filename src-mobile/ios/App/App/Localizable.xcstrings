    "syncDeleteiCloudConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف جميع بيانات DoneAt من iCloud وكل جهاز تم تسجيل دخوله إلى حساب Apple هذا، بما في ذلك هذا الجهاز؟ لا يمكن التراجع عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle DoneAt-Daten aus iCloud und jedem bei diesem Apple-Konto angemeldeten Gerät löschen, einschließlich dieses Geräts? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all DoneAt data from iCloud and every device signed in to this Apple Account, including this device? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los datos de DoneAt de iCloud y todos los dispositivos conectados a esta cuenta de Apple, incluido este dispositivo? Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les données DoneAt d'iCloud et de tous les appareils connectés à ce compte Apple, y compris cet appareil ? Cela ne peut pas être annulé."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से सभी DoneAt डेटा और इस डिवाइस सहित इस Apple खाते में साइन इन किए गए प्रत्येक डिवाइस को हटा दें? इसे असंपादित नहीं किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua data DoneAt dari iCloud dan setiap perangkat yang masuk ke Akun Apple ini, termasuk perangkat ini? Hal ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare tutti i dati DoneAt da iCloud e da tutti i dispositivi collegati a questo account Apple, incluso questo dispositivo? Questa operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud からすべての DoneAt データと、このデバイスを含むこの Apple アカウントにサインインしているすべてのデバイスを削除しますか?これを元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud와 이 기기를 포함하여 이 Apple 계정에 로그인된 모든 기기에서 모든 DoneAt 데이터를 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या उपकरणासह, iCloud वरून सर्व DoneAt डेटा आणि या Apple खात्यामध्ये साइन इन केलेले प्रत्येक डिव्हाइस हटवायचे? हे पूर्ववत केले जाऊ शकत नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir todos os dados DoneAt do iCloud e todos os dispositivos conectados a esta conta Apple, incluindo este dispositivo? Isto não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить все данные DoneAt из iCloud и всех устройств, на которых выполнен вход в эту учетную запись Apple, включая это устройство? Это невозможно отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูล DoneAt ทั้งหมดออกจาก iCloud และอุปกรณ์ทุกเครื่องที่ลงชื่อเข้าใช้บัญชี Apple นี้ รวมถึงอุปกรณ์นี้ด้วยหรือไม่ สิ่งนี้ไม่สามารถยกเลิกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm DoneAt verileri iCloud'dan ve bu cihaz da dahil olmak üzere bu Apple Hesabına giriş yapılan her cihazdan silinsin mi? Bu geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tất cả dữ liệu DoneAt khỏi iCloud và mọi thiết bị đã đăng nhập vào Tài khoản Apple này, bao gồm cả thiết bị này? Điều này không thể hoàn tác được."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 iCloud 和登录这个 Apple 账户的所有设备（包括这台设备）删除全部 DoneAt 数据吗？此操作无法撤销。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺 iCloud 同埋每部登入咗呢個 Apple 帳戶嘅裝置刪除所有 DoneAt 數據，包括呢部裝置？呢個係復原唔到嘅。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從 iCloud 和登入此 Apple 帳戶的每台裝置（包括此裝置）中刪除所有 DoneAt 資料嗎？此操作無法撤銷。"
          }
        }
      }
    },
    "syncDeleteiCloudDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل بيانات DoneAt الخاصة بك من iCloud وكل جهاز موجود على حساب Apple هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Ihre DoneAt-Daten aus iCloud und jedem Gerät auf diesem Apple-Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes your DoneAt data from iCloud and every device on this Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tus datos de DoneAt de iCloud y de todos los dispositivos de esta cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime vos données DoneAt d'iCloud et de tous les appareils de ce compte Apple."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud और इस Apple खाते के प्रत्येक डिवाइस से आपका DoneAt डेटा हटा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus data DoneAt Anda dari iCloud dan setiap perangkat di Akun Apple ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i tuoi dati DoneAt da iCloud e da tutti i dispositivi su questo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoneAt データを iCloud およびこの Apple アカウント上のすべてのデバイスから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 및 이 Apple 계정의 모든 장치에서 DoneAt 데이터를 제거합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा DoneAt डेटा iCloud आणि या Apple खात्यावरील प्रत्येक डिव्हाइसवरून काढून टाकते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove seus dados DoneAt do iCloud e de todos os dispositivos desta conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет ваши данные DoneAt из iCloud и всех устройств в этой учетной записи Apple."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูล DoneAt ของคุณออกจาก iCloud และอุปกรณ์ทุกเครื่องในบัญชี Apple นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoneAt verilerinizi iCloud'dan ve bu Apple Hesabındaki tüm aygıtlardan kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa dữ liệu DoneAt của bạn khỏi iCloud và mọi thiết bị trên Tài khoản Apple này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iCloud 和这个 Apple 账户下的所有设备中移除 DoneAt 数据。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺 iCloud 同埋呢個 Apple 帳戶上面嘅每部裝置入面移除你嘅 DoneAt 數據。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從 iCloud 和此 Apple 帳戶上的每台裝置中刪除您的 DoneAt 資料。"
          }
        }
      }
    },
    "syncDeleteiCloudTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف بيانات iCloud؟"

    "lifeIncomeMethod": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب الماضي بالرواتب المدخلة، وتُحسب فترات الانقطاع بصفر. يستخدم المستقبل الراتب الحالي والمكافآت السنوية المفعلة، أو راتب الملف إن لم تُضبط الإعدادات. لا يُفترض تضخم أو عائد استثماري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Einkommen folgen den eingetragenen Gehältern; Lücken zählen als null. Für die Zukunft gelten die aktuellen Gehaltseinstellungen samt aktivierten Jahresboni, sonst das Profilgehalt. Inflation und Anlageerträge werden nicht angenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History uses entered salaries, with zero income during gaps. Future income uses current salary settings and enabled annual bonuses, or the profile salary if unset. No inflation or investment returns are assumed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pasado usa los salarios introducidos, con ingresos nulos en los intervalos sin empleo. El futuro usa el salario actual y las bonificaciones anuales activadas, o el salario del perfil si no hay ajustes. No se supone inflación ni rendimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passé utilise les salaires saisis, avec un revenu nul pendant les interruptions. L’avenir utilise le salaire actuel et les primes annuelles activées, ou le salaire du profil si rien n’est défini. Inflation et rendements ne sont pas supposés."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली आय दर्ज वेतन से गणना होती है; रोजगार के अंतराल शून्य हैं। भविष्य के लिए वर्तमान वेतन और चालू वार्षिक बोनस, या सेटिंग न होने पर प्रोफ़ाइल वेतन उपयोग होता है। मुद्रास्फीति या निवेश लाभ नहीं माने जाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat memakai gaji yang dimasukkan; masa tanpa pekerjaan bernilai nol. Proyeksi memakai pengaturan gaji saat ini dan bonus tahunan yang aktif, atau gaji profil jika belum diatur. Inflasi dan hasil investasi tidak diasumsikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passato usa gli stipendi inseriti, con reddito nullo nei periodi senza lavoro. Il futuro usa lo stipendio attuale e i premi annuali attivati, oppure lo stipendio del profilo se non impostato. Non presume inflazione o rendimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の収入は入力済みの給与を使い、空白期間はゼロとします。将来の収入は現在の給与設定と有効な年末賞与を使い、未設定ならプロフィールの給与を使います。物価変動や投資収益は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 소득은 입력한 급여로 계산하며 공백 기간은 0입니다. 미래 소득에는 현재 급여 설정과 활성화한 연말 보너스를 사용하고, 미설정 시 프로필 급여를 사용합니다. 물가 변동과 투자 수익은 가정하지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील उत्पन्न नोंदवलेल्या पगारावर मोजले जाते; नोकरीतील खंड शून्य धरला जातो. भविष्यासाठी सध्याचा पगार व सुरू केलेला वार्षिक बोनस, किंवा सेटिंग नसल्यास प्रोफाइलचा पगार वापरला जातो. महागाई किंवा गुंतवणुकीचा परतावा गृहीत धरलेला नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico usa os salários informados, com renda zero nos intervalos sem emprego. O futuro usa o salário atual e os bônus anuais ativados, ou o salário do perfil se não houver configuração. Não considera inflação nem rendimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлый доход рассчитывается по указанным зарплатам, перерывы дают ноль. Будущий доход использует текущую зарплату и включённую годовую премию либо зарплату из профиля, если настройки не заданы. Инфляция и инвестиционный доход не учитываются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายได้ในอดีตใช้เงินเดือนที่กรอก โดยช่วงว่างงานเป็นศูนย์ อนาคตใช้เงินเดือนปัจจุบันและโบนัสประจำปีที่เปิดไว้ หรือเงินเดือนในโปรไฟล์หากยังไม่ตั้งค่า ไม่รวมสมมติฐานเงินเฟ้อหรือผลตอบแทนการลงทุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş gelir girilen maaşlardan hesaplanır; çalışma boşlukları sıfır sayılır. Gelecek gelir mevcut maaş ve etkin yıllık ikramiyeyi, ayarlanmamışsa profil maaşını kullanır. Enflasyon ve yatırım getirisi varsayılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhập quá khứ dùng mức lương đã nhập, thời gian không làm việc bằng 0. Dự báo dùng lương hiện tại và thưởng năm đã bật, hoặc lương hồ sơ nếu chưa thiết lập. Không giả định lạm phát hay lợi nhuận đầu tư."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "历史收入按已填薪资计算，待业空档为零。未来收入使用当前薪资设置及已开启的年终奖，未设置时使用档案薪资。不假设通胀或投资收益。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史收入按已填薪酬計算，待業空檔為零。未來收入使用目前薪酬設定及已開啟的年終獎金，未設定時使用檔案薪酬。不假設通脹或投資收益。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史收入按已填薪資計算，待業空檔為零。未來收入使用目前薪資設定及已開啟的年終獎金，未設定時使用檔案薪資。不假設通膨或投資收益。"
          }
        }
      }
    },
    "lifeIncomeMethodDecline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب الماضي بالرواتب المدخلة، وتُحسب فترات الانقطاع بصفر. يستخدم المستقبل الراتب الحالي والمكافآت السنوية المفعلة، أو راتب الملف إن لم تُضبط الإعدادات. لا يُفترض تضخم أو عائد استثماري. من عمر {{age}} حتى التقاعد، يُحسب الدخل بنسبة {{percent}} من الراتب الحالي. هذا عمر بدء التعديل وليس عمر التقاعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Einkommen folgen den eingetragenen Gehältern; Lücken zählen als null. Für die Zukunft gelten die aktuellen Gehaltseinstellungen samt aktivierten Jahresboni, sonst das Profilgehalt. Inflation und Anlageerträge werden nicht angenommen. Ab {{age}} Jahren wird das Einkommen bis zum Ruhestand mit {{percent}} des aktuellen Gehalts berechnet. Das Startalter ist nicht das Rentenalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History uses entered salaries, with zero income during gaps. Future income uses current salary settings and enabled annual bonuses, or the profile salary if unset. No inflation or investment returns are assumed. From age {{age}}, income is calculated at {{percent}} of the current salary until retirement. This is the adjustment age, not the retirement age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pasado usa los salarios introducidos, con ingresos nulos en los intervalos sin empleo. El futuro usa el salario actual y las bonificaciones anuales activadas, o el salario del perfil si no hay ajustes. No se supone inflación ni rendimientos. Desde los {{age}} años hasta la jubilación, los ingresos se calculan al {{percent}} del salario actual. Es la edad del ajuste, no la de jubilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passé utilise les salaires saisis, avec un revenu nul pendant les interruptions. L’avenir utilise le salaire actuel et les primes annuelles activées, ou le salaire du profil si rien n’est défini. Inflation et rendements ne sont pas supposés. À partir de {{age}} ans et jusqu’à la retraite, le revenu est calculé à {{percent}} du salaire actuel. Cet âge est celui de l’ajustement, pas de la retraite."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली आय दर्ज वेतन से गणना होती है; रोजगार के अंतराल शून्य हैं। भविष्य के लिए वर्तमान वेतन और चालू वार्षिक बोनस, या सेटिंग न होने पर प्रोफ़ाइल वेतन उपयोग होता है। मुद्रास्फीति या निवेश लाभ नहीं माने जाते। {{age}} वर्ष की उम्र से सेवानिवृत्ति तक आय की गणना वर्तमान वेतन के {{percent}} पर होगी। यह समायोजन शुरू होने की उम्र है, सेवानिवृत्ति की नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat memakai gaji yang dimasukkan; masa tanpa pekerjaan bernilai nol. Proyeksi memakai pengaturan gaji saat ini dan bonus tahunan yang aktif, atau gaji profil jika belum diatur. Inflasi dan hasil investasi tidak diasumsikan. Mulai usia {{age}} hingga pensiun, penghasilan dihitung sebesar {{percent}} dari gaji saat ini. Ini usia awal penyesuaian, bukan usia pensiun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passato usa gli stipendi inseriti, con reddito nullo nei periodi senza lavoro. Il futuro usa lo stipendio attuale e i premi annuali attivati, oppure lo stipendio del profilo se non impostato. Non presume inflazione o rendimenti. Dai {{age}} anni fino alla pensione, il reddito è calcolato al {{percent}} dello stipendio attuale. È l’età dell’adeguamento, non del pensionamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の収入は入力済みの給与を使い、空白期間はゼロとします。将来の収入は現在の給与設定と有効な年末賞与を使い、未設定ならプロフィールの給与を使います。物価変動や投資収益は含みません。 {{age}} 歳から退職まで、現在の給与の {{percent}} で収入を計算します。開始年齢は退職年齢ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 소득은 입력한 급여로 계산하며 공백 기간은 0입니다. 미래 소득에는 현재 급여 설정과 활성화한 연말 보너스를 사용하고, 미설정 시 프로필 급여를 사용합니다. 물가 변동과 투자 수익은 가정하지 않습니다. {{age}}세부터 은퇴까지 현재 급여의 {{percent}}로 계산합니다. 시작 나이는 은퇴 나이가 아닙니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील उत्पन्न नोंदवलेल्या पगारावर मोजले जाते; नोकरीतील खंड शून्य धरला जातो. भविष्यासाठी सध्याचा पगार व सुरू केलेला वार्षिक बोनस, किंवा सेटिंग नसल्यास प्रोफाइलचा पगार वापरला जातो. महागाई किंवा गुंतवणुकीचा परतावा गृहीत धरलेला नाही. वयाच्या {{age}} वर्षांपासून निवृत्तीपर्यंत उत्पन्न सध्याच्या पगाराच्या {{percent}} प्रमाणे मोजले जाईल. हे समायोजन सुरू होण्याचे वय आहे, निवृत्तीचे नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico usa os salários informados, com renda zero nos intervalos sem emprego. O futuro usa o salário atual e os bônus anuais ativados, ou o salário do perfil se não houver configuração. Não considera inflação nem rendimentos. Dos {{age}} anos até a aposentadoria, a renda é calculada em {{percent}} do salário atual. É a idade do ajuste, não da aposentadoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлый доход рассчитывается по указанным зарплатам, перерывы дают ноль. Будущий доход использует текущую зарплату и включённую годовую премию либо зарплату из профиля, если настройки не заданы. Инфляция и инвестиционный доход не учитываются. С {{age}} лет до пенсии доход рассчитывается как {{percent}} текущей зарплаты. Это возраст снижения дохода, а не выхода на пенсию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายได้ในอดีตใช้เงินเดือนที่กรอก โดยช่วงว่างงานเป็นศูนย์ อนาคตใช้เงินเดือนปัจจุบันและโบนัสประจำปีที่เปิดไว้ หรือเงินเดือนในโปรไฟล์หากยังไม่ตั้งค่า ไม่รวมสมมติฐานเงินเฟ้อหรือผลตอบแทนการลงทุน ตั้งแต่อายุ {{age}} ปีจนเกษียณ จะคำนวณรายได้เป็น {{percent}} ของเงินเดือนปัจจุบัน อายุเริ่มต้นคืออายุที่ปรับรายได้ ไม่ใช่อายุเกษียณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş gelir girilen maaşlardan hesaplanır; çalışma boşlukları sıfır sayılır. Gelecek gelir mevcut maaş ve etkin yıllık ikramiyeyi, ayarlanmamışsa profil maaşını kullanır. Enflasyon ve yatırım getirisi varsayılmaz. {{age}} yaşından emekliliğe kadar gelir, mevcut maaşın {{percent}} oranında hesaplanır. Bu, emeklilik yaşı değil, ayarlamanın başlangıç yaşıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhập quá khứ dùng mức lương đã nhập, thời gian không làm việc bằng 0. Dự báo dùng lương hiện tại và thưởng năm đã bật, hoặc lương hồ sơ nếu chưa thiết lập. Không giả định lạm phát hay lợi nhuận đầu tư. Từ {{age}} tuổi đến khi nghỉ hưu, thu nhập được tính bằng {{percent}} lương hiện tại. Đây là tuổi bắt đầu điều chỉnh, không phải tuổi nghỉ hưu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "历史收入按已填薪资计算，待业空档为零。未来收入使用当前薪资设置及已开启的年终奖，未设置时使用档案薪资。不假设通胀或投资收益。 从 {{age}} 岁起，收入按当前薪资的 {{percent}} 计算，直到退休。起始年龄是收入开始下调的年龄，并非退休年龄。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史收入按已填薪酬計算，待業空檔為零。未來收入使用目前薪酬設定及已開啟的年終獎金，未設定時使用檔案薪酬。不假設通脹或投資收益。 從 {{age}} 歲起，收入按目前薪酬的 {{percent}} 計算，直到退休。起始年齡是收入開始下調的年齡，並非退休年齡。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史收入按已填薪資計算，待業空檔為零。未來收入使用目前薪資設定及已開啟的年終獎金，未設定時使用檔案薪資。不假設通膨或投資收益。 從 {{age}} 歲起，收入按目前薪資的 {{percent}} 計算，直到退休。起始年齡是收入開始下調的年齡，並非退休年齡。"
          }
        }
      }
    },

    "plusLifetimeWhileSubscribed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء بدفعة واحدة لا يُلغي اشتراكك الحالي. بعد الشراء أوقفه من «إدارة الاشتراك»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einmalkauf kündigt dein laufendes Abo nicht. Schalte es danach unter „Abo verwalten“ ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buying lifetime does not cancel your current subscription. After this purchase, turn the subscription off in Manage subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra para siempre no cancela tu suscripción actual. Desactívala después en «Gestionar suscripción»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat à vie n’annule pas votre abonnement en cours. Désactivez-le ensuite dans « Gérer l’abonnement »."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की ख़रीद आपकी चल रही सदस्यता रद्द नहीं करती। ख़रीदने के बाद उसे “सदस्यता प्रबंधित करें” से बंद कर दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membeli sekali bayar tidak membatalkan langganan yang sedang berjalan. Setelah membeli, matikan lewat “Kelola langganan”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto per sempre non annulla l’abbonamento in corso. Disattivalo poi da «Gestisci abbonamento»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りを購入しても、いまのサブスクリプションは自動で解約されません。購入後に「サブスクリプションを管理」から停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생을 구입해도 지금의 구독은 자동으로 취소되지 않습니다. 구입 후 ‘구독 관리’에서 해지해 주세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एकदाच घेतल्याने तुमची सुरू असलेली सदस्यता रद्द होत नाही. खरेदीनंतर ती “सदस्यता व्यवस्थापित करा” मधून बंद करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vitalício não cancela a sua subscrição atual. Desative-a depois em «Gerir subscrição»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка навсегда не отменяет текущую подписку. После покупки отключите её в «Управлять подпиской»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อแบบจ่ายครั้งเดียวไม่ยกเลิกการสมัครที่ใช้อยู่ ซื้อแล้วให้ไปปิดที่ “จัดการการสมัคร”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma mevcut aboneliğini iptal etmez. Sonrasında “Aboneliği yönet” bölümünden kapat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua bản trả một lần không tự hủy đăng ký hiện tại. Sau khi mua, hãy tắt nó ở “Quản lý đăng ký”."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "买终身不会自动取消你现在的订阅。买完请到「管理订阅」把它关掉。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",

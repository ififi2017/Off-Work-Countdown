    "debugCaptureScenariosDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ كل سيناريو يوم الجمعة 23 أغسطس الساعة 14:22 ويستمر بالوقت الفعلي. تذكيرات الغداء والصحة وتقدم نهاية الدوام مفعّلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Szenario beginnt am Freitag, 23. August, um 14:22 Uhr und läuft in Echtzeit weiter. Pausen-, Gesundheits- und Feierabend-Fortschrittserinnerungen sind aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each scenario starts on Friday, Aug 23 at 14:22 and continues in real time. Lunch, health and off-work progress reminders are enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escenario comienza el viernes 23 de agosto a las 14:22 y continúa en tiempo real. Los avisos de comida, salud y progreso hasta la salida están activados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque scénario commence le vendredi 23 août à 14:22 et continue en temps réel. Les rappels de pause, de santé et de progression jusqu’à la fin sont activés."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हर परिदृश्य शुक्रवार, 23 अगस्त को 14:22 से शुरू होकर वास्तविक समय में चलता है। लंच, स्वास्थ्य और छुट्टी-प्रगति रिमाइंडर चालू हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap skenario dimulai Jumat, 23 Agustus pukul 14.22 dan berlanjut secara real time. Pengingat makan siang, kesehatan, dan progres pulang diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scenario inizia venerdì 23 agosto alle 14:22 e prosegue in tempo reale. I promemoria per pausa, salute e avanzamento verso la fine sono attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各シナリオは8月23日（金）14:22から実時間で進みます。昼休み、健康、退勤進捗通知は有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 시나리오는 8월 23일 금요일 14:22부터 실제 시간으로 진행됩니다. 점심, 건강, 퇴근 진행 알림이 켜집니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक परिस्थिती शुक्रवार, 23 ऑगस्ट रोजी 14:22 पासून सुरू होऊन प्रत्यक्ष वेळेत पुढे जाते. जेवण, आरोग्य आणि काम संपण्याच्या प्रगतीच्या सूचना सुरू आहेत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cenário começa na sexta-feira, 23 de agosto, às 14:22 e continua em tempo real. Os lembretes de almoço, saúde e progresso até à saída estão ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый сценарий начинается в пятницу, 23 августа, в 14:22 и продолжается в реальном времени. Напоминания об обеде, здоровье и прогрессе до конца работы включены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละสถานการณ์เริ่มวันศุกร์ที่ 23 สิงหาคม เวลา 14:22 และเดินตามเวลาจริง โดยเปิดการเตือนพักกลางวัน สุขภาพ และความคืบหน้าก่อนเลิกงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her senaryo 23 Ağustos Cuma 14:22’de başlar ve gerçek zamanda ilerler. Öğle arası, sağlık ve iş bitişi ilerleme hatırlatıcıları açıktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi kịch bản bắt đầu lúc 14:22 Thứ Sáu, ngày 23 tháng 8 và chạy theo thời gian thực. Nhắc giờ ăn trưa, sức khỏe và tiến độ tan làm đều được bật."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所有场景从 8 月 23 日星期五 14:22 开始，并按真实时间继续；午休、健康和下班多进度提醒均已开启。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有情境由 8 月 23 日星期五 14:22 開始，並按真實時間繼續；午休、健康和下班進度提醒均已開啟。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有情境由 8 月 23 日星期五 14:22 開始，並按真實時間繼續；午休、健康和下班進度提醒均已開啟。"
          }
        }
      }
    },

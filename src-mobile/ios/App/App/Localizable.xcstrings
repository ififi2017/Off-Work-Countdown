    "microBreakEffectiveTimeNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب وقت العمل الفعلي فقط؛ لا تنبيهات أثناء الغداء أو بعد العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur effektive Arbeitszeit zählt; in Pausen und nach Feierabend gibt es keine Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only effective work time counts; lunch and off-hours never trigger reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuenta el trabajo efectivo; no se avisa durante la comida ni fuera del horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le travail effectif compte ; aucun rappel au déjeuner ni après le travail."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल प्रभावी कार्य समय गिना जाता है; भोजनावकाश या काम के बाद सूचना नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya waktu kerja efektif yang dihitung; tidak ada pengingat saat makan siang atau setelah kerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta solo il lavoro effettivo; niente avvisi a pranzo o fuori orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実働時間のみを計測し、昼休みや勤務外には通知しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효 근무 시간만 계산하며 점심시간과 퇴근 후에는 알리지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त प्रभावी कामाचा वेळ मोजला जातो; दुपारच्या सुट्टीत किंवा कामानंतर सूचना नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só conta o trabalho efetivo; sem avisos no almoço ou fora do expediente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывается только активная работа; на обеде и после работы уведомлений нет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับเฉพาะเวลาทำงานจริง ไม่เตือนช่วงพักกลางวันหรือหลังเลิกงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca etkin çalışma sayılır; öğle molasında ve mesai dışında bildirim yoktur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tính thời gian làm việc hiệu quả; không nhắc lúc nghỉ trưa hay ngoài giờ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只计算有效工作时间；午休和下班后不会提醒。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只計有效工作時間；午休及收工後不會提醒。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只計算有效工作時間；午休與下班後不會提醒。"
          }
        }
      }
    },

    "extendedShiftTypeInUse": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال النمط يستخدم هذه المناوبة. عيّن لتلك الأيام مناوبة أخرى أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Muster nutzt diese Schicht noch. Diesen Tagen zuerst eine andere Schicht geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pattern still uses this shift. Give those days another shift first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ciclo aún usa este turno. Asigna primero otro turno a esos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cycle utilise encore ce service. Attribuez d’abord un autre service à ces jours."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम में अभी भी यह शिफ़्ट इस्तेमाल हो रही है। पहले उन दिनों को कोई दूसरी शिफ़्ट दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola masih memakai sif ini. Berikan sif lain untuk hari-hari itu terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ciclo usa ancora questo turno. Assegna prima un altro turno a quei giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パターンの中にまだこのシフトの日があります。先にその日を別のシフトに変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 패턴에 이 근무를 쓰는 날이 있습니다. 먼저 그날들을 다른 근무로 바꿔 주세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रमात अजूनही ही शिफ्ट वापरली जात आहे. आधी त्या दिवसांना दुसरी शिफ्ट द्या."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ciclo ainda usa este turno. Atribua primeiro outro turno a esses dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл ещё использует эту смену. Сначала назначьте этим дням другую смену."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบยังใช้กะนี้อยู่ โปรดเปลี่ยนวันเหล่านั้นเป็นกะอื่นก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen bu vardiyayı hâlâ kullanıyor. Önce o günlere başka bir vardiya verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ vẫn đang dùng ca này. Hãy đổi những ngày đó sang ca khác trước."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "排班规律里还有日子用着这个班次，先把这些日子换成其他班次。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "排班規律入面仲有日子用緊呢個班次，請先將嗰啲日子換成其他班次。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "排班規律裡還有日子使用這個班次，請先把這些日子換成其他班次。"
          }
        }
      }
    },

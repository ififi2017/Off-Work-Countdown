    "recordsOperationUnsupportedVersion": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت هذه النسخة الاحتياطية بإصدار أحدث. حدّث التطبيق قبل استيرادها."

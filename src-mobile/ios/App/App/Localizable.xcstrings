    "onboardingLunchNotifyHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سننبهك عند بداية الاستراحة ونهايتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Beginn und Ende der Pause wirst du erinnert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be notified when lunch starts and ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos al empezar y terminar el almuerzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez prévenu au début et à la fin de la pause."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लंच शुरू और खत्म होने पर बताया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan diberi tahu saat istirahat mulai dan selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisiamo all’inizio e alla fine della pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩の始まりと終わりにお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점심 시작과 끝에 알려 드려요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लंच सुरू आणि संपताना कळवले जाईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será avisado no início e no fim do almoço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы напомним о начале и конце обеда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะแจ้งเมื่อพักเริ่มและจบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğle arasının başında ve sonunda haber verilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được báo khi giờ nghỉ bắt đầu và kết thúc."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "午休开始和结束都会提醒你。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "午休開始同結束都會提醒你。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "午休開始和結束都會提醒你。"
          }
        }
      }
    },
    "onboardingOfflineBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حساب. يعمل دون شبكة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto. Funktioniert ohne Netz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. Works without a network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta. Funciona sin red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte. Fonctionne hors ligne."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अकाउंट नहीं। बिना नेटवर्क चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun. Berjalan tanpa jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account. Funziona senza rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要。ネットなしで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이. 네트워크 없이도 됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते नाही. नेटवर्कशिवाय चालते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta. Funciona sem rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта. Работает без сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี ใช้ได้โดยไม่ต้องต่อเน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok. Ağ olmadan çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Dùng được khi mất mạng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "不用账号，也不依赖网络。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "唔使開戶口，亦唔依賴網絡。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "不用帳號，也不依賴網路。"
          }
        }
      }
    },

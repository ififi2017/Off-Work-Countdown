          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your break is complete. Choose a task to begin the next round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descanso ha terminado. Elige una tarea para iniciar la siguiente ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

    "singleWeekWorkdayDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق فقط على أسبوع الراحة ليوم واحد. اليوم المحدد من عطلة الأسبوع هو يوم عمل، واليوم الآخر راحة. في أسبوع الراحة ليومين يكون السبت والأحد يومي راحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Wochen mit einem freien Tag. Der gewählte Wochenendtag ist ein Arbeitstag, der andere ist frei. In Wochen mit zwei freien Tagen sind Samstag und Sonntag frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only applies to single-rest weeks. The selected day is the weekend day you work; the other weekend day is off. In double-rest weeks, both Saturday and Sunday are off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica a las semanas con un día libre. El día elegido es el día de trabajo del fin de semana y el otro es libre. En las semanas con dos días libres, sábado y domingo son libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique uniquement aux semaines avec un jour de repos. Le jour choisi est travaillé et l’autre jour du week-end est libre. Les semaines avec deux jours de repos gardent le samedi et le dimanche libres."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एक छुट्टी वाले सप्ताह पर लागू होता है। चुना हुआ सप्ताहांत दिन काम का दिन है और दूसरा दिन छुट्टी है। दो छुट्टी वाले सप्ताह में शनिवार और रविवार दोनों छुट्टी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berlaku untuk minggu dengan satu hari libur. Hari yang dipilih adalah hari kerja akhir pekan; hari lainnya libur. Pada minggu dengan dua hari libur, Sabtu dan Minggu sama-sama libur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale solo per le settimane con un giorno libero. Il giorno scelto è lavorativo e l’altro giorno del weekend è libero. Nelle settimane con due giorni liberi, sabato e domenica sono entrambi liberi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週休1日の週だけに適用されます。選んだ曜日が出勤日で、もう一方の週末は休日です。週休2日の週は土日とも休日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 1일 휴무 주에만 적용됩니다. 선택한 주말 요일에 근무하고 다른 날은 쉽니다. 주 2일 휴무 주에는 토요일과 일요일 모두 쉽니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त एक सुट्टीच्या आठवड्याला लागू. निवडलेला शनिवार किंवा रविवार कामाचा दिवस आहे आणि दुसरा दिवस सुट्टीचा. दोन सुट्ट्यांच्या आठवड्यात शनिवार आणि रविवार दोन्ही सुट्टीचे असतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se apenas às semanas com uma folga. O dia escolhido é o dia de trabalho no fim de semana; o outro é folga. Nas semanas com duas folgas, sábado e domingo são dias livres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует только в неделю с одним выходным. Выбранный день — рабочий, а второй день выходных — свободный. В неделю с двумя выходными суббота и воскресенье свободны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะสัปดาห์ที่หยุดหนึ่งวัน วันที่เลือกคือวันทำงานช่วงสุดสัปดาห์ ส่วนอีกวันเป็นวันหยุด สำหรับสัปดาห์ที่หยุดสองวัน ทั้งวันเสาร์และวันอาทิตย์เป็นวันหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir izin günlü haftalarda geçerlidir. Seçtiğiniz hafta sonu günü çalışma günüdür, diğeri izindir. İki izin günlü haftalarda cumartesi ve pazar tatildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ áp dụng cho tuần nghỉ một ngày. Ngày cuối tuần được chọn là ngày làm việc, ngày còn lại là ngày nghỉ. Trong tuần nghỉ hai ngày, cả thứ Bảy và Chủ nhật đều được nghỉ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在单休周生效：你选择的是需要上班的周末日，另一天休息；双休周的周六、周日都休息。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只在單休週生效：你選擇的是需要上班的週末日，另一天休息；雙休週的星期六、星期日都休息。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只在單休週生效：你選擇的是需要上班的週末日，另一天休息；雙休週的週六、週日都休息。"
          }
        }
      }
    },

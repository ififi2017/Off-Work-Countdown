    "lifeWorkPeriodBasis": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستند المراحل إلى ملف حياتك. الوقت المنقضي لا يمثل ساعات العمل المسجلة فعليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Phasen basieren auf deinem Lebensprofil. Vergangene Zeit entspricht nicht erfassten Arbeitsstunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stages follow your life profile. Elapsed time does not represent recorded hours worked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etapas se basan en tu perfil de vida. El tiempo transcurrido no equivale a horas de trabajo registradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes suivent votre profil de vie. Le temps écoulé ne correspond pas aux heures de travail enregistrées."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण आपकी जीवन प्रोफ़ाइल पर आधारित हैं। बीता समय रिकॉर्ड किए गए वास्तविक काम के घंटों को नहीं दर्शाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahap mengikuti profil hidupmu. Waktu yang berlalu bukan jumlah jam kerja yang tercatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fasi si basano sul tuo profilo di vita. Il tempo trascorso non corrisponde alle ore di lavoro registrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライフプロフィールに基づく区分です。経過した期間は、記録された実際の労働時間を表すものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인생 프로필에 따른 단계입니다. 지나온 기간은 기록된 실제 근무 시간을 뜻하지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "टप्पे तुमच्या जीवन प्रोफाइलवर आधारित आहेत. गेलेला काळ म्हणजे नोंदवलेले प्रत्यक्ष कामाचे तास नाहीत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As etapas seguem seu perfil de vida. O tempo decorrido não representa horas de trabalho registradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этапы основаны на вашем жизненном профиле. Прошедшее время не равно записанным рабочим часам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงชีวิตอิงตามข้อมูลชีวิตของคุณ เวลาที่ผ่านไปไม่ได้หมายถึงชั่วโมงทำงานจริงที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönemler yaşam profiline dayanır. Geçen süre, kaydedilmiş çalışma saatlerini temsil etmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giai đoạn dựa trên hồ sơ cuộc đời. Thời gian đã qua không phải số giờ làm việc thực tế đã ghi nhận."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "按人生档案划分阶段；已走过的阶段不代表已记录的实际工时。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "按人生檔案劃分階段；已走過的階段不代表已記錄的實際工時。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "依人生檔案劃分階段；已走過的階段不代表已記錄的實際工時。"
          }
        }
      }
    },

    "scheduleOffSummaryNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخفى إجماليات التقويم عند إيقاف الجدول؛ ويظل أجر اليوم متاحًا عند تفعيل الراتب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ausgeschaltetem Zeitplan werden Kalendersummen ausgeblendet; der Tagesverdienst bleibt bei aktivierter Gehaltsanzeige verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar totals are hidden while scheduling is off; daily pay remains available when salary is enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales del calendario se ocultan al desactivar el horario; el salario diario sigue disponible si está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux du calendrier sont masqués lorsque le planning est désactivé ; le salaire du jour reste disponible si son affichage est activé."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल बंद होने पर कैलेंडर योग छिपे रहते हैं; वेतन चालू होने पर दैनिक कमाई उपलब्ध रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total kalender disembunyikan saat jadwal nonaktif; pendapatan harian tetap tersedia jika gaji diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali del calendario sono nascosti quando l’orario è disattivato; il compenso giornaliero resta disponibile se lo stipendio è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールがオフの間はカレンダー集計を非表示にします。給与を有効にすると当日の給与は表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정이 꺼져 있으면 캘린더 합계가 숨겨집니다. 급여를 켜면 오늘의 급여는 계속 표시됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "वेळापत्रक बंद असताना दिनदर्शिकेतील बेरीज लपते; पगार सुरू असल्यास दिवसाची कमाई दिसते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais do calendário ficam ocultos com o horário desativado; o ganho diário continua disponível quando o salário está ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выключенном графике итоги календаря скрыты; дневной заработок остаётся доступен, если включена зарплата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดรวมปฏิทินจะถูกซ่อนเมื่อปิดตาราง แต่รายได้รายวันยังแสดงได้เมื่อเปิดเงินเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program kapalıyken takvim toplamları gizlenir; maaş açıksa günlük kazanç görünmeye devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng kết lịch sẽ bị ẩn khi tắt lịch; thu nhập trong ngày vẫn có nếu đã bật lương."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭排班后不显示日历汇总；启用薪资后仍会显示当日收入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉排班後不顯示日曆摘要；啟用薪酬後仍會顯示當日收入。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉排班後不顯示行事曆摘要；啟用薪資後仍會顯示當日收入。"
          }
        }
      }
    },

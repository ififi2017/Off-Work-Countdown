        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초과 근무는 평소 시급으로 추산하며 가산율은 적용하지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ओव्हरटाइम तुमच्या नेहमीच्या तासाच्या दराने अंदाजित होतो, गुणक नाही."
          }

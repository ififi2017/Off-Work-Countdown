    "onboardingEverywhereTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّك التنازلي في لمحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Countdown auf einen Blick"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your countdown, at a glance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta atrás de un vistazo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte à rebours en un coup d’œil"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र में उलटी गिनती"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur dalam sekilas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto alla rovescia a colpo d’occhio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと目でカウントダウン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한눈에 보는 카운트다운"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एका नजरेत उलटी गणना"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contagem em um relance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчёт всегда на виду"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเวลาที่เหลือได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayımınız bir bakışta"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh thời gian còn lại"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "随时查看倒计时"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時查看倒數"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時查看倒數"
          }
        }
      }
    },
    "onboardingFinaleMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أكملت الإعداد، أهلًا بك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung ist abgeschlossen. Willkommen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're all set. Welcome!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has terminado la configuración. ¡Te damos la bienvenida!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration est terminée. Bienvenue !"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सेटअप पूरा हो गया है। स्वागत है!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyiapan selesai. Selamat datang!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai completato la configurazione. Ti diamo il benvenuto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が完了しました。ようこそ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 완료했습니다. 환영합니다!"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे सेटअप पूर्ण झाले आहे. स्वागत आहे!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração foi concluída. Boas-vindas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка завершена. Добро пожаловать!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าเสร็จแล้ว ยินดีต้อนรับ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulumu tamamladınız. Hoş geldiniz!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã hoàn tất thiết lập. Chào mừng bạn!"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你已完成配置，欢迎使用！"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你已完成設定，歡迎使用！"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你已完成設定，歡迎使用！"

    "onboardingPlusFocusBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التركيز يحول المهمة إلى بومودورو داخل مناوبتك، ثم يبقي الاستراحة التالية جاهزة حتى تختار أن تبدأها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fokus verwandelt eine Aufgabe innerhalb Ihrer Schicht in einen Pomodoro und hält dann die nächste Pause bereit, bis Sie sich dazu entschließen, damit zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus turns a task into a pomodoro inside your shift, then keeps the next break ready until you choose to begin it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enfoque convierte una tarea en un pomodoro dentro de tu turno, luego mantiene listo el siguiente descanso hasta que decidas comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus transforme une tâche en pomodoro au sein de votre quart de travail, puis garde la prochaine pause prête jusqu'à ce que vous choisissiez de la commencer."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "फोकस आपकी शिफ्ट के अंदर एक कार्य को पोमोडोरो में बदल देता है, फिर अगला ब्रेक तब तक तैयार रखता है जब तक आप इसे शुरू करने का निर्णय नहीं लेते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus mengubah tugas menjadi pomodoro di dalam shift Anda, lalu menyiapkan istirahat berikutnya sampai Anda memilih untuk memulainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentrazione trasforma un'attività in un pomodoro all'interno del tuo turno, quindi tiene pronta la pausa successiva finché non decidi di iniziarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中すると、シフト内でタスクがポモドーロに変わり、開始を選択するまで次の休憩の準備が整います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중은 근무 시간 내 작업을 뽀모도로로 바꾸고, 시작하기로 선택할 때까지 다음 휴식 시간을 준비 상태로 유지합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "फोकस तुमच्या शिफ्टमध्ये एखाद्या टास्कला पोमोडोरोमध्ये बदलते, त्यानंतर तुम्ही ते सुरू करणे निवडले नाही तोपर्यंत पुढील ब्रेक तयार ठेवतो."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O foco transforma uma tarefa em um pomodoro dentro do seu turno e mantém o próximo intervalo pronto até você decidir iniciá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус превращает задачу в «помидор» внутри вашей смены, а затем сохраняет готовность к следующему перерыву, пока вы не решите его начать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟกัสเปลี่ยนงานให้กลายเป็น Pomodoro ภายในกะของคุณ จากนั้นเตรียมช่วงพักถัดไปให้พร้อมจนกว่าคุณจะเลือกที่จะเริ่มงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanma, vardiyanızda bir görevi pomodoroya dönüştürür ve siz başlamayı seçene kadar bir sonraki molayı hazır tutar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tập trung biến một nhiệm vụ thành một pomodoro trong ca làm việc của bạn, sau đó giữ sẵn thời gian nghỉ tiếp theo cho đến khi bạn chọn bắt đầu nó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "专注会把任务排进班内的番茄钟；完成后，下一段休息会等你亲自开始。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "專注喺你嘅班次入面將一個任務變成一個番茄，然後為下一個休息做好準備，直至你選擇開始為止。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "專注將一項任務變成輪班中的番茄鐘，然後為下一次休息做好準備，直到你選擇開始它。"
          }
        }
      }
    },
    "onboardingPlusFocusBreakBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المهمة التالية تنتظرك حتى تصبح جاهزًا. لا شيء يبدأ من تلقاء نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Aufgabe wartet, bis Sie bereit sind. Nichts beginnt von alleine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next task waits until you are ready. Nothing starts on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente tarea espera hasta que estés listo. Nada empieza por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche suivante attend que vous soyez prêt. Rien ne démarre tout seul."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अगला कार्य आपके तैयार होने तक प्रतीक्षा करता है। कोई भी चीज़ अपने आप शुरू नहीं होती."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas selanjutnya menunggu sampai Anda siap. Tidak ada yang dimulai dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo compito attende finché non sei pronto. Niente inizia da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のタスクは、準備が完了するまで待機します。何もそれ自体では始まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 작업은 준비가 될 때까지 기다립니다. 아무것도 저절로 시작되지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आपण तयार होईपर्यंत पुढील कार्य प्रतीक्षा करते. काहीही स्वतःपासून सुरू होत नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima tarefa espera até que você esteja pronto. Nada começa sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее задание ждет, пока вы не будете готовы. Ничто не начинается само по себе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานต่อไปรอจนกว่าคุณจะพร้อม ไม่มีอะไรเริ่มต้นได้ด้วยตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki görev siz hazır olana kadar bekler. Hiçbir şey kendi kendine başlamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ tiếp theo đợi cho đến khi bạn sẵn sàng. Không có gì tự nó bắt đầu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下一项任务会等你准备好，不会自动开始。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個任務會等到你準備好。冇嘢係自己開始嘅。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個任務會等到您準備好為止。沒有什麼是自行開始的。"
          }
        }
      }
    },

    "plusThanksBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح Plus جاهزًا. نتمنى أن تشعر بأن الوقت الذي تستعيده أصبح ملكك حقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ist bereit. Wir hoffen, dass die zurückgewonnene Zeit wirklich dir gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus is ready. We hope the time it helps you reclaim feels unmistakably yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus está listo. Esperamos que el tiempo recuperado se sienta realmente tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus est prêt. Nous espérons que le temps retrouvé vous appartiendra pleinement."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus तैयार है। आशा है कि इससे बचाया गया समय सच में आपका महसूस हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus sudah siap. Semoga waktu yang berhasil kamu ambil kembali benar-benar terasa milikmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus è pronto. Speriamo che il tempo che ti aiuta a recuperare sia davvero tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusの準備ができました。取り戻した時間が、あなた自身の時間になりますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus가 준비되었습니다. 되찾은 시간이 온전히 당신의 시간이 되길 바랍니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus तयार आहे. त्यातून परत मिळालेला वेळ खरोखर तुमचाच वाटो."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plus está pronto. Esperamos que o tempo que ajuda a recuperar pareça verdadeiramente seu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus готов. Надеемся, что возвращённое с его помощью время будет ощущаться по-настоящему вашим."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus พร้อมแล้ว หวังว่าเวลาที่ช่วยให้คุณได้คืนมาจะรู้สึกว่าเป็นของคุณอย่างแท้จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus hazır. Geri kazanmanıza yardım ettiği zamanın gerçekten size ait hissettirmesini dileriz."
          }
        },
        "vi": {

    "microBreakMessages.1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضت {{minutes}} دقيقة متواصلة. قم واشرب بعض الماء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sitzt seit {{minutes}} Minuten dran. Hol dir etwas Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been at it for {{minutes}} minutes. Go get some water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas {{minutes}} minutos seguidos. Bebe un poco de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous y êtes depuis {{minutes}} minutes. Allez boire un peu d’eau."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} मिनट से लगातार काम चल रहा है। उठकर थोड़ा पानी पी लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah {{minutes}} menit nonstop. Ambil air minum dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavori da {{minutes}} minuti. Bevi un po’ d’acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} 分続けて作業しています。水を一口どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}}분째 이어서 하고 있어요. 물 한 잔 마시고 와요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} मिनिटे सलग काम सुरू आहे. उठून थोडे पाणी प्या."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está nisso há {{minutes}} minutos. Vá beber um pouco de água."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы работаете уже {{minutes}} мин. Сходите за водой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำต่อเนื่องมา {{minutes}} นาทีแล้ว ลุกไปดื่มน้ำสักหน่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} dakikadır aralıksız çalışıyorsun. Kalk, biraz su iç."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã làm liền {{minutes}} phút. Đứng dậy uống chút nước nhé."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已经连续工作 {{minutes}} 分钟了，起来喝口水吧。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連續做咗 {{minutes}} 分鐘，起身飲啖水啦。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連續工作 {{minutes}} 分鐘了，起來喝口水吧。"
          }
        }
      }
    },
    "microBreakMessages.2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} دقيقة دون توقف. قف وحرّك كتفيك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} Minuten am Stück. Steh auf und lockere die Schultern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minutes straight. Stand up and roll your shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minutos sin parar. Levántate y suelta los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minutes d’affilée. Levez-vous et détendez les épaules."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} मिनट हो गए। खड़े होकर कंधे ढीले कर लें।"
          }
        },
        "id": {
          "stringUnit": {

    "extendedScheduleDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناوبات صباحية ومسائية وليلية بنمط متكرر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh-, Spät- und Nachtschichten im festen Rhythmus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix early, late and night shifts in a repeating pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Turnos de mañana, tarde y noche en un ciclo que se repite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Services du matin, du soir et de nuit selon un cycle."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह, शाम और रात की शिफ़्ट एक तय क्रम में दोहराएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sif pagi, sore, dan malam dalam pola berulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Turni di mattina, pomeriggio e notte in un ciclo che si ripete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早番・遅番・夜勤などを、決まった周期で繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간·오후·야간 근무를 정해진 주기로 반복합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सकाळ, संध्याकाळ आणि रात्रीच्या शिफ्ट ठरलेल्या क्रमाने पुन्हा वापरा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Turnos da manhã, da tarde e da noite num ciclo que se repete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утренние, вечерние и ночные смены по повторяющемуся циклу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กะเช้า กะบ่าย และกะดึก วนตามรูปแบบที่ตั้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah, akşam ve gece vardiyalarını tekrar eden bir düzende planlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca sáng, ca chiều, ca đêm lặp lại theo chu kỳ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "早班、晚班、夜班等多种班次，按规律循环。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "早更、晚更、夜更等唔同班次，按規律循環。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "早班、晚班、夜班等多種班次，依規律循環。"
          }
        }
      }
    },

    "recordsHeatScale": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما زاد العمل الإضافي زادت قوة اللون؛ التقديرات باهتة ومخططة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Überstunden, kräftigere Farbe. Schätzungen sind blass und schraffiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More overtime, stronger color. Estimates are pale and hatched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más horas extra, color más intenso. Las estimaciones son claras y rayadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus d’heures supplémentaires, couleur plus intense. Les estimations sont pâles et hachurées."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक ओवरटाइम, गहरा रंग। अनुमान हल्के रंग और तिरछी रेखाओं में हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin banyak lembur, makin pekat warnanya. Perkiraan berwarna pucat dan bergaris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più straordinari, colore più intenso. Le stime sono chiare e tratteggiate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残業が多いほど色が濃くなります。推定は淡い色と斜線で表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초과근무가 많을수록 색이 진해집니다. 예상 시간은 옅은 색과 빗금으로 표시합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जास्त ओव्हरटाइम, गडद रंग. अंदाज फिकट रंग आणि तिरक्या रेषांत आहेत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais horas extra, cor mais intensa. As estimativas são claras e tracejadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше переработок — насыщеннее цвет. Оценки бледные и заштрихованы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยิ่งทำงานล่วงเวลามาก สียิ่งเข้ม ค่าประมาณใช้สีอ่อนและลายเฉียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazla mesai arttıkça renk koyulaşır. Tahminler soluk ve taralıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm thêm càng nhiều, màu càng đậm. Ước tính có màu nhạt và vạch chéo."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "加班越多，颜色越深；预计时间以淡色斜纹显示。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "加班越多，顏色越深；預計時間以淡色斜紋顯示。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "加班越多，顏色越深；預計時間以淡色斜紋顯示。"
          }
        }
      }
    },
    "recordsHeatWithoutColor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام التي عدّلتها لها إطار، والقائمة أدناه تعطي الساعات نفسها كنص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dir geänderte Tage haben eine Umrandung, und die Liste darunter nennt die gleichen Zeiten als Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days you changed carry an outline, and the list below gives the same hours as text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días que has cambiado llevan un contorno, y la lista de abajo da las mismas horas en texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours que vous avez modifiés ont un contour, et la liste ci-dessous donne les mêmes heures en texte."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन दिनों को आपने बदला है उनके किनारे पर रेखा है, और नीचे की सूची वही घंटे शब्दों में देती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari yang kamu ubah punya garis tepi, dan daftar di bawah menuliskan jam yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni che hai modificato hanno un contorno, e l’elenco qui sotto riporta le stesse ore in testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で直した日には枠線が付き、下のリストにも同じ時間が文字で出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 고친 날에는 테두리가 있고, 아래 목록에도 같은 시간이 글로 나옵니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही बदललेल्या दिवसांना कडा आहे, आणि खालची यादी तेच तास शब्दांत देते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias que alterou têm contorno, e a lista abaixo dá as mesmas horas em texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У дней, которые вы изменили, есть обводка, а список ниже повторяет те же часы текстом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่คุณแก้เองจะมีเส้นขอบ และรายการด้านล่างก็บอกจำนวนชั่วโมงเดียวกันเป็นตัวอักษร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirdiğin günlerin çerçevesi vardır, aşağıdaki liste de aynı saatleri yazıyla verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ngày bạn đã sửa có viền, và danh sách bên dưới ghi lại đúng số giờ đó bằng chữ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你改过的日子带描边，下面的列表也用文字给出同样的工时。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你改過嘅日子有外框，下面嘅清單都用文字寫出同樣嘅工時。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你改過的日子有外框，下面的清單也用文字給出同樣的工時。"
          }
        }
      }
    },

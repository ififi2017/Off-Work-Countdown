    },
    "syncRemoveDeviceConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف السجلات المتزامنة على هذا الجهاز؟ أي شيء موجود بالفعل في iCloud يبقى هناك، وتقوم ميزة \"الاستعادة\" بإعادته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierte Datensätze auf diesem Gerät löschen? Alles, was sich bereits in iCloud befindet, bleibt dort und wird durch Wiederherstellen wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete synced records on this device? Anything already in iCloud stays there, and Restore brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar registros sincronizados en este dispositivo? Todo lo que ya esté en iCloud permanece allí y Restaurar lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les enregistrements synchronisés sur cet appareil ? Tout ce qui est déjà dans iCloud y reste et la restauration le ramène."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सिंक किए गए रिकॉर्ड हटाएं? iCloud में पहले से मौजूद कोई भी चीज़ वहीं रहती है, और रिस्टोर उसे वापस लाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus catatan yang disinkronkan pada perangkat ini? Apa pun yang sudah ada di iCloud akan tetap ada di sana, dan Pemulihan akan mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare i record sincronizzati su questo dispositivo? Tutto ciò che è già in iCloud rimane lì e Ripristina lo riporta indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上の同期されたレコードを削除しますか? iCloud にすでにあるものはすべてそこに残り、復元によって元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 동기화된 기록을 삭제하시겠습니까? 이미 iCloud에 있는 모든 항목은 그대로 유지되며 복원하면 다시 가져옵니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवरील समक्रमित रेकॉर्ड हटवायचे? iCloud मध्ये आधीपासून असलेली कोणतीही गोष्ट तिथेच राहते आणि Restore ते परत आणते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir registros sincronizados neste dispositivo? Tudo o que já está no iCloud permanece lá e o Restore o traz de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить синхронизированные записи на этом устройстве? Все, что уже находится в iCloud, остается там, и функция «Восстановление» возвращает его обратно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบันทึกที่ซิงค์บนอุปกรณ์นี้หรือไม่ ทุกสิ่งที่อยู่ใน iCloud จะยังคงอยู่ตรงนั้น และ Restore จะนำสิ่งนั้นกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki senkronize edilmiş kayıtlar silinsin mi? Zaten iCloud'da bulunan her şey orada kalır ve Geri Yükleme onu geri getirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các bản ghi đã đồng bộ trên thiết bị này? Mọi thứ đã có trong iCloud vẫn ở đó và Khôi phục sẽ đưa nó trở lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这台设备上的同步记录？iCloud 中已有的数据会继续保留，并可通过恢复重新取回。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除呢部裝置上面嘅同步記錄？任何已經喺 iCloud 入面嘅嘢都會留喺嗰度，而「還原」就會將佢帶返嚟。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除該設備上的同步記錄？ iCloud 中已有的任何內容都會保留在那裡，「還原」會將其還原。"
          }
        }
      }
    },
    "syncRemoveDeviceDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل السجلات المتزامنة من هذا الجهاز. تبقى إعدادات جهازك هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt synchronisierte Datensätze von diesem Gerät. Ihre Geräteeinstellungen bleiben hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes synced records from this device. Your device settings stay here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina registros sincronizados de este dispositivo. La configuración de tu dispositivo permanece aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les enregistrements synchronisés de cet appareil. Les paramètres de votre appareil restent ici."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से सिंक किए गए रिकॉर्ड हटा देता है। आपकी डिवाइस सेटिंग यहीं रहती हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus catatan yang disinkronkan dari perangkat ini. Setelan perangkat Anda tetap di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i record sincronizzati da questo dispositivo. Le impostazioni del tuo dispositivo rimangono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスから同期されたレコードを削除します。デバイスの設定はここに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서 동기화된 기록을 제거합니다. 장치 설정은 여기에 유지됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवरून समक्रमित रेकॉर्ड काढून टाकते. तुमच्या डिव्हाइस सेटिंग्ज येथेच राहतील."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove registros sincronizados deste dispositivo. As configurações do seu dispositivo ficam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет синхронизированные записи с этого устройства. Настройки вашего устройства останутся здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบันทึกที่ซิงค์ออกจากอุปกรณ์นี้ การตั้งค่าอุปกรณ์ของคุณจะอยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronize edilen kayıtları bu cihazdan kaldırır. Cihaz ayarlarınız burada kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các bản ghi đã đồng bộ hóa khỏi thiết bị này. Cài đặt thiết bị của bạn vẫn ở đây."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从这台设备移除同步记录。设备设置会继续保留。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺呢部裝置移除同步記錄。你嘅裝置設定會留喺呢度。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從此設備中刪除同步記錄。您的設備設定保留在這裡。"
          }
        }
      }
    },

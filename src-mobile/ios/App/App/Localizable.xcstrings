    "enableSalaryDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف بشكل افتراضي. يتم تضمين الراتب إذا قمت بتشغيل مزامنة iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig deaktiviert. Das Gehalt ist inbegriffen, wenn Sie die iCloud-Synchronisierung aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Salary is included if you turn on iCloud sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada. El salario está incluido si activa la sincronización de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Le salaire est inclus si vous activez la synchronisation iCloud."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से बंद. यदि आप आईक्लाउड सिंक चालू करते हैं तो वेतन शामिल है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati secara default. Gaji sudah termasuk jika Anda mengaktifkan sinkronisasi iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato per impostazione predefinita. Lo stipendio è incluso se attivi la sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。 iCloud 同期をオンにすると、給与が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. iCloud 동기화를 켜면 급여가 포함됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "डीफॉल्टनुसार बंद. तुम्ही iCloud सिंक चालू केल्यास पगाराचा समावेश केला जातो."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado por padrão. O salário está incluído se você ativar a sincronização do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Зарплата включена в стоимость, если вы включите синхронизацию с iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดตามค่าเริ่มต้น รวมเงินเดือนแล้วหากคุณเปิดการซิงค์ iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalıdır. İCloud senkronizasyonunu açarsanız maaş dahildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định. Lương được bao gồm nếu bạn bật đồng bộ hóa iCloud."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启 iCloud 同步后，薪资也会一起同步。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "預設閂咗。如果你開 iCloud 同步，就包括人工。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。如果您開啟 iCloud 同步，則薪資包含在內。"
          }
        }
      }
    },

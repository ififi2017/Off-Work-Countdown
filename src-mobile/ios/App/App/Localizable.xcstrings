    "biometricsLockoutHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} مقفل — ألغِ القفل مرة واحدة برمز الجهاز لإعادة تفعيله"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} ist gesperrt – einmal mit dem Gerätecode entsperren, um es wieder zu aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} is locked — unlock once with your device passcode to re-enable it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} está bloqueado: desbloquea una vez con el código del dispositivo para reactivarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} est verrouillé — déverrouillez une fois avec le code de l’appareil pour le réactiver"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} लॉक है — डिवाइस पासकोड से एक बार अनलॉक करें ताकि यह फिर से काम करे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} terkunci — buka sekali dengan kode sandi perangkat untuk mengaktifkannya lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} è bloccato — sbloccalo una volta con il codice del dispositivo per riattivarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} がロックされています · デバイスのパスコードで一度解除すると復帰します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}}가 잠겼습니다 · 기기 암호로 한 번 해제하면 다시 사용할 수 있습니다"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} लॉक आहे — डिव्हाइस पासकोडने एकदा अनलॉक करा म्हणजे ते पुन्हा चालू होईल"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} está bloqueado — desbloqueie uma vez com o código do dispositivo para reativar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} заблокирован — разблокируйте один раз кодом устройства, чтобы включить его снова"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} ถูกล็อก · ปลดล็อกด้วยรหัสเครื่องหนึ่งครั้งเพื่อเปิดใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} kilitli — yeniden etkinleştirmek için cihaz parolanızla bir kez açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} đang bị khóa — mở khóa một lần bằng mật mã thiết bị để bật lại"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}}已锁定 · 先用设备密码解锁一次即可恢复"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} 已鎖定 · 先用裝置密碼解鎖一次就可以恢復"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "{{biometry}} 已鎖定 · 先用裝置密碼解鎖一次即可恢復"
          }
        }
      }
    },

    "lifeRoughIncomeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطبق التقدير السريع راتبك الحالي من سنة العمل حتى التقاعد. اختر التاريخ التفصيلي لإدخال الرواتب السابقة والفجوات الوظيفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Schnellschätzung wird Ihr aktuelles Gehalt vom Arbeitsjahr bis zum Ruhestand berücksichtigt. Wählen Sie die detaillierte Historie, um frühere Gehälter und Beschäftigungslücken einzugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quick estimate applies your current salary from the work year to retirement. Choose detailed history to enter earlier salaries and employment gaps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estimación rápida aplica su salario actual desde el año laboral hasta la jubilación. Elija un historial detallado para ingresar salarios anteriores y brechas laborales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'estimation rapide applique votre salaire actuel de l'année de travail jusqu'à la retraite. Choisissez un historique détaillé pour saisir les salaires antérieurs et les écarts d’emploi."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित अनुमान आपके वर्तमान वेतन को कार्य वर्ष से सेवानिवृत्ति तक लागू करता है। पहले के वेतन और रोजगार अंतराल दर्ज करने के लिए विस्तृत इतिहास चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan cepat menerapkan gaji Anda saat ini dari tahun kerja hingga pensiun. Pilih riwayat terperinci untuk memasukkan gaji dan kesenjangan pekerjaan sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stima rapida applica il tuo stipendio attuale dall'anno lavorativo alla pensione. Scegli la cronologia dettagliata per inserire gli stipendi precedenti e i divari occupazionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡単な見積りでは、勤務年から退職までの現在の給与が適用されます。詳細な履歴を選択して、以前の給与と雇用ギャップを入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 견적은 근무 연도부터 퇴직까지 현재 급여를 적용합니다. 이전 급여 및 채용 격차를 입력하려면 자세한 내역을 선택하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "झटपट अंदाज तुमचा सध्याचा पगार कामाच्या वर्षापासून सेवानिवृत्तीपर्यंत लागू होतो. पूर्वीचे पगार आणि रोजगारातील अंतर प्रविष्ट करण्यासाठी तपशीलवार इतिहास निवडा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A estimativa rápida aplica o seu salário atual desde o ano de trabalho até a aposentadoria. Escolha o histórico detalhado para inserir salários anteriores e lacunas de emprego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При быстрой оценке учитывается ваша текущая зарплата с рабочего года до выхода на пенсию. Выберите подробную историю, чтобы ввести предыдущие зарплаты и пробелы в занятости."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประมาณการด่วนจะใช้เงินเดือนปัจจุบันของคุณตั้งแต่ปีการทำงานจนถึงเกษียณอายุ เลือกประวัติโดยละเอียดเพื่อป้อนเงินเดือนและช่องว่างการจ้างงานก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı tahmin, mevcut maaşınızı çalışma yılından emekliliğe kadar uygular. Daha önceki maaşları ve istihdam boşluklarını girmek için ayrıntılı geçmişi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính nhanh áp dụng mức lương hiện tại của bạn từ năm làm việc đến khi nghỉ hưu. Chọn lịch sử chi tiết để nhập mức lương trước đó và khoảng cách việc làm."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "快速估算会把当前薪资用于开始工作到退休的整个区间。切换到详细经历，可以填写过去的薪资和待业空档。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "快速估算係用你而家嘅人工，由工作年度到退休。揀詳細嘅記錄嚟輸入早期嘅薪酬同就業差距。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "快速估算適用於您從工作年度到退休期間的當前薪資。選擇詳細的歷史記錄以輸入更早的工資和就業差距。"
          }
        }
      }
    },

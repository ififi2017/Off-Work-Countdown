          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove os registos locais deste dispositivo. Podes restaurá-los mais tarde ao importar um backup antigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалит локальные записи с этого устройства. Позже их можно восстановить, импортировав старую резервную копию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบันทึกในเครื่องนี้ คุณสามารถกู้คืนได้ภายหลังด้วยการนำเข้าข้อมูลสำรองเก่า"

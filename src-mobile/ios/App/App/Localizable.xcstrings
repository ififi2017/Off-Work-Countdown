    "lunchPauseNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف العد والتقدم والأرباح أثناء الغداء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown, Fortschritt und Verdienst pausieren während der Mittagspause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown, progress and earnings pause during lunch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta atrás, el progreso y las ganancias se pausan durante la comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à rebours, la progression et les gains sont en pause pendant le déjeuner."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दोपहर के अवकाश में काउंटडाउन, प्रगति और कमाई रुक जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur, progres, dan pendapatan dijeda saat makan siang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conto alla rovescia, avanzamento e guadagni si fermano durante il pranzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昼休み中はカウントダウン、進捗、収益が停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점심시간에는 카운트다운, 진행률, 수입이 일시 정지됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दुपारच्या सुट्टीत काउंटडाउन, प्रगती आणि कमाई थांबते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem, progresso e ganhos pausam durante o almoço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На обеде таймер, прогресс и заработок приостанавливаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลานับถอยหลัง ความคืบหน้า และรายได้จะหยุดระหว่างพักกลางวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğle molasında geri sayım, ilerleme ve kazanç duraklar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm ngược, tiến độ và thu nhập tạm dừng trong giờ nghỉ trưa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "午休期间倒计时、进度和今日已赚都会暂停。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "午休期間倒數、進度及今日已賺都會暫停。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "午休期間倒數、進度與今日已賺都會暫停。"
          }
        }
      }
    },

    "plusPurchaseUnverified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على هذا الجهاز التحقق من عملية الشراء. جرّب «استعادة الشراء»، أو أعد المحاولة بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät konnte den Kauf nicht bestätigen. Versuche „Einkäufe wiederherstellen“ oder probiere es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device could not verify the purchase. Try “Restore purchases”, or try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no pudo verificar la compra. Prueba «Restaurar compras» o inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas pu vérifier l’achat. Essayez « Restaurer les achats », ou réessayez dans un instant."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस ख़रीद की पुष्टि नहीं कर पाया। “ख़रीद बहाल करें” आज़माएँ, या थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak dapat memverifikasi pembelian. Coba “Pulihkan pembelian”, atau coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non è riuscito a verificare l’acquisto. Prova «Ripristina acquisti» oppure riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では購入を確認できませんでした。「購入を復元」を試すか、しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 구입을 확인하지 못했습니다. ‘구입 항목 복원’을 눌러 보거나 잠시 후 다시 시도해 주세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसला खरेदीची पडताळणी करता आली नाही. “खरेदी पुन्हा मिळवा” वापरून पहा, किंवा थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não conseguiu verificar a compra. Tente «Restaurar compras» ou tente de novo daqui a pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не смогло подтвердить покупку. Попробуйте «Восстановить покупки» или повторите чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ยืนยันการซื้อไม่ได้ ลอง “กู้คืนการซื้อ” หรือลองใหม่อีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz satın alımı doğrulayamadı. “Satın alımları geri yükle” seçeneğini deneyin ya da birazdan tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không xác minh được giao dịch. Hãy thử “Phục hồi giao dịch”, hoặc thử lại sau giây lát."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备无法验证这笔购买。可以点“恢复购买”，或稍后再试一次。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢部裝置無法驗證呢筆購買。可以撳「回復購買項目」，或者過陣再試一次。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置無法驗證這筆購買。可以點「回復購買項目」，或稍後再試一次。"
          }
        }
      }
    },

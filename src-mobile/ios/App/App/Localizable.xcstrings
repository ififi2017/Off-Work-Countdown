    "recordsSummaryHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل وقت العمل الوقت المنقضي من الجدول المحفوظ والعمل الإضافي، مع أولوية السجلات والتعديلات اليدوية. يُقدّر الدخل للفترة المحددة كاملة وفق إعدادات راتبك؛ ولا يتغير الراتب الشهري الثابت بتغير الساعات المسجلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeitszeit umfasst verstrichene gespeicherte Schichten und Überstunden; Zeiterfassungen und Korrekturen haben Vorrang. Das Einkommen wird für den gesamten gewählten Zeitraum anhand deiner Gehaltseinstellungen geschätzt. Ein festes Monatsgehalt hängt nicht von den erfassten Stunden ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time worked includes elapsed saved shifts and overtime; timer records and corrections take priority. Income is estimated for the full selected period using your salary settings. Recorded hours do not change a fixed monthly salary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo trabajado incluye los turnos guardados ya transcurridos y las horas extra; los registros y correcciones tienen prioridad. Los ingresos se estiman para todo el período seleccionado según tu configuración salarial. Las horas registradas no cambian un sueldo mensual fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps travaillé inclut les horaires enregistrés déjà écoulés et les heures supplémentaires ; les relevés et corrections sont prioritaires. Le revenu est estimé pour toute la période sélectionnée selon vos paramètres de salaire. Les heures enregistrées ne modifient pas un salaire mensuel fixe."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "काम के समय में सहेजी गई पाली का बीता समय और ओवरटाइम शामिल हैं; टाइमर रिकॉर्ड और सुधार को प्राथमिकता मिलती है। आय का अनुमान चुनी गई पूरी अवधि और वेतन सेटिंग से लगाया जाता है। दर्ज घंटों से निश्चित मासिक वेतन नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu bekerja mencakup jadwal tersimpan yang telah berlalu dan lembur; catatan timer serta koreksi diprioritaskan. Pendapatan diperkirakan untuk seluruh periode terpilih berdasarkan pengaturan gaji. Jam tercatat tidak mengubah gaji bulanan tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo lavorato include i turni salvati già trascorsi e gli straordinari; registrazioni e correzioni hanno priorità. Il reddito è stimato per tutto il periodo selezionato in base alle impostazioni salariali. Le ore registrate non modificano uno stipendio mensile fisso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務時間には保存済みシフトの経過分と残業を含み、タイマー記録と修正を優先します。収入は選択期間全体について給与設定から推定します。固定月給は記録時間の多少で変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 시간에는 저장된 근무 일정의 경과 시간과 초과근무가 포함되며, 타이머 기록과 수정 사항이 우선합니다. 수입은 급여 설정을 기준으로 선택한 전체 기간에 대해 추정합니다. 기록된 시간은 고정 월급을 바꾸지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कामाच्या वेळेत जतन केलेल्या पाळीचा गेलेला वेळ आणि ओव्हरटाइम समाविष्ट आहे; टाइमर नोंदी आणि दुरुस्तींना प्राधान्य आहे. उत्पन्नाचा अंदाज निवडलेल्या संपूर्ण कालावधीसाठी पगार सेटिंगनुसार आहे. नोंदवलेल्या तासांमुळे ठरलेला मासिक पगार बदलत नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo trabalhado inclui turnos guardados já decorridos e horas extra; registos e correções têm prioridade. O rendimento é estimado para todo o período selecionado segundo as definições salariais. As horas registadas não alteram um salário mensal fixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отработанное время включает прошедшие сохранённые смены и переработку; записи таймера и исправления имеют приоритет. Доход оценивается за весь выбранный период по настройкам зарплаты. Записанные часы не меняют фиксированный месячный оклад."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาทำงานรวมช่วงกะที่บันทึกไว้ซึ่งผ่านไปแล้วและล่วงเวลา โดยยึดบันทึกตัวจับเวลาและการแก้ไขก่อน รายได้ประมาณจากการตั้งค่าเงินเดือนตลอดช่วงที่เลือก ชั่วโมงที่บันทึกไม่เปลี่ยนเงินเดือนประจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışılan süre, kayıtlı vardiyaların geçen kısmını ve fazla mesaiyi içerir; zamanlayıcı kayıtları ve düzeltmeler önceliklidir. Gelir, maaş ayarlarına göre seçilen dönemin tamamı için tahmin edilir. Kaydedilen saatler sabit aylık maaşı değiştirmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian làm việc gồm phần ca đã lưu đã trôi qua và làm thêm giờ; bản ghi hẹn giờ và chỉnh sửa được ưu tiên. Thu nhập được ước tính cho toàn bộ kỳ đã chọn theo cài đặt lương. Số giờ ghi nhận không làm thay đổi lương tháng cố định."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已工作时长包含已生效排班的经过时间和加班，计时记录及手动修正优先。收入按所选整段期间及薪资设置估算；固定月薪不会因记录工时多少而增减。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已工作時長包含已生效排班的經過時間和加班，計時記錄及手動修正優先。收入按所選整段期間及薪資設定估算；固定月薪不會因記錄工時多少而增減。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已工作時長包含已生效排班的經過時間和加班，計時記錄及手動修正優先。收入按所選整段期間及薪資設定估算；固定月薪不會因記錄工時多少而增減。"
          }
        }
      }
    },

    "focusNextFocusBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الاستراحة. اختر مهمة لبدء الجولة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",

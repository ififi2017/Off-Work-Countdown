          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minuti di fila. Alzati e sciogli le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} 分たちました。立って肩を回しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}}분 지났어요. 일어나서 어깨를 풀어 봐요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} मिनिटे झाली. उभे राहून खांदे मोकळे करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minutos seguidos. Levante e solte os ombros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} мин без перерыва. Встаньте и разомните плечи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผ่านไป {{minutes}} นาทีแล้ว ลุกขึ้นยืดไหล่สักนิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} dakika oldu. Ayağa kalk, omuzlarını gevşet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} phút trôi qua rồi. Đứng lên xoay vai một chút."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "工作 {{minutes}} 分钟了，站起来活动一下肩颈。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "做咗 {{minutes}} 分鐘，企起身鬆一鬆膊頭。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "工作 {{minutes}} 分鐘了，站起來活動一下肩頸。"
          }
        }
      }
    },
    "microBreakMessages.3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} دقيقة أمام الشاشة. انظر بعيدًا قليلًا."
          }
        },

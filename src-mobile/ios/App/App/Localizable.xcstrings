    "onboardingSystemBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت والحالة والتقدّم فقط — لا الراتب أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit, Status und Fortschritt – niemals das Gehalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time, status and progress — never salary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora, estado y progreso; nunca el sueldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure, l'état et la progression — jamais le salaire."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "समय, स्थिति और प्रगति — वेतन कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu, status, dan progres — tidak pernah gaji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora, stato e progresso — mai lo stipendio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示するのは時間・状態・進捗だけ。給与は決して表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간, 상태, 진행률만 표시하고 급여는 절대 표시하지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "वेळ, स्थिती आणि प्रगती — पगार कधीच नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora, status e progresso — nunca o salário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время, статус и прогресс — никогда зарплата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเวลา สถานะ และความคืบหน้า — ไม่แสดงเงินเดือนเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat, durum ve ilerleme — maaş asla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian, trạng thái và tiến độ — không bao giờ có lương."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示时间、状态和进度，绝不显示薪资。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示時間、狀態同進度，絕對唔會顯示人工。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示時間、狀態和進度，絕不顯示薪資。"
          }
        }
      }
    },

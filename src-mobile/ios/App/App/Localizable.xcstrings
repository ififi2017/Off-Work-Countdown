    "onboardingLandscapeBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الوضع الأفقي يملأ العد التنازلي الشاشة كاملة — الساعة والشريط فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Querformat füllt der Countdown den Bildschirm – nur Uhr und Balken, sonst nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In landscape the countdown goes full screen — just the clock and the bar, nothing else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En horizontal la cuenta atrás ocupa toda la pantalla: solo el reloj y la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En paysage, le compte à rebours occupe tout l'écran : l'horloge et la barre, rien d'autre."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लैंडस्केप में काउंटडाउन पूरी स्क्रीन ले लेता है — बस घड़ी और बार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mode lanskap hitung mundur memenuhi layar — hanya jam dan bilah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In orizzontale il conto alla rovescia occupa tutto lo schermo: solo l'orologio e la barra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横向きではカウントダウンが全画面に。時計とバーだけの表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 모드에서는 카운트다운이 전체 화면으로 — 시계와 막대만 남습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आडव्या मोडमध्ये काउंटडाउन पूर्ण स्क्रीन व्यापतो — फक्त घड्याळ आणि पट्टी."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na horizontal a contagem ocupa a tela inteira: só o relógio e a barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В альбомной ориентации отсчёт занимает весь экран — только часы и полоса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแนวนอน การนับถอยหลังจะเต็มจอ — มีแค่นาฬิกากับแถบความคืบหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatay modda geri sayım tüm ekranı kaplar — yalnızca saat ve çubuk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở chế độ ngang, đồng hồ đếm ngược chiếm trọn màn hình — chỉ đồng hồ và thanh tiến trình."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "横屏时倒计时会占满整个屏幕——只有时钟和进度条，别无他物。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "打橫嘅時候倒數會佔滿成個螢幕——淨係得時鐘同進度條。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "橫向時倒數會佔滿整個螢幕——只有時鐘和進度條，別無他物。"
          }
        }
      }
    },

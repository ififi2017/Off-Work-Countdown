    "syncDisable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف المزامنة على هذا الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync auf diesem Gerät beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop syncing on this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de sincronizar en este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la synchronisation sur cet appareil"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सिंक रोकें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan sinkronisasi di perangkat ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi la sincronizzazione su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で同期をやめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 동기화 끄기"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर सिंक थांबवा"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar a sincronização neste dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить синхронизацию на этом устройстве"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดซิงก์บนเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda eşitlemeyi durdur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng đồng bộ trên thiết bị này"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台设备停止同步"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺呢部裝置停止同步"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台裝置停止同步"
          }
        }
      }
    },
    "syncDisableConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إيقاف المزامنة على هذا الجهاز؟ تظل البيانات الموجودة بالفعل في iCloud هناك، ويحتفظ هذا الجهاز بنسخته الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung auf diesem Gerät beenden? Daten, die sich bereits in iCloud befinden, bleiben dort und dieses Gerät behält seine aktuelle Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop syncing on this device? Data already in iCloud stays there, and this device keeps its current copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dejar de sincronizar en este dispositivo? Los datos que ya están en iCloud permanecen allí y este dispositivo conserva su copia actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la synchronisation sur cet appareil ? Les données déjà présentes dans iCloud y restent et cet appareil conserve sa copie actuelle."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सिंक करना बंद करें? iCloud में पहले से मौजूद डेटा वहीं रहता है, और यह डिवाइस उसकी वर्तमान प्रतिलिपि रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti menyinkronkan pada perangkat ini? Data yang sudah ada di iCloud tetap tersimpan di sana, dan perangkat ini menyimpan salinannya yang terbaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompere la sincronizzazione su questo dispositivo? I dati già presenti su iCloud rimangono lì e questo dispositivo conserva la sua copia corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでの同期を停止しますか? iCloud にすでにあるデータはそこに残り、このデバイスは現在のコピーを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서 동기화를 중지하시겠습니까? 이미 iCloud에 있는 데이터는 그대로 유지되며 이 기기는 현재 복사본을 유지합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर सिंक करणे थांबवायचे? आयक्लॉडमध्ये आधीच असलेला डेटा तिथेच राहतो आणि हे डिव्हाइस तिची वर्तमान प्रत ठेवते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de sincronizar neste dispositivo? Os dados que já estão no iCloud permanecem lá e este dispositivo mantém sua cópia atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекратить синхронизацию на этом устройстве? Данные, уже находящиеся в iCloud, остаются там, и это устройство сохраняет свою текущую копию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดการซิงค์บนอุปกรณ์นี้หรือไม่? ข้อมูลที่อยู่ใน iCloud จะยังคงอยู่ และอุปกรณ์นี้จะเก็บสำเนาปัจจุบันไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda senkronizasyon durdurulsun mu? Halihazırda iCloud'da bulunan veriler orada kalır ve bu aygıt, geçerli kopyasını saklar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng đồng bộ hóa trên thiết bị này? Dữ liệu đã có trong iCloud vẫn ở đó và thiết bị này giữ bản sao hiện tại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "停止在这台设备上同步？iCloud 中已有的数据会继续保留，这台设备也会保留当前副本。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "停止喺呢部裝置上面同步？已經喺 iCloud 入面嘅資料會保留喺嗰度，而呢部裝置會保留佢而家嘅副本。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "停止在此設備上同步？ iCloud 中已有的資料保留在那裡，並且該裝置保留其目前副本。"
          }
        }
      }
    },

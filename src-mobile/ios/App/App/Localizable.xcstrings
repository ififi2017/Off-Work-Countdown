    "recordsConflictReviewLegacyVersions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا التعارض على نسخة أقدم. راجع النسختين قبل الاختيار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Konflikt enthält eine ältere Kopie. Prüfe beide Versionen, bevor du wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conflict has one older copy. Review both versions before choosing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conflicto tiene una copia anterior. Revisa ambas versiones antes de elegir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce conflit contient une ancienne copie. Comparez les deux versions avant de choisir."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टकराव में एक पुरानी प्रति है। चुनने से पहले दोनों संस्करण देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflik ini memiliki salinan lama. Tinjau kedua versi sebelum memilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conflitto contiene una copia precedente. Controlla entrambe le versioni prima di scegliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この競合には古いコピーがあります。選択する前に両方のバージョンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 충돌에는 이전 사본이 하나 있습니다. 선택하기 전에 두 버전을 확인하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या संघर्षात जुनी प्रत आहे. निवडण्यापूर्वी दोन्ही आवृत्त्या तपासा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conflito tem uma cópia mais antiga. Reveja as duas versões antes de escolher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом конфликте есть более старая копия. Проверьте обе версии перед выбором."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความขัดแย้งนี้มีสำเนาเก่ากว่า ตรวจสอบทั้งสองเวอร์ชันก่อนเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çakışmada daha eski bir kopya var. Seçmeden önce iki sürümü inceleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xung đột này có một bản sao cũ hơn. Hãy xem cả hai phiên bản trước khi chọn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此冲突包含一个较旧副本，请比较两个版本后再选择。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個衝突有一份較舊副本，請比較兩個版本後再選擇。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這個衝突包含一份較舊的副本，請比較兩個版本後再選擇。"
          }
        }
      }
    },
    "recordsConflictReviewVersions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن النسختين ثم اختر النسخة التي تريد الاحتفاظ بها. لن يتغير شيء قبل اختيارك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche beide Versionen und wähle dann, welche bleiben soll. Bis dahin wird nichts geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices changed the same item at the same time, so it could not be merged safely. Only the differences are shown below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las dos versiones y elige cuál conservar. Nada cambia hasta que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les deux versions, puis choisissez celle à conserver. Rien ne change avant votre choix."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों संस्करणों की तुलना करके चुनें कि किसे रखना है। आपके चुनने तक कुछ नहीं बदलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan kedua versi, lalu pilih yang ingin disimpan. Tidak ada perubahan sebelum Anda memilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta le due versioni e scegli quale conservare. Nulla cambia prima della scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのバージョンを比べて、残す方を選択してください。選択するまで変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 버전을 비교한 뒤 보관할 버전을 선택하세요. 선택하기 전에는 아무것도 바뀌지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन्ही आवृत्त्यांची तुलना करून कोणती ठेवायची ते निवडा. निवडेपर्यंत काहीही बदलणार नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare as duas versões e escolha qual manter. Nada muda antes de escolher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните версии и выберите, какую оставить. До выбора ничего не изменится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบสองเวอร์ชันแล้วเลือกสิ่งที่ต้องการเก็บ ข้อมูลจะไม่เปลี่ยนจนกว่าจะเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki sürümü karşılaştırıp hangisini tutacağınızı seçin. Siz seçene kadar hiçbir şey değişmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh hai phiên bản rồi chọn bản muốn giữ. Dữ liệu chỉ thay đổi sau khi bạn chọn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备在同一时间改了同一项，应用无法安全合并。下面只显示不同之处。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "兩部裝置在同一時間修改咗同一項，應用程式無法安全合併。下方只顯示唔同之處。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "兩部裝置在同一時間修改了同一項，App 無法安全合併。下方只顯示不同之處。"
          }
        }
      }
    },

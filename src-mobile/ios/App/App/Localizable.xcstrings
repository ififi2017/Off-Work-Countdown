    "recordsClearDayConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التراجع عن تعديلك لهذا اليوم؟ سيعود إلى الجدول وتقويم العطلات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderung an diesem Tag zurücknehmen? Er richtet sich dann wieder nach Plan und Feiertagskalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo your change to this day? It goes back to what the schedule and holiday calendar say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Deshacer tu cambio en este día? Volverá a seguir el horario y el calendario de festivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler votre modification sur ce jour ? Il repart du planning et du calendrier des jours fériés."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन का आपका बदलाव हटाना है? यह फिर शेड्यूल और छुट्टी कैलेंडर के हिसाब से चलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan perubahanmu pada hari ini? Hari ini kembali mengikuti jadwal dan kalender hari libur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare la tua modifica a questo giorno? Torna a seguire il turno e il calendario delle festività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の変更を取り消しますか？ シフトと祝日カレンダーの内容に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날의 수정을 되돌릴까요? 근무표와 공휴일 달력으로 돌아갑니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या दिवसाचा तुमचा बदल काढायचा? हा दिवस पुन्हा वेळापत्रक आणि सुट्टीच्या दिनदर्शिकेनुसार चालेल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anular a sua alteração neste dia? Volta a seguir o horário e o calendário de feriados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить ваше изменение этого дня? Он снова возьмётся из графика и календаря праздников."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการแก้ของคุณในวันนี้ไหม วันนี้จะกลับไปใช้ตารางกะและปฏิทินวันหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güne yaptığın değişiklik geri alınsın mı? Yeniden programa ve tatil takvimine döner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ thay đổi của bạn cho ngày này? Ngày này sẽ quay lại theo lịch làm và lịch nghỉ lễ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销你对这天的修改？这天会回到排班和节假日日历的结果。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取消你對呢日嘅改動？呢日會返到更表同假期日曆嘅結果。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "取消你對這天的修改？這天會回到班表和假日行事曆的結果。"
          }
        }
      }
    },

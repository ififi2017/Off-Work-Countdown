    "appleWatchComplicationsBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلقة تقدم دائرية، أو الوقت المتبقي ووقت الانصراف في إضافة مستطيلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein runder Fortschrittsring oder verbleibende Zeit und dein Feierabend in einer rechteckigen Komplikation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A circular progress ring, or time left and your off-work time in a rectangle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo de progreso circular, o el tiempo restante y tu hora de salida en una complicación rectangular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau de progression circulaire, ou le temps restant et votre heure de départ dans une complication rectangulaire."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक गोल प्रगति रिंग, या एक आयताकार में बचा हुआ समय और आपके छूटने का समय।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin kemajuan bundar, atau sisa waktu dan waktu pulang Anda dalam bentuk persegi panjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello di avanzamento circolare, oppure tempo rimanente e la tua uscita in una complicazione rettangolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸型の進捗リング、または長方形で残り時間と退勤時刻を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원형 진행률 링, 또는 사각형에 남은 시간과 퇴근 시간을 표시합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "गोल प्रगती रिंग, किंवा आयताकृतीमध्ये उरलेला वेळ आणि तुमची सुट्टीची वेळ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel de progresso circular, ou o tempo restante e sua hora de saída em formato retangular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглое кольцо прогресса или прямоугольное расширение с оставшимся временем и временем окончания работы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนความคืบหน้าทรงกลม หรือเวลาที่เหลือและเวลาเลิกงานของคุณในกลไกทรงสี่เหลี่ยม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dairesel bir ilerleme halkası veya dikdörtgen bir komplikasyonda kalan süre ile iş çıkış saatiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng tiến độ hình tròn, hoặc thời gian còn lại và giờ tan ca của bạn trong tổ hợp hình chữ nhật."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "圆形显示进度环，长方形显示剩余时间和下班时间。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "圓形顯示進度環，長方形顯示剩餘時間同下班時間。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "圓形顯示進度環，長方形顯示剩餘時間和下班時間。"
          }
        }
      }
    },

    "recordsTimeZoneFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم يحتفظ بالأيام التي كتبتها. السفر لا يحرّكها. إن صار هنا بيتك، يمكنك الانتقال إلى منطقة هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalender behält die Tage, die du geschrieben hast. Reisen verschiebt sie nicht. Wenn hier jetzt zu Hause ist, kannst du die Zeitzone dieses Geräts übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar keeps the days you wrote. Travel does not move them. If this is home now, you can switch to this device’s time zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario conserva los días que escribiste. Viajar no los mueve. Si aquí es casa ahora, puedes pasar a la zona de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier garde les jours que vous avez écrits. Voyager ne les déplace pas. Si c’est chez vous maintenant, vous pouvez passer au fuseau de cet appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर आपके लिखे दिन रखता है। यात्रा उन्हें नहीं खिसकाती। अगर अब यहीं घर है, तो इस डिवाइस का समय क्षेत्र अपना सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender menyimpan hari yang Anda tulis. Bepergian tidak menggesernya. Jika sini sudah rumah, Anda bisa memakai zona perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calendario tiene i giorni che hai scritto. Viaggiare non li sposta. Se qui è casa adesso, puoi passare al fuso di questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーは書いたときのタイムゾーンのままです。旅行しても日付は動きません。ここが生活の拠点なら、この端末のタイムゾーンに切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력은 기록한 시간대를 유지합니다. 여행해도 날짜는 움직이지 않습니다. 이곳이 이제 집이라면 이 기기의 시간대로 바꿀 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिका तुम्ही लिहिलेले दिवस ठेवते. प्रवास त्यांना हलवत नाही. इथे आता घर असेल तर या उपकरणाचे वेळ क्षेत्र वापरता येईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário guarda os dias que escreveste. Viajar não os move. Se aqui é casa agora, podes passar ao fuso deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарь хранит дни, которые вы записали. Поездки их не сдвигают. Если здесь теперь дом, можно перейти на пояс этого устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินเก็บวันที่คุณเขียนไว้ การเดินทางไม่ทำให้วันขยับ ถ้าที่นี่คือบ้านแล้ว สามารถเปลี่ยนเป็นเขตเวลาของอุปกรณ์นี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim yazdığın günleri tutar. Seyahat onları kaydırmaz. Burası artık evinse, bu cihazın saat dilimine geçebilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch giữ những ngày bạn đã ghi. Đi xa không làm chúng dịch. Nếu đây là nhà rồi, bạn có thể chuyển sang múi của máy này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "日历按记下时的时区排。人到另一个时区，年历上的日子不会跟着走。如果这里成了常住地，可以改用这台设备的时区。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "日曆按記下時嘅時區排。人到另一個時區，年曆上嘅日子唔會跟住走。如果呢度成咗常住地，可以改用呢部裝置嘅時區。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "日曆按記下時的時區排。人到另一個時區，年曆上的日子不會跟著走。如果這裡成了常住地，可以改用這台裝置的時區。"
          }
        }
      }
    },

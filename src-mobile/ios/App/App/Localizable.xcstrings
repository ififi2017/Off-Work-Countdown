            "state": "translated",
            "value": "{{minutes}} menit tanpa jeda. Jalan sebentar, lalu kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minuti senza pause. Fai due passi e torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} 分ぶっ通しです。少し歩いてから戻りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}}분 내리 앉아 있었어요. 몇 걸음 걷고 와요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} मिनिटे सलग झाली. दोन पावले चालून या."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} minutos sem parar. Dê uns passos e volte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} мин подряд. Пройдитесь немного и возвращайтесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นั่งรวดเดียว {{minutes}} นาที เดินสักสองก้าวแล้วค่อยกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} dakika ara vermedin. Birkaç adım at, sonra dön."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{{minutes}} phút không nghỉ. Đi vài bước rồi quay lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "连续 {{minutes}} 分钟了，走两步再回来吧。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連續 {{minutes}} 分鐘，行兩步再返嚟啦。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連續 {{minutes}} 分鐘了，走兩步再回來吧。"
          }
        }
      }
    },

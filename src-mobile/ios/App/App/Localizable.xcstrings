    "recordsTimeZoneMigrateConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تواريخ التقويم لا تتحرك. التاسعة تبقى التاسعة، وتُقرأ في هذه المنطقة. العدّ التنازلي الجاري يحتفظ بالمنطقة السابقة حتى ينتهي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderdaten bleiben. Neun Uhr bleibt neun Uhr, jetzt in dieser Zeitzone. Ein laufender Countdown behält die vorherige bis zum Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar dates stay where they are. Nine o’clock is still nine o’clock, now read in this time zone. A countdown that is already running keeps the previous one until it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas del calendario no se mueven. Las nueve siguen siendo las nueve, leídas en esta zona. Una cuenta atrás en curso mantiene la anterior hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates du calendrier ne bougent pas. Neuf heures reste neuf heures, lu dans ce fuseau. Un compte à rebours déjà lancé garde l’ancien jusqu’à la fin."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर की तिथियाँ नहीं खिसकेंगी। नौ बजे नौ बजे ही रहेंगे, अब इस क्षेत्र में पढ़े जाएँगे। चल रहा काउंटडाउन खत्म होने तक पुराना क्षेत्र रखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal kalender tetap. Pukul sembilan tetap pukul sembilan, dibaca di zona ini. Hitung mundur yang sedang berjalan memakai zona lama sampai selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date del calendario restano. Le nove restano le nove, lette in questo fuso. Un conto alla rovescia già avviato tiene il precedente fino alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの日付はそのままです。9時は9時のまま、新しいタイムゾーンで読みます。進行中のカウントダウンは終わるまで前のタイムゾーンのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 날짜는 그대로입니다. 9시는 여전히 9시이며, 새 시간대로 읽습니다. 이미 진행 중인 카운트다운은 끝날 때까지 이전 시간대를 유지합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिकेच्या तारखा हलणार नाहीत. नऊ वाजता नऊच राहतील, या क्षेत्रात वाचले जातील. सुरू असलेला उलट्या घड्याळ संपेपर्यंत जुने क्षेत्र ठेवेल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas do calendário ficam. Nove horas continua nove horas, lidas neste fuso. Uma contagem já a correr mantém o anterior até acabar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты календаря не сдвигаются. Девять часов остаются девятью, теперь в этом поясе. Идущий отсчёт держит прежний пояс до конца."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่บนปฏิทินไม่ขยับ เก้าโมงยังเป็นเก้าโมง เพียงอ่านด้วยเขตเวลานี้ นาฬิกานับถอยหลังที่กำลังเดินยังใช้เขตเดิมจนกว่าจะจบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim tarihleri yerinde kalır. Saat dokuz yine dokuzdur, bu dilimde okunur. Süregelen geri sayım bitene kadar eskisini korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày trên lịch không dời. Chín giờ vẫn là chín giờ, chỉ đọc theo múi này. Đếm ngược đang chạy giữ múi cũ đến khi kết thúc."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "日历上的日期不会挪动。九点还是九点，只是改按此时区来读。已经在走的倒计时仍用原来的时区，直到这次结束。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "日曆上嘅日期唔會郁。九點仲係九點，只係改按此時區嚟讀。已經喺度行嘅倒計時仍然用舊時區，直至呢次完。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "日曆上的日期不會移動。九點還是九點，只是改按此時區來讀。已經在走的倒計時仍用原來的時區，直到這次結束。"
          }
        }
      }
    },

    "recordsLifeSetupBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنة الميلاد تكفي للبدء. اترك التواريخ التي لا تعرفها فارغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Geburtsjahr reicht zum Start. Unbekannte Daten können leer bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A birth year is enough to start. Skip any date you do not know."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el año de nacimiento basta para empezar. Deja en blanco las fechas que no sepas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’année de naissance suffit pour commencer. Laissez vide ce que vous ignorez."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए जन्म वर्ष काफी है। जो तारीख न पता हो उसे खाली छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahun lahir saja sudah cukup untuk mulai. Tanggal yang tidak diketahui boleh dikosongkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anno di nascita basta per iniziare. Lascia vuote le date che non sai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生まれ年だけでも始められます。分からない日付は空欄のままで大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태어난 해만 있어도 시작할 수 있어요. 모르는 날짜는 비워 두세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवातीला जन्मवर्ष पुरेसे आहे. माहित नसलेल्या तारखा रिकाम्या ठेवा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ano de nascimento já basta para começar. Deixe em branco as datas que não souber."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно года рождения. Даты, которые не знаете, можно оставить пустыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีปีเกิดก็เริ่มได้ วันที่ที่ไม่ทราบเว้นว่างไว้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için doğum yılı yeter. Bilmediğiniz tarihleri boş bırakabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần năm sinh là bắt đầu được. Ngày nào chưa rõ có thể để trống."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只填出生年份也可以开始。不知道的日期可以先空着。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只填出生年份也可以開始。不知道的日期可以先留空。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只填出生年份也可以開始。不知道的日期可以先留空。"
          }
        }
      }
    },

    "appleWatchPrivacyNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Apple Watch فقط الوقت والحالة والتقدم من iPhone، ولا يعرض الراتب أبدًا. تصل التحديثات عبر iPhone المقترن، لذا قد تستغرق لحظة للوصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Watch zeigt nur Zeit, Status und Fortschritt von deinem iPhone – nie das Gehalt. Updates laufen über dein gekoppeltes iPhone und können einen Moment brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch shows only time, status and progress from your iPhone — never salary. Updates travel through your paired iPhone, so they can take a moment to arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Watch solo muestra la hora, el estado y el progreso de tu iPhone, nunca el salario. Las actualizaciones llegan a través de tu iPhone emparejado, así que pueden tardar un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple Watch n’affiche que l’heure, le statut et la progression depuis votre iPhone, jamais le salaire. Les mises à jour passent par votre iPhone couplé, donc elles peuvent prendre un instant."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch पर सिर्फ़ आपके iPhone से समय, स्थिति और प्रगति दिखती है, वेतन कभी नहीं। अपडेट आपकी पेयर की गई iPhone से होकर आते हैं, इसलिए पहुँचने में थोड़ा समय लग सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch hanya menampilkan waktu, status, dan kemajuan dari iPhone Anda, tidak pernah gaji. Pembaruan dikirim melalui iPhone Anda yang terhubung, jadi mungkin perlu waktu sesaat untuk sampai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch mostra solo orario, stato e avanzamento dal tuo iPhone, mai lo stipendio. Gli aggiornamenti passano dal tuo iPhone abbinato, quindi possono richiedere un momento per arrivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple WatchにはiPhoneからの時刻、ステータス、進捗だけが表示され、給与は表示されません。更新はペアリングしたiPhone経由で届くため、反映まで少し時間がかかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch에는 iPhone의 시간, 상태, 진행률만 표시되며 급여는 표시되지 않습니다. 업데이트는 페어링된 iPhone을 거쳐 전달되므로 반영까지 잠시 시간이 걸릴 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch वर फक्त तुमच्या iPhone वरील वेळ, स्थिती आणि प्रगती दिसते, पगार कधीच नाही. अपडेट्स तुमच्या पेअर केलेल्या iPhone मार्फत येतात, त्यामुळे पोहोचायला थोडा वेळ लागू शकतो."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Watch mostra apenas hora, status e progresso vindos do seu iPhone, nunca o salário. As atualizações passam pelo seu iPhone pareado, então podem levar um instante para chegar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch показывает только время, статус и прогресс с вашего iPhone — никогда зарплату. Обновления приходят через сопряжённый iPhone, поэтому могут появляться не сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch แสดงเฉพาะเวลา สถานะ และความคืบหน้าจาก iPhone ของคุณ ไม่แสดงเงินเดือน การอัปเดตส่งผ่าน iPhone ที่จับคู่ไว้ จึงอาจใช้เวลาสักครู่กว่าจะแสดงผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch yalnızca iPhone’unuzdan gelen saati, durumu ve ilerlemeyi gösterir; maaşı asla göstermez. Güncellemeler eşlenen iPhone’unuz üzerinden gittiği için ulaşması biraz zaman alabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch chỉ hiển thị thời gian, trạng thái và tiến độ từ iPhone của bạn, không bao giờ hiển thị lương. Các bản cập nhật truyền qua iPhone đã ghép nối, nên có thể mất một chút thời gian để đến nơi."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 只显示来自 iPhone 的时间、状态和进度，不含薪资。更新经由已配对的 iPhone 送达，可能需要片刻。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 只會顯示嚟自 iPhone 嘅時間、狀態同進度，唔包括薪資。更新會經已配對嘅 iPhone 送達，可能要等一陣。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 只顯示來自 iPhone 的時間、狀態和進度，不含薪資。更新經由已配對的 iPhone 送達，可能需要片刻。"
          }
        }
      }
    },
    "appleWatchSetupFace": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس شاشة الساعة مع الاستمرار، ثم اضغط على تعديل، ثم اختر DoneAt كإضافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühre und halte dein Zifferblatt, tippe auf Bearbeiten und wähle dann DoneAt für eine Komplikation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your watch face, tap Edit, then choose DoneAt for a complication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada tu esfera, toca Editar y elige DoneAt para una complicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cadran et maintenez la pression, appuyez sur Modifier, puis choisissez DoneAt pour une complication."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी वॉच फ़ेस को छूकर रखें, संपादित करें पर टैप करें, फिर कॉम्प्लिकेशन के लिए DoneAt चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan watch face Anda, ketuk Edit, lalu pilih DoneAt untuk komplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto il quadrante, tocca Modifica, poi scegli DoneAt per una complicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤を長押しして「編集」をタップし、コンプリケーションにDoneAtを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치 페이스를 길게 터치한 다음 편집을 탭하고, 컴플리케이션으로 DoneAt을 선택하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा वॉच फेस स्पर्श करून धरा, संपादित करा वर टॅप करा, नंतर कॉम्प्लिकेशनसाठी DoneAt निवडा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure o mostrador, toque em Editar e escolha o DoneAt para uma complicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте циферблат, нажмите «Изменить», затем выберите DoneAt для расширения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะค้างที่หน้าปัด แตะแก้ไข แล้วเลือก DoneAt สำหรับกลไกหน้าปัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadranınıza dokunup basılı tutun, Düzenle’ye dokunun, ardından bir komplikasyon için DoneAt’ı seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và giữ mặt đồng hồ, chạm vào Chỉnh sửa, sau đó chọn DoneAt cho một tổ hợp."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "按住表盘，轻点“编辑”，然后为复杂功能选择 DoneAt。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "按住錶面，點一下「編輯」，然後為複雜功能揀 DoneAt。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "按住錶面，點一下「編輯」，然後為複雜功能選擇 DoneAt。"
          }
        }
      }
    },
    "appleWatchSetupInstall": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت DoneAt من تطبيق Watch على iPhone، أو من App Store على Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere DoneAt über die Watch-App auf deinem iPhone oder über den App Store auf der Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install DoneAt from the Watch app on your iPhone, or from the App Store on Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala DoneAt desde la app Watch en tu iPhone, o desde el App Store en tu Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez DoneAt depuis l’app Watch sur votre iPhone, ou depuis l’App Store sur votre Apple Watch."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर Watch ऐप से, या Apple Watch पर App Store से DoneAt इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal DoneAt dari app Watch di iPhone Anda, atau dari App Store di Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa DoneAt dall’app Watch sul tuo iPhone, oppure dall’App Store su Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのWatchアプリから、またはApple WatchのApp StoreからDoneAtをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Watch 앱 또는 Apple Watch의 App Store에서 DoneAt을 설치하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या iPhone वरील Watch अॅपमधून, किंवा Apple Watch वरील App Store मधून DoneAt इंस्टॉल करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o DoneAt pelo app Watch no seu iPhone, ou pela App Store no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите DoneAt через приложение Watch на iPhone или через App Store на Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง DoneAt จากแอป Watch บน iPhone หรือจาก App Store บน Apple Watch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoneAt’ı iPhone’unuzdaki Watch uygulamasından veya Apple Watch’taki App Store’dan yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt DoneAt từ ứng dụng Watch trên iPhone, hoặc từ App Store trên Apple Watch."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Watch App 或 Apple Watch 上的 App Store 中安装 DoneAt。"
          }
        },
        "zh-HK": {

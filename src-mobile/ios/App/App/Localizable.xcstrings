    "sharePrivacyNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة والرابط يحملان مواعيد الدوام فقط — لا الراتب أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild und Link enthalten nur die Schicht – niemals das Gehalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image and link carry the shift only — never salary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen y el enlace solo llevan la jornada; nunca el sueldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image et le lien ne contiennent que les horaires — jamais le salaire."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज और लिंक में सिर्फ़ शिफ़्ट रहती है — वेतन कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar dan tautan hanya memuat shift — tidak pernah gaji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine e il link contengono solo il turno — mai lo stipendio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像とリンクに含まれるのはシフトだけで、給与は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지와 링크에는 근무 시간만 담기며 급여는 포함되지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज आणि लिंकमध्ये फक्त शिफ्ट असते — पगार कधीच नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem e o link levam apenas o turno — nunca o salário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение и ссылка содержат только смену — никогда зарплату."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและลิงก์มีแค่ข้อมูลกะ — ไม่มีเงินเดือนเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel ve bağlantı yalnızca vardiyayı taşır — maaşı asla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh và liên kết chỉ mang thông tin ca làm — không bao giờ có lương."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "图片和链接只包含班次时间，绝不包含薪资。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片同連結只包含班次時間，絕對唔會有人工。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片和連結只包含班次時間，絕不包含薪資。"
          }
        }
      }
    },

    "lifeAllocationMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تاريخ التقاعد وساعات عملك المعتادة ليظهر هذا الرقم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage ein Rentendatum und deine üblichen Arbeitszeiten ein, dann füllt sich das hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a retirement date and your usual hours, and this fills in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una fecha de jubilación y tu horario habitual, y esto se completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une date de retraite et vos horaires habituels, et ceci se remplira."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "रिटायरमेंट की तारीख और अपने सामान्य घंटे जोड़ें, फिर यह भर जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tanggal pensiun dan jam kerja biasamu, nanti bagian ini terisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una data di pensione e i tuoi orari abituali e qui comparirà il calcolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退職の時期と普段の勤務時間を入れると、ここが埋まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은퇴 시점과 평소 근무 시간을 넣으면 여기가 채워집니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "निवृत्तीची तारीख आणि नेहमीचे तास भरा, म्हणजे इथे आकडा येईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acrescenta uma data de reforma e o teu horário habitual, e isto preenche-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите дату выхода на пенсию и обычные часы — и здесь появится расчёт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่วันเกษียณกับเวลาทำงานปกติ แล้วส่วนนี้จะขึ้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir emeklilik tarihi ve olağan çalışma saatlerini ekle, burası dolsun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ngày nghỉ hưu và giờ làm thường ngày, phần này sẽ hiện ra."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "填上退休时间和平时的工作时长，这里就会算出来。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "填咗退休時間同平時嘅工作時數，呢度就會計到。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "填上退休時間和平時的工作時數，這裡就會算出來。"
          }
        }
      }
    },

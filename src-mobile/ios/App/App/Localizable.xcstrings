    "appleWatchSmartStackBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «إظهاره على شاشة القفل» في «تذكيرات الدوام»، ليظهر عدّك التنازلي أيضًا في الحزمة المكدسة الذكية على Apple Watch المقترنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Auf dem Sperrbildschirm anzeigen“ unter „Schicht-Erinnerungen“, dann erscheint dein Countdown auch im Smart-Stapel auf deiner gekoppelten Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Show on Lock Screen” in “Shift reminders”, and your countdown also appears in the Smart Stack on your paired Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Mostrar en la pantalla bloqueada» en «Recordatorios de jornada», y tu cuenta atrás también aparecerá en el grupo inteligente de tu Apple Watch emparejado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Afficher sur l'écran verrouillé » dans « Rappels d'horaires », et votre compte à rebours apparaît aussi dans le Défilement intelligent de votre Apple Watch couplée."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "«लॉक स्क्रीन पर दिखाएँ» को «शिफ़्ट रिमाइंडर» में चालू करें, और आपका काउंटडाउन आपकी पेयर की गई Apple Watch के स्मार्ट स्टैक में भी दिखाई देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan “Tampilkan di Layar Terkunci” di “Pengingat shift”, agar hitung mundur Anda juga muncul di Smart Stack pada Apple Watch Anda yang terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Mostra sulla schermata di blocco» in «Promemoria turno»: il tuo conto alla rovescia comparirà anche nella raccolta smart del tuo Apple Watch abbinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「シフトリマインダー」の「ロック画面に表示」をオンにすると、カウントダウンがペアリングしたApple Watchのスマートスタックにも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「근무 알림」에서 「잠금 화면에 표시」를 켜면 카운트다운이 페어링된 Apple Watch의 스마트 스택에도 표시됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "「शिफ्ट स्मरणपत्रे」मध्ये 「लॉक स्क्रीनवर दाखवा」सुरू करा, म्हणजे तुमचा काउंटडाउन तुमच्या पेअर केलेल्या Apple Watch च्या स्मार्ट स्टॅकमध्येही दिसेल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative “Mostrar na tela bloqueada” em “Lembretes de turno”, e sua contagem regressiva também aparece no Conjunto Inteligente do seu Apple Watch pareado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Показывать на экране блокировки» в разделе «Напоминания о смене», и ваш обратный отсчёт также появится в смарт-стопке на вашем сопряжённом Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด 「แสดงบนหน้าจอล็อก」ใน 「การแจ้งเตือนกะทำงาน」 แล้วตัวนับถอยหลังของคุณจะแสดงในวิดเจ็ตซ้อนอัจฉริยะบน Apple Watch ที่จับคู่ไว้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Vardiya hatırlatıcıları” içinde “Kilit ekranında göster”i açın, geri sayımınız eşlenen Apple Watch’unuzdaki Akıllı Gruplama’da da görünsün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật “Hiển thị trên Màn hình khóa” trong “Nhắc nhở ca làm”, để bộ đếm ngược của bạn cũng xuất hiện trong Ngăn xếp thông minh trên Apple Watch đã ghép nối của bạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在“班次提醒”中打开“在锁定屏幕上显示”后，倒计时也会出现在已配对 Apple Watch 的智能叠放里。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺「班次提醒」開啟「喺鎖定畫面顯示」之後，倒數亦會喺已配對 Apple Watch 嘅智慧型疊放入面顯示。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在「班次提醒」中開啟「在鎖定畫面上顯示」後，倒數也會出現在已配對 Apple Watch 的智慧型疊放中。"
          }
        }
      }
    },

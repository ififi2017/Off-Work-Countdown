    "plusOwnedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء بدفعة واحدة دفعة واحدة فقط، فلا شيء يتجدد ولا شيء تُديره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einmalkauf ist eine einzelne Zahlung — es gibt nichts zu verlängern und nichts zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime is a one-time purchase, so there is nothing to renew and nothing to manage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra para siempre es un pago único: no hay nada que renovar ni que gestionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat à vie est un paiement unique : rien à renouveler, rien à gérer."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की ख़रीद सिर्फ़ एक भुगतान है, इसलिए कुछ रिन्यू करने या संभालने की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali bayar cukup satu kali, jadi tidak ada yang perlu diperpanjang atau dikelola."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto per sempre è un pagamento unico: non c’è nulla da rinnovare né da gestire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りは一度の支払いなので、更新も管理も必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생은 한 번만 결제하므로 갱신할 것도, 관리할 것도 없습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एकदाच घेण्याची खरेदी एकच पेमेंट आहे, म्हणून नूतनीकरण किंवा व्यवस्थापन काहीच नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vitalício é um pagamento único: não há nada para renovar nem para gerir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка навсегда — один платёж: нечего продлевать и нечем управлять."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบจ่ายครั้งเดียวชำระครั้งเดียว จึงไม่มีอะไรต้องต่ออายุหรือต้องจัดการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma bir kez ödenir; yenilenecek ya da yönetilecek bir şey yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản trả một lần chỉ thanh toán một lần, nên không có gì phải gia hạn hay quản lý."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "终身版是一次性购买，没有需要续订的东西，也没有需要管理的订阅。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "終身版係一次性購買，冇嘢要續訂，都冇訂閱要管。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "終身版是一次性購買，沒有需要續訂的東西，也沒有需要管理的訂閱。"
          }
        }
      }
    },

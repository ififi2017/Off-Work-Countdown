        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple खाता बदल गया है, इसलिए सिंक रोक दिया गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Apple berganti, sinkronisasi dijeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account Apple è cambiato. La sincronizzazione è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントが変わったため、同期を止めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정이 바뀌어 동기화를 멈췄습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple खाते बदलले, त्यामुळे सिंक थांबवले आहे."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

    "debugResetNextLaunchDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي التشغيل التالي إلى مسح جميع إعدادات التطبيق وفتح شاشة الترحيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Start werden alle App-Einstellungen gelöscht und die Willkommensseite geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next launch clears all app settings and opens the welcome screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo inicio borrará todos los ajustes de la app y abrirá la pantalla de bienvenida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain lancement effacera tous les réglages de l’app et ouvrira l’écran de bienvenue."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार खोलने पर ऐप की सभी सेटिंग मिटेंगी और स्वागत स्क्रीन खुलेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dibuka lagi, semua pengaturan aplikasi akan dihapus dan layar sambutan akan ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al prossimo avvio verranno cancellate tutte le impostazioni dell’app e verrà aperta la schermata di benvenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の起動時にすべての設定を消去し、ようこそ画面を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 실행 시 모든 앱 설정을 지우고 시작 화면을 엽니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढील वेळी उघडताना अॅपच्या सर्व सेटिंग्ज हटवून स्वागत स्क्रीन उघडली जाईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na próxima abertura, todas as definições da app serão apagadas e o ecrã de boas-vindas será mostrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При следующем запуске все настройки приложения будут удалены и откроется экран приветствия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดครั้งถัดไป การตั้งค่าทั้งหมดของแอปจะถูกล้างและเปิดหน้าต้อนรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki açılışta tüm uygulama ayarları silinir ve karşılama ekranı açılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần mở tiếp theo sẽ xóa mọi cài đặt của ứng dụng và hiển thị màn hình chào mừng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "下次启动将清空 App 的所有设置并进入欢迎页。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "下次啟動會清除 App 的所有設定並進入歡迎頁。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",

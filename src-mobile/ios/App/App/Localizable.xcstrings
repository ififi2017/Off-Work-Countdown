    "onboardingPlusFocusTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعط مهمة واحدة فترة زمنية واضحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einer Aufgabe eine klare Zeitspanne"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give one task a clear stretch of time"
          }
        },
        "es": {

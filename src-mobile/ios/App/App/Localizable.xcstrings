    "applyFromNextShift": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الوردية التالية فقط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab der nächsten Schicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the next shift only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo desde el próximo turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du prochain service"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल अगली शिफ्ट से"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dari shift berikutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dal prossimo turno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のシフトから"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 근무부터"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त पुढच्या पाळीपासून"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a partir do próximo turno"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только со следующей смены"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งแต่กะถัดไปเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sonraki vardiyadan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ từ ca tiếp theo"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只从下一班起"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "淨係從下一班起"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只從下一班起"
          }
        }
      }
    },
    "applyScheduleMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«من الوردية التالية فقط» يُبقي اليوم كما هو. «غيّر اليوم أيضًا» يمسح الحضور المبكر والانصراف المبكر والعمل الإضافي لليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ab der nächsten Schicht“ lässt heute unverändert. „Heute auch ändern“ löscht heutiges frühes Kommen, frühes Gehen und Überstunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“From the next shift only” keeps today as it is. “Change today too” also clears today’s early clock-in, early clock-off and overtime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo desde el próximo turno» deja hoy igual. «Cambiar hoy también» borra la entrada temprana, la salida temprana y las horas extra de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À partir du prochain service » laisse aujourd’hui inchangé. « Modifier aujourd’hui aussi » efface l’arrivée anticipée, le départ anticipé et les heures sup. d’aujourd’hui."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "«अगली शिफ्ट से» आज को वैसा ही रखता है। «आज भी बदलें» आज की जल्दी आना, जल्दी जाना और ओवरटाइम मिटाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hanya dari shift berikutnya” menjaga hari ini. “Ubah hari ini juga” menghapus datang awal, pulang awal, dan lembur hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo dal prossimo turno» lascia oggi com’è. «Cambia anche oggi» cancella ingresso anticipato, uscita anticipata e straordinari di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次のシフトから」は今日を変えません。「今日も変更」は今日の早出・早退・残業をクリアします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「다음 근무부터」는 오늘을 유지합니다. 「오늘도 변경」은 오늘의 조기 출근·조기 퇴근·초과 근무를 지웁니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "「फक्त पुढच्या पाळीपासून」 आजची पाळी तशीच ठेवते. 「आजही असेच बदला」 आजची लवकर हजेरी, लवकर सुट्टी आणि ओव्हरटाइम पुसते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Só a partir do próximo turno” mantém o dia de hoje. “Alterar hoje também” limpa a entrada cedo, a saída cedo e as horas extra de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Только со следующей смены» оставляет сегодня как есть. «Изменить и сегодня» сбрасывает ранний приход, ранний уход и сверхурочные за сегодня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "「ตั้งแต่กะถัดไป」วันนี้เหมือนเดิม 「เปลี่ยนวันนี้ด้วย」จะล้างการมาเร็ว เลิกเร็ว และโอทีของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnızca sonraki vardiyadan” bugünü olduğu gibi bırakır. “Bugünü de değiştir” bugünün erken girişi, erken çıkışı ve mesaisini temizler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Chỉ từ ca tiếp theo” giữ nguyên hôm nay. “Đổi cả hôm nay” xóa vào sớm, tan sớm và tăng ca của hôm nay."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "「只从下一班起」今天这一班不变。「今天也改成这样」会清掉今天的提前上班、提前下班和加班。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「淨係從下一班起」今日呢一班唔變。「今日都改成噉」會清走今日嘅提早返工、提早收工同加班。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「只從下一班起」今天這一班不變。「今天也改成這樣」會清掉今天的提前上班、提前下班和加班。"
          }
        }
      }
    },
    "applyScheduleTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل نطبّق هذا على اليوم؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch für heute übernehmen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply this to today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aplicar también a hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer aussi à aujourd’hui ?"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",

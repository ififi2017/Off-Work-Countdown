    "focusBreakReminderBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطتك فيها استراحة {{count}} دقيقة هنا. قِف قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan sieht hier {{count}} Minuten Pause vor. Steh kurz auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan has a {{count}}-minute break here. Stand up for a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan tiene aquí una pausa de {{count}} minutos. Levántate un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre plan prévoit une pause de {{count}} minutes ici. Levez-vous un instant."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी योजना में यहाँ {{count}} मिनट का विराम है। थोड़ा उठ जाइए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencanamu punya istirahat {{count}} menit di sini. Berdirilah sebentar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano prevede qui una pausa di {{count}} minuti. Alzati un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定ではここが {{count}} 分の休憩です。少し立ち上がりましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획상 지금은 {{count}}분 휴식입니다. 잠깐 일어나 보세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या योजनेत इथे {{count}} मिनिटांची विश्रांती आहे. जरा उठा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu plano tem aqui uma pausa de {{count}} minutos. Levanta-te um momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По плану здесь перерыв {{count}} мин. Встаньте ненадолго."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนของคุณมีเวลาพัก {{count}} นาทีตรงนี้ ลุกขึ้นสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planında burada {{count}} dakikalık mola var. Biraz ayağa kalk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch của bạn có {{count}} phút nghỉ ở đây. Đứng dậy một lát nhé."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "计划里这会儿是 {{count}} 分钟长休息，起来动一动。"

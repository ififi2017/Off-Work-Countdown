    "focusNoEmptyBlock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هناك فترة فارغة في هذه الوردية. أُضيفت المهمة إلى قائمة اليوم."
          }

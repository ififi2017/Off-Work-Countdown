    "syncRestoreDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإحضار سجلاتك وملفك الشخصي والتفضيلات التي تمت مزامنتها إلى هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragen Sie Ihre Aufzeichnungen, Ihr Lebensprofil und Ihre synchronisierten Einstellungen auf dieses Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your records, life profile and synced preferences onto this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiga sus registros, perfil de vida y preferencias sincronizadas a este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apportez vos enregistrements, votre profil de vie et vos préférences synchronisées sur cet appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने रिकॉर्ड, जीवन प्रोफ़ाइल और समन्वयित प्राथमिकताओं को इस डिवाइस पर लाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa catatan Anda, profil kehidupan, dan preferensi yang disinkronkan ke perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta i tuoi record, il tuo profilo di vita e le tue preferenze sincronizzate su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、ライフプロフィール、同期された設定をこのデバイスに取り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록, 생활 프로필, 동기화된 기본 설정을 이 장치로 가져오세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर तुमचे रेकॉर्ड, जीवन प्रोफाइल आणि समक्रमित प्राधान्ये आणा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga seus registros, perfil de vida e preferências sincronizadas para este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите свои записи, жизненный профиль и синхронизированные настройки на это устройство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำบันทึก โปรไฟล์ชีวิต และการตั้งค่าการซิงค์ของคุณมาสู่อุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınızı, yaşam profilinizi ve senkronize edilmiş tercihlerinizi bu cihaza getirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa hồ sơ, hồ sơ cuộc sống và các tùy chọn đã đồng bộ hóa của bạn vào thiết bị này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将记录、人生档案和已同步的偏好设置恢复到此设备。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將你嘅記錄、生活個人檔案同同步偏好設定帶去呢部裝置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將您的記錄、生活檔案和同步的偏好設定到此設備上。"
          }
        }
      }
    },

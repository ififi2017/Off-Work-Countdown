    "syncOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة السجلات والرواتب والتفضيلات من خلال قاعدة بيانات iCloud الخاصة بك. تبقى أذونات الجهاز على كل جهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnungen, Gehälter und Präferenzen werden über Ihre private iCloud-Datenbank synchronisiert. Geräteberechtigungen bleiben auf jedem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records, salary and preferences sync through your private iCloud database. Device permissions stay on each device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros, salarios y preferencias se sincronizan a través de su base de datos privada de iCloud. Los permisos del dispositivo permanecen en cada dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements, le salaire et les préférences sont synchronisés via votre base de données iCloud privée. Les autorisations des appareils restent sur chaque appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड, वेतन और प्राथमिकताएँ आपके निजी iCloud डेटाबेस के माध्यम से समन्वयित होते हैं। डिवाइस अनुमतियाँ प्रत्येक डिवाइस पर रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan, gaji dan preferensi disinkronkan melalui database iCloud pribadi Anda. Izin perangkat tetap ada di setiap perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati, stipendio e preferenze vengono sincronizzati tramite il tuo database iCloud privato. Le autorizzazioni del dispositivo rimangono su ciascun dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、給与、好みはプライベート iCloud データベースを通じて同期されます。デバイスのアクセス許可は各デバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 iCloud 데이터베이스를 통해 기록, 급여 및 기본 설정이 동기화됩니다. 장치 권한은 각 장치에 유지됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या खाजगी iCloud डेटाबेसद्वारे रेकॉर्ड, पगार आणि प्राधान्ये समक्रमित करा. डिव्हाइस परवानग्या प्रत्येक डिव्हाइसवर राहतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros, salários e preferências são sincronizados por meio de seu banco de dados privado do iCloud. As permissões do dispositivo permanecem em cada dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи, зарплата и предпочтения синхронизируются через вашу частную базу данных iCloud. Разрешения устройства остаются на каждом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก เงินเดือน และการตั้งค่าจะซิงค์ผ่านฐานข้อมูล iCloud ส่วนตัวของคุณ สิทธิ์ของอุปกรณ์จะยังคงอยู่ในแต่ละอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar, maaşlar ve tercihler, özel iCloud veritabanınız aracılığıyla senkronize edilir. Cihaz izinleri her cihazda kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa hồ sơ, tiền lương và sở thích thông qua cơ sở dữ liệu iCloud riêng tư của bạn. Quyền của thiết bị vẫn còn trên mỗi thiết bị."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "记录、薪资和偏好设置通过你的 iCloud 私有数据库同步。设备授权保留在各设备。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄、薪酬同偏好會透過你嘅私人 iCloud 資料庫同步。裝置權限會保留喺每部裝置上面。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄、薪資和偏好透過您的私人 iCloud 資料庫同步。設備權限保留在每台設備上。"
          }
        }
      }
    },
    "syncPrivacyDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة جدول العمل والراتب والتذكيرات والمظهر واللغة وملفك الشخصي والسجلات وبيانات Focus من خلال قاعدة بيانات iCloud الخاصة بك. يبقى إذن الإشعارات والحماية البيومترية والأنشطة المباشرة على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Arbeitsplan, Ihr Gehalt, Ihre Erinnerungen, Ihr Aussehen, Ihre Sprache, Ihr Lebensprofil, Ihre Aufzeichnungen und Ihre Focus-Daten werden über Ihre private iCloud-Datenbank synchronisiert. Benachrichtigungsberechtigung, biometrischer Schutz und Live-Aktivitäten bleiben auf diesem Gerät erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your work schedule, salary, reminders, appearance, language, Life profile, records and Focus data sync through your private iCloud database. Notification permission, biometric protection and Live Activities stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su horario de trabajo, salario, recordatorios, apariencia, idioma, perfil de vida, registros y datos de Focus se sincronizan a través de su base de datos privada de iCloud. El permiso de notificación, la protección biométrica y las actividades en vivo permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre horaire de travail, votre salaire, vos rappels, votre apparence, votre langue, votre profil de vie, vos enregistrements et vos données Focus sont synchronisés via votre base de données iCloud privée. L'autorisation de notification, la protection biométrique et les activités en direct restent sur cet appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कार्य शेड्यूल, वेतन, अनुस्मारक, उपस्थिति, भाषा, जीवन प्रोफ़ाइल, रिकॉर्ड और फोकस डेटा आपके निजी iCloud डेटाबेस के माध्यम से सिंक होते हैं। अधिसूचना अनुमति, बायोमेट्रिक सुरक्षा और लाइव गतिविधियाँ इस डिवाइस पर रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal kerja, gaji, pengingat, penampilan, bahasa, profil Kehidupan, catatan, dan sinkronisasi data Fokus Anda melalui database iCloud pribadi Anda. Izin notifikasi, perlindungan biometrik, dan Aktivitas Langsung tetap ada di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo programma di lavoro, stipendio, promemoria, aspetto, lingua, profilo di vita, record e sincronizzazione dei dati Focus tramite il tuo database iCloud privato. L'autorizzazione alle notifiche, la protezione biometrica e le attività live rimangono su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの仕事のスケジュール、給料、リマインダー、外見、言語、人生プロフィール、記録、そしてFocusデータはあなたのプライベートiCloudデータベースを通じて同期されます。通知許可、生体認証保護、ライブ アクティビティはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 일정, 급여, 미리 알림, 외모, 언어, 생활 프로필, 기록 및 Focus 데이터는 개인 iCloud 데이터베이스를 통해 동기화됩니다. 알림 권한, 생체 인식 보호 및 실시간 활동은 이 장치에 유지됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे कामाचे वेळापत्रक, पगार, स्मरणपत्रे, स्वरूप, भाषा, जीवन प्रोफाइल, रेकॉर्ड आणि फोकस डेटा तुमच्या खाजगी iCloud डेटाबेसद्वारे सिंक. सूचना परवानगी, बायोमेट्रिक संरक्षण आणि थेट क्रियाकलाप या डिव्हाइसवर राहतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu horário de trabalho, salário, lembretes, aparência, idioma, perfil de vida, registros e dados do Focus são sincronizados por meio de seu banco de dados privado do iCloud. Permissão de notificação, proteção biométrica e atividades ao vivo permanecem neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш график работы, зарплата, напоминания, внешний вид, язык, профиль жизни, записи и данные Focus синхронизируются через вашу личную базу данных iCloud. Разрешение на уведомления, биометрическую защиту и интерактивные действия остаются на этом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางงาน เงินเดือน ตัวเตือน รูปร่างหน้าตา ภาษา ประวัติชีวิต บันทึกและข้อมูลโฟกัสจะซิงค์ผ่านฐานข้อมูล iCloud ส่วนตัวของคุณ การอนุญาตการแจ้งเตือน การป้องกันด้วยไบโอเมตริก และกิจกรรมสดจะยังคงอยู่ในอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma programınız, maaşınız, hatırlatıcılarınız, görünümünüz, diliniz, Yaşam profiliniz, kayıtlarınız ve Focus verileriniz özel iCloud veritabanınız aracılığıyla senkronize edilir. Bildirim izni, biyometrik koruma ve Canlı Etkinlikler bu cihazda kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch trình làm việc, mức lương, lời nhắc, ngoại hình, ngôn ngữ, hồ sơ Cuộc sống, hồ sơ và dữ liệu Focus được đồng bộ hóa thông qua cơ sở dữ liệu iCloud riêng tư của bạn. Quyền thông báo, bảo vệ sinh trắc học và Hoạt động trực tiếp vẫn có trên thiết bị này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作安排、薪资、提醒、外观、语言、人生档案、记录和专注数据会通过你的 iCloud 私有数据库同步。通知权限、生物识别保护和实时活动只保留在这台设备上。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅工作時間表、人工、提醒、外表、語言、生活簡介、記錄同埋焦點數據會透過你嘅私人 iCloud 資料庫同步。通知權限、生物識別保護同埋即時活動會保留喺呢部裝置上面。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您的工作行程、薪資、提醒、外觀、語言、生活檔案、記錄和焦點資料透過您的私人 iCloud 資料庫同步。通知權限、生物辨識保護和即時活動保留在此裝置上。"
          }
        }
      }
    },
    "syncRemoveDevice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {

    "alternatingCurrentWeekDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد هذا الاختيار نقطة بدء التناوب بين أسبوع بيوم راحة وأسبوع بيومي راحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl legt fest, mit welcher Woche der Wechsel zwischen einem und zwei freien Tagen beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sets the starting point for the single-rest and double-rest week rotation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta selección define desde qué semana empieza la alternancia entre uno y dos días libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce choix définit le point de départ de l’alternance entre les semaines avec un ou deux jours de repos."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चयन तय करता है कि एक और दो छुट्टी वाले सप्ताहों का क्रम किस सप्ताह से शुरू होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan ini menentukan titik awal pergantian minggu dengan satu dan dua hari libur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scelta stabilisce da quale settimana parte l’alternanza tra uno e due giorni di riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の選択が、週休1日と週休2日のローテーションの起点になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 선택이 주 1일 휴무와 주 2일 휴무 순환의 시작점이 됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हा पर्याय एक आणि दोन सुट्ट्यांच्या आठवड्यांचे चक्र कोणत्या आठवड्यापासून सुरू होईल ते ठरवतो."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta escolha define o início da alternância entre semanas com uma e duas folgas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот выбор задаёт начальную точку чередования недель с одним и двумя выходными."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกนี้กำหนดจุดเริ่มต้นของการสลับสัปดาห์ที่หยุดหนึ่งวันและสองวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçim, bir ve iki izin günlü haftaların hangi haftadan başlayarak dönüşeceğini belirler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn này xác định tuần bắt đầu chu kỳ luân phiên giữa một và hai ngày nghỉ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本周选择会确定单双休交替从哪一周开始。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本週的選擇會決定大小週從哪一週開始交替。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本週的選擇會決定大小週從哪一週開始交替。"
          }
        }
      }
    },

            "state": "translated",
            "value": "Scegli un orario di fine più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この勤務の終了時刻を延長します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 근무의 종료 시간을 늦춥니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या शिफ्टसाठी उशिराची समाप्ती निवडा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

    "scheduleSharedRulesNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع المؤقت والتذكيرات والأدوات هذا الجدول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer, Erinnerungen und Widgets folgen diesem Arbeitsplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer, reminders and widgets all follow this schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador, los avisos y los widgets siguen este horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur, les rappels et les widgets suivent tous ce planning."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर, रिमाइंडर और विजेट सभी इसी शेड्यूल का पालन करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer, pengingat, dan widget mengikuti jadwal ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer, promemoria e widget seguono tutti questo orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー、通知、ウィジェットはすべてこのスケジュールに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머, 알림, 위젯이 모두 이 일정을 따릅니다."
          }
        },
        "mr-IN": {
          "stringUnit": {

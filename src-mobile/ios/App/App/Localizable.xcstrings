    "debugSeedRecordsDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب بيانات حضور وانصراف لعدة أسابيع، ويوم إجازة واحدًا، وعملًا إضافيًا، وملف حياة، ومهمتَي تركيز. المخططات والتركيز يحتاجان Plus كما هما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt einige Wochen Kommen und Gehen, einen Urlaubstag, Überstunden, ein Lebensprofil und zwei Fokus-Aufgaben. Diagramme und Fokus brauchen weiterhin Plus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes a few weeks of clock-ins, one leave day, overtime, a life profile, and two focus tasks. Charts and Focus still need Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe unas semanas de entradas y salidas, un día de permiso, horas extra, un perfil de vida y dos tareas de Enfoque. Los gráficos y Enfoque siguen necesitando Plus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit quelques semaines d’arrivées et de départs, un jour de congé, des heures supplémentaires, un profil de vie et deux tâches Focus. Les graphiques et Focus demandent toujours Plus."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले कुछ हफ़्तों की आने-जाने की एंट्री, एक दिन की छुट्टी, ओवरटाइम, एक जीवन प्रोफ़ाइल और दो फ़ोकस काम लिखता है। चार्ट और फ़ोकस के लिए Plus तब भी ज़रूरी रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulis beberapa minggu jam masuk dan pulang, satu hari izin, lembur, profil hidup, dan dua tugas Fokus. Grafik dan Fokus tetap butuh Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive alcune settimane di entrate e uscite, un giorno di permesso, straordinari, un profilo di vita e due attività Focus. Grafici e Focus richiedono comunque Plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近数週間の出退勤、休暇1日、残業、ライフプロフィール、フォーカスのタスク2件を書き込みます。グラフとフォーカスは引き続き Plus が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 몇 주의 출퇴근, 휴가 하루, 초과 근무, 인생 프로필, 집중 작업 두 개를 기록합니다. 차트와 집중은 여전히 Plus가 필요합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "गेल्या काही आठवड्यांची येण्या-जाण्याची वेळ, एक सुट्टीचा दिवस, ओव्हरटाइम, एक जीवन प्रोफाइल आणि दोन फोकस कामे लिहितो. आलेख आणि फोकससाठी Plus तरीही लागेल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve algumas semanas de entradas e saídas, um dia de licença, horas extras, um perfil de vida e duas tarefas de Foco. Os gráficos e o Foco continuam a exigir o Plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишет несколько недель приходов и уходов, один день отпуска, переработку, профиль жизни и две задачи Фокуса. Графики и Фокус по-прежнему требуют Plus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนเวลาเข้าออกงานย้อนหลังไม่กี่สัปดาห์ วันลาหนึ่งวัน โอที โปรไฟล์ชีวิต และงานโฟกัสสองรายการ กราฟและโฟกัสยังต้องมี Plus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son birkaç haftanın giriş çıkışlarını, bir izin gününü, fazla mesaiyi, bir yaşam profilini ve iki Odak görevini yazar. Grafikler ve Odak yine Plus gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi vài tuần giờ vào giờ ra, một ngày nghỉ phép, tăng ca, một hồ sơ cuộc đời và hai việc Tập trung. Biểu đồ và Tập trung vẫn cần Plus."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "写入最近几周的上下班、一天请假、加班、人生档案和两个专注任务。图表和专注仍要先打开 Plus。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入最近幾個禮拜嘅上下班、一日請假、加班、人生檔案同兩個專注任務。圖表同專注仲要先開 Plus。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入最近幾週的上下班、一天請假、加班、人生檔案和兩個專注任務。圖表和專注仍要先開啟 Plus。"
          }
        }
      }
    },

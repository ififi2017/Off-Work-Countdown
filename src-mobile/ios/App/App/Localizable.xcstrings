          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desligadas, por isso pode perder o fim deste temporizador. Pode ligá-las nas definições do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены, поэтому вы можете пропустить конец таймера. Их можно включить в системных настройках."
          }
        },
        "th": {
          "stringUnit": {

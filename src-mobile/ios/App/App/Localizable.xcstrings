    "focusTimerSettingsBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق هذه الإعدادات على المؤقتات الجديدة. يحتفظ المؤقت الجاري والخطة المحفوظة بمدتهما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen gelten für neue Timer. Ein laufender Timer und ein gespeicherter Plan behalten ihre eigenen Zeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply to new timers. A running timer and a saved plan keep their own timing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos ajustes se aplican a los temporizadores nuevos. El temporizador activo y el plan guardado conservan sus propios tiempos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages s’appliquent aux nouveaux minuteurs. Le minuteur en cours et le planning enregistré gardent chacun leur durée."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ये सेटिंग नए टाइमर पर लागू होती हैं। चालू टाइमर और सेव किया गया प्लान अपनी-अपनी अवधि बनाए रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan ini berlaku untuk timer baru. Timer yang sedang berjalan dan rencana tersimpan mempertahankan durasinya masing-masing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni valgono per i nuovi timer. Il timer in corso e il piano salvato mantengono le rispettive durate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は新しいタイマーに適用されます。実行中のタイマーと保存済みの計画はそれぞれの時間を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 새 타이머에 적용됩니다. 실행 중인 타이머와 저장된 계획은 각자의 시간을 유지합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ही सेटिंग्ज नवीन टायमरवर लागू होतात. सुरू असलेला टायमर आणि सेव्ह केलेला प्लॅन आपापला कालावधी ठेवतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas definições aplicam-se a novos temporizadores. O temporizador em curso e o plano guardado mantêm as suas próprias durações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти настройки применяются к новым таймерам. Запущенный таймер и сохранённый план сохраняют свои интервалы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่านี้ใช้กับตัวจับเวลาใหม่ ตัวจับเวลาที่กำลังทำงานและแผนที่บันทึกไว้จะคงระยะเวลาของตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayarlar yeni zamanlayıcılara uygulanır. Çalışan zamanlayıcı ve kaydedilen plan kendi sürelerini korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cài đặt này áp dụng cho hẹn giờ mới. Hẹn giờ đang chạy và kế hoạch đã lưu giữ thời lượng riêng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置只用于新的计时。正在运行的计时和已保存的计划会保留各自的时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢啲設定只套用到新計時。正在進行嘅計時同已儲存嘅計劃會保留各自嘅時間。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些設定只套用到新的計時。正在進行的計時和已儲存的計畫會保留各自的時間。"
          }
        }
      }
    },
    "focusTimerSettingsHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مدد مؤقتات التركيز والاستراحات الجديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauern für neue Fokus-Timer und Pausen festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set durations for new focus timers and breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la duración de los nuevos temporizadores de enfoque y descansos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez la durée des nouveaux minuteurs de concentration et des pauses."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "नए फोकस टाइमर और विश्राम की अवधि तय करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur durasi timer fokus dan istirahat baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la durata dei nuovi timer di focus e delle pause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい集中タイマーと休憩の時間を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 집중 타이머와 휴식 시간을 정합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन फोकस टायमर आणि विश्रांतीचा कालावधी ठरवा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a duração dos novos temporizadores de foco e das pausas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте длительность новых таймеров фокуса и перерывов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งระยะเวลาของตัวจับเวลาโฟกัสและช่วงพักใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni odak zamanlayıcıları ve molaların sürelerini ayarlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt thời lượng cho hẹn giờ tập trung và giờ nghỉ mới."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设置新专注计时与休息的时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定新專注計時同休息嘅時間。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "設定新專注計時與休息的時間。"
          }
        }
      }
    },
    "focusTimerSettingsLockedRunning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنه المؤقت الجاري قبل تغيير الوتيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende den laufenden Timer, bevor du den Rhythmus änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the running timer before changing its cadence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el temporizador activo antes de cambiar el ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez le minuteur en cours avant de modifier le rythme."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लय बदलने से पहले चालू टाइमर पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan timer yang berjalan sebelum mengubah ritme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina il timer in corso prima di cambiare il ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のタイマーを終えてから間隔を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 타이머를 끝낸 후 간격을 바꾸세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लय बदलण्यापूर्वी सुरू असलेला टायमर पूर्ण करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine o temporizador em curso antes de alterar o ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите запущенный таймер перед сменой ритма."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จบตัวจับเวลาที่กำลังทำงานก่อนเปลี่ยนจังหวะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmi değiştirmeden önce çalışan zamanlayıcıyı bitirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết thúc hẹn giờ đang chạy trước khi đổi nhịp."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束正在运行的计时，再调整节奏。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先結束正在進行嘅計時，再調整節奏。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請先結束正在進行的計時，再調整節奏。"
          }
        }
      }
    },
    "focusTimerSettingsLockedTemplate": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما دام هناك يوم معتاد محفوظ، يبقى طول الفترة ثابتًا — فخاناته مرقّمة وفقًا له."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange ein üblicher Tag gesichert ist, bleibt die Blocklänge fest — dessen Plätze sind danach nummeriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block length is fixed while a usual day is saved — its slots are numbered against it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras haya un día habitual guardado, la duración del bloque queda fija: sus ranuras se numeran según ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu’une journée habituelle est enregistrée, la durée des blocs est figée : ses emplacements y sont numérotés."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई सामान्य दिन सहेजा हो, ब्लॉक की लंबाई तय रहती है — उसके स्लॉट उसी से गिने जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama ada hari biasa tersimpan, panjang blok tetap — slotnya dinomori berdasarkan itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché è salvata una giornata abituale, la durata del blocco resta fissa: le sue posizioni sono numerate su di essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもの一日を保存している間、ブロックの長さは固定されます。枠がその長さで番号付けされているためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 하루가 저장되어 있으면 블록 길이가 고정됩니다. 슬롯이 그 길이로 번호가 매겨져 있기 때문입니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "नेहमीचा दिवस जतन असताना ब्लॉकची लांबी निश्चित राहते — त्याच्या जागा त्यानुसार क्रमांकित असतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto houver um dia habitual guardado, a duração do bloco fica fixa — as vagas são numeradas por ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока сохранён обычный день, длина блока зафиксирована — его слоты пронумерованы по ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่มีวันที่ใช้บ่อยบันทึกไว้ ความยาวช่วงจะคงที่ เพราะช่องถูกนับตามความยาวนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı bir “her zamanki gün” varken blok süresi sabittir; yuvaları ona göre numaralanmıştır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đã lưu một ngày thường dùng, độ dài ô sẽ cố định — các vị trí được đánh số theo nó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "存了常用的一天之后，专注时长会固定——它的格子是按这个时长编号的。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "存了常用的一天之後，專注時長會固定——它的格子是按這個時長編號的。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "存了常用的一天之後，專注時長會固定——它的格子是按這個時長編號的。"
          }
        }
      }
    },

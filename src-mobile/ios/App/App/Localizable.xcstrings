    "rulesErrorBanner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قواعد العد التنازلي غير متاحة. جدولك ما زال يعمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown-Regeln nicht verfügbar. Dein Plan läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown rules are unavailable. Your schedule is still on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas del temporizador no están disponibles. Tu horario sigue activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles du compte à rebours sont indisponibles. Votre planning continue."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "काउंटडाउन नियम उपलब्ध नहीं। आपका शिड्यूल चल रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aturan hitung mundur tidak tersedia. Jadwal Anda tetap jalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole del timer non sono disponibili. L’orario resta attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウン規則を読み込めません。スケジュールは止まっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운 규칙을 쓸 수 없습니다. 일정은 그대로입니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "उलटगणतीचे नियम सध्या वापरता येत नाहीत. वेळापत्रक थांबलेले नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras da contagem estão indisponíveis. O horário continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила таймера недоступны. График не остановлен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎนับถอยหลังใช้ไม่ได้ ตารางของคุณยังทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayım kuralları yok. Programınız durmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc đếm ngược tạm thời không dùng được. Lịch của bạn vẫn chạy."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "计时规则暂时不可用，排班没有停。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "計時規則暫時用唔到，排班冇停。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "計時規則暫時不可用，排班沒有停。"
          }
        }
      }
    },

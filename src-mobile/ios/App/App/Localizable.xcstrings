    "recordsEmptyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر اليوم هنا عندما تبدأ العدّ التنازلي أو تنهيه. لا يُملأ الجدول مسبقاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag erscheint hier, wenn du einen Countdown startest oder beendest. Der Plan wird nicht vorausgefüllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day shows up here when you start or finish a countdown. Your schedule is not filled in ahead of time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día aparece aquí cuando empiezas o terminas una cuenta atrás. El horario no se rellena de antemano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour apparaît ici quand vous démarrez ou terminez un compte à rebours. Le planning n’est pas prérempli."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप काउंटडाउन शुरू या खत्म करते हैं, वह दिन यहाँ दिखता है। शिफ्ट पहले से नहीं भरी जाती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu hari muncul di sini saat Anda mulai atau mengakhiri hitung mundur. Jadwal tidak diisi di muka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno compare qui quando avvii o termini un conto alla rovescia. Il turno non viene precompilato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンを開始または終了した日がここに現れます。シフトはあらかじめ埋めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운을 시작하거나 끝낸 날이 여기에 나타납니다. 근무표는 미리 채워 두지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "उलट्या घड्याळ सुरू किंवा संपवलेला दिवस इथे दिसेल. शिफ्ट आधीच भरली जात नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia aparece aqui quando começas ou terminas uma contagem. O horário não é preenchido à frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День появится здесь, когда вы запустите или остановите отсчёт. График заранее не заполняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่จะปรากฏที่นี่เมื่อคุณเริ่มหรือจบการนับถอยหลัง ตารางกะจะไม่ถูกใส่ล่วงหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayımı başlattığın veya bitirdiğin gün burada görünür. Mesai çizelgesi önceden doldurulmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ngày hiện ở đây khi bạn bắt đầu hoặc kết thúc đếm ngược. Lịch ca không được điền sẵn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "开始或结束一次倒计时，这一天就会出现在这里。排班不会预先填进列表。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開始或結束一次倒數，呢一日就會出現喺呢度。更表唔會預先填入列表。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開始或結束一次倒數，這一天就會出現在這裡。排班不會預先填進列表。"
          }
        }
      }
    },

    "appleWatchIntro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألقِ نظرة على معصمك لمعرفة أين وصل يوم عملك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Blick aufs Handgelenk zeigt dir, wo dein Arbeitstag gerade steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where your workday stands with a glance at your wrist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un vistazo a tu muñeca, ve en qué punto está tu jornada laboral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’un coup d’œil à votre poignet, découvrez où en est votre journée de travail."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कलाई पर एक नज़र डालकर देखें आपका कार्यदिवस कहाँ तक पहुँचा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sekilas ke pergelangan tangan Anda untuk tahu sampai mana hari kerja Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un’occhiata al polso, scopri a che punto è la tua giornata lavorativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首にひと目で、今日の勤務状況がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손목을 한 번 보는 것만으로 오늘 근무가 어디까지 왔는지 알 수 있어요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मनगटावर एक नजर टाकून तुमचा कामाचा दिवस कुठपर्यंत आला आहे ते पाहा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma olhada no pulso, veja em que ponto está o seu dia de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взгляните на запястье, чтобы узнать, на каком этапе ваш рабочий день."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แค่เหลือบดูข้อมือก็รู้ว่าวันทำงานของคุณไปถึงไหนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bileğinize bir göz atarak iş gününüzün nerede olduğunu görün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần liếc nhìn cổ tay là biết ngày làm việc của bạn đã đến đâu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "抬腕即可了解今天的工作进度。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起手腕就可以睇到今日嘅工作進度。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起手腕即可了解今天的工作進度。"
          }
        }
      }
    },

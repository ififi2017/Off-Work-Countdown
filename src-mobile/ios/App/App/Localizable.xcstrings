    "recordsOperationExportFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إنشاء ملف النسخة الاحتياطية. سجلاتك لم تتغير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherungsdatei konnte nicht erstellt werden. Deine Aufzeichnungen bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't create the backup file. Your records are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el archivo de copia. Tus registros no han cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le fichier de sauvegarde. Vos records restent inchangés."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप फ़ाइल बनाई नहीं जा सकी। आपके रिकॉर्ड नहीं बदले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File cadangan tidak dapat dibuat. Catatan Anda tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il file di backup. I record non sono cambiati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップファイルを作成できませんでした。記録は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 파일을 만들 수 없습니다. 기록은 변경되지 않았습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "बॅकअप फाइल तयार करता आली नाही. तुमचे रेकॉर्ड बदलले नाहीत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o ficheiro de cópia. Os seus registos não foram alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать файл резервной копии. Записи не изменились."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างไฟล์ข้อมูลสำรองไม่ได้ บันทึกของคุณไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek dosyası oluşturulamadı. Kayıtlarınız değişmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo tệp sao lưu. Bản ghi của bạn không thay đổi."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建备份文件，记录未改变。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立備份檔案，記錄冇改變。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立備份檔案，記錄沒有變更。"
          }
        }
      }
    },

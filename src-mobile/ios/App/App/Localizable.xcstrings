    "appleWatchAppBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحالة والوقت المتبقي والتقدم ووقت الانصراف في نظرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status, verbleibende Zeit, Fortschritt und dein Feierabend auf einen Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status, time left, progress and your off-work time in one glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado, tiempo restante, progreso y tu hora de salida de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statut, temps restant, progression et votre heure de départ en un coup d’œil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र में स्थिति, बचा हुआ समय, प्रगति और आपके छूटने का समय।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status, sisa waktu, kemajuan, dan waktu pulang Anda sekilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato, tempo rimanente, avanzamento e la tua uscita in un colpo d’occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータス、残り時間、進捗、退勤時刻をひと目で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태, 남은 시간, 진행률, 퇴근 시간을 한눈에."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिती, उरलेला वेळ, प्रगती आणि तुमची सुट्टीची वेळ एका नजरेत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Status, tempo restante, progresso e sua hora de saída em um único olhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус, оставшееся время, прогресс и время окончания работы одним взглядом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะ เวลาที่เหลือ ความคืบหน้า และเวลาเลิกงานของคุณในที่เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum, kalan süre, ilerleme ve iş çıkış saatiniz tek bakışta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái, thời gian còn lại, tiến độ và giờ tan ca của bạn, xem trong nháy mắt."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到状态、剩余时间、进度和下班时间。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼睇到狀態、剩餘時間、進度同下班時間。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到狀態、剩餘時間、進度和下班時間。"
          }
        }
      }
    },

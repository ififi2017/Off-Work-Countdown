    "salaryPrivacyNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقدَّر «ما كسبته اليوم» من هذه الإعدادات ومن دوامك. لا تعرضه الأدوات ولا الإشعارات ولا الأنشطة المباشرة أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Heute verdient“ wird hieraus und aus deiner Schicht geschätzt. In Widgets, Mitteilungen und Live-Aktivitäten erscheint der Betrag nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money Earned Today is estimated from this and your shift. Widgets, notifications and Live Activities never show it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ganado hoy» se estima a partir de esto y de tu jornada. Los widgets, las notificaciones y las actividades en vivo nunca lo muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Gagné aujourd'hui » est estimé à partir de ceci et de vos horaires. Les widgets, notifications et activités en direct ne l'affichent jamais."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "«आज की कमाई» इसी सेटिंग और आपकी शिफ़्ट से अनुमानित है। विजेट, नोटिफ़िकेशन और लाइव ऐक्टिविटी इसे कभी नहीं दिखाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Pendapatan hari ini» diperkirakan dari sini dan dari shift-mu. Widget, notifikasi, dan Live Activity tidak pernah menampilkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Guadagnato oggi» è stimato da questo dato e dal tuo turno. Widget, notifiche e attività in tempo reale non lo mostrano mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の収入は、この設定とシフトから推算した値です。ウィジェット、通知、ライブアクティビティには一切表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 번 돈은 이 설정과 근무 시간으로 추산한 값입니다. 위젯, 알림, 실시간 액티비티에는 절대 표시되지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "«आजची कमाई» याच सेटिंगवरून आणि तुमच्या शिफ्टवरून अंदाजित आहे. विजेट्स, सूचना आणि लाइव्ह ॲक्टिव्हिटी ती कधीही दाखवत नाहीत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ganho hoje» é estimado a partir disto e do seu turno. Widgets, notificações e Atividades ao Vivo nunca o mostram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Заработано сегодня» рассчитывается отсюда и из вашей смены. Виджеты, уведомления и Live-активности никогда его не показывают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "«รายได้วันนี้» ประมาณจากค่านี้และกะของคุณ วิดเจ็ต การแจ้งเตือน และกิจกรรมสดจะไม่แสดงตัวเลขนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bugün kazanılan», buradaki bilgiler ve vardiyanızdan tahmin edilir. Widget'lar, bildirimler ve Canlı Etkinlikler bunu asla göstermez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "«Kiếm được hôm nay» được ước tính từ đây và ca làm của bạn. Widget, thông báo và Hoạt động trực tiếp không bao giờ hiển thị con số này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "今日已赚由这里和你的班次推算得出。小组件、通知和实时活动都不会显示它。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今日已賺係由呢度同你嘅班次推算出嚟。小工具、通知同即時動態都唔會顯示佢。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "今日已賺由這裡和你的班次推算得出。小工具、通知和即時動態都不會顯示它。"
          }
        }
      }
    },

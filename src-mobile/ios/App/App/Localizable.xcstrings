    "firstRunCheckingCloud": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق من iCloud بحثًا عن إعداداتك وسجلاتك الحالية قبل إعداد هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen iCloud auf vorhandene Einstellungen und Aufzeichnungen, bevor du dieses Gerät einrichtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking iCloud for your existing settings and records before setting up this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando iCloud para encontrar tus ajustes y registros antes de configurar este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification d’iCloud pour retrouver vos réglages et enregistrements avant de configurer cet appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को सेट करने से पहले iCloud में आपकी मौजूदा सेटिंग और रिकॉर्ड देखे जा रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa iCloud untuk pengaturan dan catatan Anda yang sudah ada sebelum menyiapkan perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo controllando iCloud per trovare impostazioni e registri esistenti prima di configurare questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを設定する前に、iCloudに既存の設定と記録があるか確認しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 설정하기 전에 iCloud에서 기존 설정과 기록을 확인하고 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हे उपकरण सेट करण्यापूर्वी iCloud मध्ये तुमच्या विद्यमान सेटिंग्ज आणि नोंदी तपासत आहोत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o iCloud em busca dos seus ajustes e registros antes de configurar este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед настройкой этого устройства проверяем iCloud на наличие ваших настроек и записей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบ iCloud เพื่อค้นหาการตั้งค่าและบันทึกเดิมของคุณก่อนตั้งค่าอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı ayarlamadan önce mevcut ayarlarınızı ve kayıtlarınızı iCloud’da kontrol ediyoruz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra iCloud để tìm cài đặt và bản ghi hiện có trước khi thiết lập thiết bị này."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查 iCloud 中是否已有设置和记录，稍后再配置这台设备。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查 iCloud 是否已有設定和記錄，稍後再設定這部裝置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查 iCloud 是否已有設定和記錄，稍後再設定這台裝置。"
          }
        }
      }
    },

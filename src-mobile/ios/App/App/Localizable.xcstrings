    "cycleEndSummaryNotificationBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الدورة: {{days}} أيام عمل، و{{work}} من العمل المجدول أو المعدّل، و{{overtime}} من العمل الإضافي المسجل. نتمنى لك راحة سعيدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zyklus: {{days}} Arbeitstage, {{work}} geplante oder geänderte Arbeitszeit und {{overtime}} erfasste Überstunden. Erhol dich gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cycle: {{days}} workdays, {{work}} of scheduled or edited work, and {{overtime}} of recorded overtime. Enjoy your break."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ciclo: {{days}} días de trabajo, {{work}} de trabajo programado o editado y {{overtime}} de horas extra registradas. Que descanses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce cycle : {{days}} jours travaillés, {{work}} de travail planifié ou corrigé et {{overtime}} d’heures supplémentaires enregistrées. Reposez-vous bien."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चक्र में: {{days}} कार्यदिवस, {{work}} तय या संशोधित कार्य और {{overtime}} दर्ज ओवरटाइम। अच्छे से आराम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siklus ini: {{days}} hari kerja, {{work}} kerja terjadwal atau yang diedit, dan {{overtime}} lembur tercatat. Selamat beristirahat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ciclo: {{days}} giorni lavorativi, {{work}} di lavoro pianificato o modificato e {{overtime}} di straordinari registrati. Buon riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回のサイクル：勤務日{{days}}日、予定・修正した勤務{{work}}、記録済み残業{{overtime}}。ゆっくり休んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주기: 근무일 {{days}}일, 예정·수정 근무 {{work}}, 기록된 초과 근무 {{overtime}}. 편히 쉬세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या चक्रात: {{days}} कामाचे दिवस, {{work}} नियोजित किंवा दुरुस्त काम आणि {{overtime}} नोंदवलेला ओव्हरटाइम. छान विश्रांती घ्या."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ciclo: {{days}} dias de trabalho, {{work}} de trabalho programado ou ajustado e {{overtime}} de horas extra registadas. Bom descanso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот цикл: {{days}} рабочих дн., {{work}} плановой или исправленной работы и {{overtime}} записанных переработок. Хорошо отдохните."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบนี้: ทำงาน {{days}} วัน เวลาตามตารางหรือที่แก้ไข {{work}} และล่วงเวลาที่บันทึก {{overtime}} ขอให้พักผ่อนอย่างเต็มที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu döngü: {{days}} iş günü, {{work}} planlı veya düzenlenmiş çalışma ve {{overtime}} kayıtlı fazla mesai. İyi dinlenin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ này: {{days}} ngày làm việc, {{work}} theo lịch hoặc đã chỉnh sửa và {{overtime}} tăng ca đã ghi. Chúc bạn nghỉ ngơi vui vẻ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本周期：{{days}} 个工作日，排班与修正工时 {{work}}，已记录加班 {{overtime}}。辛苦了，休息愉快。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本週期：{{days}} 個工作日，排班與修正工時 {{work}}，已記錄加班 {{overtime}}。辛苦了，好好休息。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本週期：{{days}} 個工作日，排班與修正工時 {{work}}，已記錄加班 {{overtime}}。辛苦了，好好休息。"
          }
        }
      }
    },
    "cycleEndSummaryNotificationNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد كل سلسلة من أيام العمل المجدولة، اطلع على ملخص وقت العمل المخطط والتعديلات والعمل الإضافي المسجل — متاح مع Plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jeder Folge geplanter Arbeitstage siehst du eine Zusammenfassung von geplanter Arbeitszeit, Änderungen und erfassten Überstunden – mit Plus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After each run of scheduled workdays, see a summary of planned work, changes, and recorded overtime—available with Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cada serie de días programados, verás un resumen del trabajo planificado, los cambios y las horas extra registradas, disponible con Plus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque série de jours planifiés, retrouvez un résumé du temps prévu, des changements et des heures supplémentaires enregistrées, avec Plus."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तय कार्यदिवसों की हर अवधि के बाद, तय काम, बदलाव और दर्ज ओवरटाइम का सारांश देखें—यह Plus के साथ उपलब्ध है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah setiap rangkaian hari kerja terjadwal, lihat ringkasan kerja terjadwal, perubahan, dan lembur tercatat—tersedia dengan Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo ogni serie di giorni programmati, trovi un riepilogo del lavoro previsto, delle modifiche e degli straordinari registrati, disponibile con Plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定勤務日の連続が終わるたびに、予定時間、変更内容、記録済み残業のまとめを確認できます（Plus限定）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 연속 근무가 끝날 때마다 예정 근무, 변경 사항, 기록된 초과 근무를 요약해 보여 줍니다(Plus에서 이용 가능)."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "नियोजित कामाच्या दिवसांच्या प्रत्येक सलग कालावधीनंतर नियोजित काम, बदल आणि नोंदवलेल्या ओव्हरटाइमचा सारांश पाहा—हे फक्त Plus मध्ये उपलब्ध आहे."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após cada sequência de dias de trabalho programados, veja um resumo do trabalho previsto, das alterações e das horas extra registadas, disponível no Plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После каждой серии запланированных рабочих дней смотрите итог плановой работы, изменений и записанных переработок — функция Plus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจบช่วงวันทำงานตามตารางแต่ละช่วง ดูสรุปเวลางานตามตาราง การแก้ไข และเวลาล่วงเวลาที่บันทึกไว้ได้ด้วย Plus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlanan her çalışma günü dizisinin ardından planlanan çalışma, değişiklikler ve kayıtlı fazla mesai özetini görün; Plus ile kullanılabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau mỗi chuỗi ngày làm việc theo lịch, hãy xem tóm tắt thời gian theo lịch, các thay đổi và tăng ca đã ghi với Plus."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "每段排班结束后，查看计划工时、调整记录和已记录的加班摘要（Plus 会员可用）。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每段排班結束後，查看計劃工時、調整記錄同已記錄嘅加班摘要（Plus 會員可用）。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每段排班結束後，查看計畫工時、調整記錄與已記錄的加班摘要（Plus 會員可用）。"
          }
        }
      }
    },

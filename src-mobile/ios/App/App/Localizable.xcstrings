        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa nhật ký trên máy này. Bạn có thể khôi phục bằng cách nhập bản sao lưu cũ sau đó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",

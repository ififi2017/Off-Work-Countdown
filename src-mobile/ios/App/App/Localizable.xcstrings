    "notificationMilestone50": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت النصف، وما تبقى سيكون أسهل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hälfte ist geschafft – ab jetzt geht es bergab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halfway there—the rest is downhill."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has pasado la mitad; lo que queda será más llevadero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La moitié est faite, la suite sera plus légère."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आधा रास्ता पूरा हुआ, अब आगे आसान है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah lewat setengah jalan; sisanya akan lebih ringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai superato la metà: da qui sarà più facile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分を越えました。ここからは下り坂です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절반을 넘었어요. 이제 내리막길입니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्धा टप्पा पार झाला; पुढचा प्रवास सोपा आहे."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você passou da metade; daqui em diante fica mais leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Половина позади — дальше будет легче."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผ่านครึ่งทางแล้ว จากนี้จะเบาลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarısını geçtin; bundan sonrası daha kolay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã qua nửa chặng đường, phần còn lại sẽ nhẹ hơn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已经过半，后面都是下坡路。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已經過半，後面都是下坡路。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已經過半，後面都是下坡路。"
          }
        }
      }
    },
    "notificationMilestone75": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصعب جزء من اليوم أصبح خلفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der anstrengendste Teil des Tages liegt schon hinter dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hardest part of today is already behind you."
          }
        },
        "es": {

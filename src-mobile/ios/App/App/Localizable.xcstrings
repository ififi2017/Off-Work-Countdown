    "focusStopConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف هذه الفترة؟ الوقت المنقضي محفوظ والمهمة تبقى مفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einheit beenden? Die bisherige Zeit bleibt erhalten und die Aufgabe bleibt offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop this block? The time so far is kept and the task stays open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Parar este bloque? El tiempo hecho se guarda y la tarea sigue abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter cette séance ? Le temps écoulé est conservé et la tâche reste ouverte."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ब्लॉक रोकना है? अब तक का समय बचा रहेगा और काम खुला रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan blok ini? Waktu yang sudah jalan tetap tersimpan dan tugasnya masih terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermare questo blocco? Il tempo già fatto viene tenuto e l’attività resta aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブロックを止めますか？ ここまでの時間は残り、タスクはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 블록을 멈출까요? 지금까지의 시간은 남고 작업도 그대로 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हा टप्पा थांबवायचा? आतापर्यंतचा वेळ राहील आणि काम तसेच उघडे राहील."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar este bloco? O tempo já feito fica guardado e a tarefa continua aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить этот блок? Пройденное время сохранится, а задача останется открытой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดช่วงนี้ไหม เวลาที่ทำมาแล้วยังถูกเก็บไว้ และงานยังค้างอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu blok durdurulsun mu? Şimdiye kadarki süre saklanır, görev açık kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng phiên này? Thời gian đã làm được giữ lại và việc vẫn còn đó."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "结束这一段专注？已经过去的时间会保留，任务仍然是未完成。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "停咗呢段專注？已經過去嘅時間會保留，件事仲係未做完。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "結束這一段專注？已經過去的時間會保留，任務仍然沒完成。"
          }
        }
      }
    },

    "reviewPromptBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تود ترك تقييم في App Store؟ يساعد تقييمك مزيدًا من الأشخاص على العثور على التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du eine Bewertung im App Store hinterlassen? So können mehr Menschen die App finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like to leave a rating in the App Store? It helps more people find the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres dejar una valoración en el App Store? Ayudará a que más personas encuentren la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous laisser une note sur l’App Store ? Elle aidera davantage de personnes à découvrir l’app."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप App Store पर रेटिंग देना चाहेंगे? इससे ज़्यादा लोगों को ऐप खोजने में मदद मिलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mau memberi nilai di App Store? Penilaianmu membantu lebih banyak orang menemukan aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi lasciare una valutazione sull’App Store? Aiuterà altre persone a trovare l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeで評価していただけますか？より多くの方がアプリを見つける助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 평가를 남겨 주시겠어요? 더 많은 사람이 앱을 찾는 데 도움이 됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store वर रेटिंग द्याल का? त्यामुळे अधिक लोकांना हे ॲप सापडण्यास मदत होते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer deixar uma avaliação na App Store? Isso ajuda mais pessoas a encontrar a aplicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите оставить оценку в App Store? Это поможет другим людям найти приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการให้คะแนนใน App Store ไหม? คะแนนของคุณช่วยให้คนอื่นพบแอปนี้มากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store’da puan vermek ister misiniz? Bu, daha fazla kişinin uygulamayı bulmasına yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có muốn đánh giá trên App Store không? Đánh giá của bạn giúp nhiều người tìm thấy ứng dụng hơn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "愿意在 App Store 留下评价吗？你的评价能帮助更多人发现这款应用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "願意在 App Store 留下評分嗎？你的評分能幫助更多人發現這款應用程式。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "願意在 App Store 留下評分嗎？你的評分能幫助更多人發現這款 App。"
          }
        }
      }
    },

    "extendedRestKindNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام التي تحمل هذه المناوبة أيام راحة، فلا يبدأ فيها أي عد تنازلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage mit dieser Schicht sind frei – dafür startet kein Countdown."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days with this shift are rest days, so nothing counts down to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con este turno son de descanso, así que no empieza ninguna cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours avec ce service sont des jours de repos : aucun compte à rebours ne démarre."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शिफ़्ट वाले दिन छुट्टी के होते हैं, इसलिए उन पर उलटी गिनती शुरू नहीं होती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari dengan sif ini adalah hari libur, jadi hitung mundur tidak dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni con questo turno sono di riposo, quindi non parte nessun conto alla rovescia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシフトの日は休日になり、出勤のカウントダウンは始まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 근무가 배정된 날은 휴무일이라 출근 카운트다운이 시작되지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या शिफ्टचे दिवस सुट्टीचे असतात, त्यामुळे त्यांसाठी उलटगणती सुरू होत नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias com este turno são de folga, por isso nenhuma contagem começa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни с этой сменой — выходные, отсчёт до работы не запускается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่เป็นกะนี้คือวันพัก จึงไม่มีการนับถอยหลังเข้างาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vardiyanın olduğu günler izin günüdür; geri sayım başlamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ngày có ca này là ngày nghỉ nên không bắt đầu đếm ngược."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "排到这个班次的日子是休息日，不会开始上班倒计时。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "排咗呢個班次嘅日子係休息日，唔會開始返工倒數。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "排到這個班次的日子是休息日，不會開始上班倒數。"
          }
        }
      }
    },

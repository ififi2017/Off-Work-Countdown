          "stringUnit": {
            "state": "translated",
            "value": "साइडबार समेटें और काउंटडाउन पूरी स्क्रीन भर देगा — बस घड़ी और बार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup bilah sisi dan hitung mundur memenuhi layar — hanya jam dan bilah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la barra laterale e il conto alla rovescia riempie lo schermo: solo l'orologio e la barra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーを閉じるとカウントダウンが全画面に。時計とバーだけの表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바를 접으면 카운트다운이 화면을 가득 채웁니다 — 시계와 막대만 남습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "साइडबार मिटवा आणि काउंटडाउन पूर्ण स्क्रीन व्यापेल — फक्त घड्याळ आणि पट्टी."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolha a barra lateral e a contagem preenche a tela: só o relógio e a barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверните боковую панель, и отсчёт займёт весь экран — только часы и полоса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยุบแถบด้านข้าง แล้วการนับถอยหลังจะเต็มจอ — มีแค่นาฬิกากับแถบความคืบหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğunu kapat, geri sayım ekranı doldursun — yalnızca saat ve çubuk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu gọn thanh bên và đồng hồ đếm ngược sẽ chiếm trọn màn hình — chỉ đồng hồ và thanh tiến trình."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "收起侧边栏，倒计时就会占满整个屏幕——只有时钟和进度条，别无他物。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "收埋側邊欄，倒數就會佔滿成個螢幕——淨係得時鐘同進度條。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "收合側邊欄，倒數就會佔滿整個螢幕——只有時鐘和進度條，別無他物。"
          }
        }
      }
    },

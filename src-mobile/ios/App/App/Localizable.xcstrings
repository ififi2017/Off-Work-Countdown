    "whatsNewWatchBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من حالتك ووقت العمل المتبقي والتقدم بنظرة سريعة من معصمك، أو أضف إضافة دائرية أو مستطيلة. تطبيق Apple Watch والإضافات جزء من Plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Status, verbleibende Arbeitszeit und Fortschritt auf einen Blick am Handgelenk, oder füge eine runde oder rechteckige Komplikation hinzu. Die Apple Watch-App und Komplikationen gehören zu Plus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your status, remaining work time and progress at a glance on your wrist, or add a circular or rectangular complication. The Watch app and complications are part of Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tu estado, el tiempo de trabajo restante y el progreso de un vistazo en la muñeca, o añade una complicación circular o rectangular. La app de Apple Watch y las complicaciones forman parte de Plus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez votre statut, le temps de travail restant et la progression en un coup d’œil au poignet, ou ajoutez une complication ronde ou rectangulaire. L’app Apple Watch et les complications font partie de Plus."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कलाई पर एक नज़र में स्थिति, बचा हुआ काम का समय और प्रगति देखें, या एक गोल या चौकोर कॉम्प्लिकेशन जोड़ें। Apple Watch ऐप और कॉम्प्लिकेशन Plus का हिस्सा हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat status, sisa waktu kerja, dan kemajuanmu sekilas di pergelangan tangan, atau tambahkan komplikasi bundar atau persegi panjang. Aplikasi Apple Watch dan komplikasi adalah bagian dari Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla stato, tempo di lavoro rimanente e avanzamento a colpo d’occhio dal polso, oppure aggiungi una complicazione rotonda o rettangolare. L’app Apple Watch e le complicazioni fanno parte di Plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスや残りの勤務時間、進捗を手首でひと目で確認したり、丸型または長方形のコンプリケーションを追加したりできます。Apple Watchアプリとコンプリケーションは Plus に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손목에서 한눈에 상태, 남은 근무 시간, 진행률을 확인하거나 원형 또는 사각형 컴플리케이션을 추가하세요. Apple Watch 앱과 컴플리케이션은 Plus에 포함됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मनगटावरच एका नजरेत स्थिती, उरलेला कामाचा वेळ आणि प्रगती पाहा, किंवा गोल किंवा आयताकृती कॉम्प्लिकेशन जोडा. Apple Watch अॅप आणि कॉम्प्लिकेशन्स Plus चा भाग आहेत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o status, o tempo de trabalho restante e o progresso rapidamente no pulso, ou adicione uma complicação circular ou retangular. O app do Apple Watch e as complicações fazem parte do Plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите статус, оставшееся рабочее время и прогресс одним взглядом на запястье или добавьте круглое или прямоугольное расширение. Приложение Apple Watch и расширения входят в Plus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูสถานะ เวลาทำงานที่เหลือ และความคืบหน้าได้ในพริบตาที่ข้อมือ หรือเพิ่มกลไกหน้าปัดทรงกลมหรือทรงสี่เหลี่ยม แอป Apple Watch และกลไกหน้าปัดเป็นส่วนหนึ่งของ Plus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durumunuzu, kalan çalışma sürenizi ve ilerlemenizi bileğinizden bir bakışta görün veya yuvarlak ya da dikdörtgen bir komplikasyon ekleyin. Apple Watch uygulaması ve komplikasyonlar Plus’a dahildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trạng thái, thời gian làm việc còn lại và tiến độ trong nháy mắt ngay trên cổ tay, hoặc thêm một tổ hợp hình tròn hoặc hình chữ nhật. Ứng dụng Apple Watch và các tổ hợp là một phần của Plus."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "抬腕即可查看当前状态、剩余工作时间和进度，也可以添加圆形或矩形复杂功能。Watch App 和复杂功能包含在 Plus 中。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起手腕即可查看目前狀態、剩餘工作時間和進度，亦可以加入圓形或矩形複雜功能。Watch App 和複雜功能包含在 Plus 中。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起手腕即可查看目前狀態、剩餘工作時間和進度，也可以加入圓形或矩形複雜功能。Watch App 和複雜功能包含在 Plus 中。"
          }
        }
      }
    },

    "recordsAllocationBasis": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل {{count}} من تواريخ هذا الملخص، بما فيها العمل بعد منتصف الليل. النوم ووقت الفراغ تقديريان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfasst {{count}} Tage dieser Übersicht, einschließlich Arbeit über Mitternacht. Schlaf und Freizeit sind geschätzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers {{count}} dates in this summary, including overnight work. Sleep and free time are estimates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye {{count}} fechas de este resumen, incluido el trabajo después de medianoche. El sueño y el tiempo libre son estimaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvre {{count}} dates de ce bilan, travail après minuit compris. Le sommeil et le temps libre sont estimés."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सारांश की {{count}} तारीखें शामिल हैं, जिनमें आधी रात के बाद का काम भी है। नींद और खाली समय अनुमानित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencakup {{count}} tanggal dalam ringkasan ini, termasuk kerja lewat tengah malam. Tidur dan waktu luang adalah perkiraan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copre {{count}} date del riepilogo, incluso il lavoro oltre mezzanotte. Sonno e tempo libero sono stime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集計の {{count}} 日が対象です。日をまたぐ勤務を含み、睡眠と自由時間は推定値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요약의 {{count}}일을 포함하며 자정을 넘긴 근무도 반영합니다. 수면과 자유 시간은 추정치입니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या सारांशातील {{count}} तारखांचा समावेश आहे, मध्यरात्रीनंतरच्या कामासह. झोप आणि मोकळा वेळ अंदाजित आहेत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrange {{count}} datas deste resumo, incluindo trabalho após a meia-noite. Sono e tempo livre são estimativas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Охватывает {{count}} дат сводки, включая работу после полуночи. Сон и свободное время оценены приблизительно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครอบคลุม {{count}} วันที่ในสรุปนี้ รวมงานที่ข้ามเที่ยงคืน เวลานอนและเวลาว่างเป็นค่าประมาณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece yarısını aşan çalışma dahil bu özetteki {{count}} tarihi kapsar. Uyku ve boş zaman tahminidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao gồm {{count}} ngày trong tổng kết này, kể cả công việc qua nửa đêm. Giấc ngủ và thời gian rảnh là ước tính."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖 {{count}} 个统计日期，含跨夜延伸；睡眠与空闲为估算。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "涵蓋 {{count}} 個統計日期，包括跨夜延伸；睡眠與空閒為估算。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "涵蓋 {{count}} 個統計日期，含跨夜延伸；睡眠與空閒為估算。"
          }
        }
      }
    },

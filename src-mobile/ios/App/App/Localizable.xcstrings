    "firstRunReplaceConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد استبدال سجلات هذا الجهاز ببيانات iCloud؟ احتفظ بالنسخة الاحتياطية المصدّرة إذا أردت استعادة السجلات المحلية لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnungen auf diesem Gerät durch iCloud ersetzen? Bewahre die exportierte Sicherung auf, falls du lokale Aufzeichnungen später wiederherstellen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace this device’s records with iCloud? Keep the exported backup if you want to recover local records later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar los registros de este dispositivo con los de iCloud? Conserva la copia exportada por si quieres recuperar los registros locales más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer les enregistrements de cet appareil par ceux d’iCloud ? Conservez la sauvegarde exportée si vous souhaitez récupérer les enregistrements locaux plus tard."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या इस डिवाइस के रिकॉर्ड को iCloud से बदलना है? अगर बाद में स्थानीय रिकॉर्ड वापस चाहिए हों, तो एक्सपोर्ट किया हुआ बैकअप संभालकर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti catatan perangkat ini dengan iCloud? Simpan cadangan yang diekspor jika Anda ingin memulihkan catatan lokal nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire i registri di questo dispositivo con quelli di iCloud? Conserva il backup esportato se vorrai recuperare i registri locali in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの記録をiCloudのものに置き換えますか？後でローカルの記録を復元したい場合に備え、書き出したバックアップを保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 기록을 iCloud 기록으로 교체할까요? 나중에 로컬 기록을 복원하려면 내보낸 백업을 보관하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या उपकरणावरील नोंदी iCloud मधील नोंदींनी बदलायच्या का? नंतर स्थानिक नोंदी पुनर्प्राप्त करायच्या असल्यास निर्यात केलेला बॅकअप जपून ठेवा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os registros deste dispositivo pelos do iCloud? Guarde o backup exportado caso queira recuperar os registros locais depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить записи на этом устройстве данными из iCloud? Сохраните экспортированную резервную копию, если позже захотите восстановить локальные записи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อมูล iCloud แทนบันทึกของอุปกรณ์นี้หรือไม่ เก็บข้อมูลสำรองที่ส่งออกไว้ หากต้องการกู้คืนบันทึกในเครื่องภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki kayıtlar iCloud’dakilerle değiştirilsin mi? Yerel kayıtları daha sonra kurtarmak isterseniz dışa aktarılan yedeği saklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế các bản ghi của thiết bị này bằng iCloud? Hãy giữ bản sao lưu đã xuất nếu sau này bạn muốn khôi phục các bản ghi cục bộ."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iCloud 数据替换本机记录？请保留已导出的备份，之后可用它恢复本机记录。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以 iCloud 資料取代這部裝置的記錄？請保留已匯出的備份，日後若要還原本機記錄可以使用它。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以 iCloud 資料取代這台裝置的記錄？請保留已匯出的備份，日後若要還原本機記錄可以使用它。"
          }
        }
      }
    },

    "onboardingEverywhereBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع المرحلة الأخيرة من Dynamic Island والأدوات وشاشة القفل وApple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge die letzte Etappe über Dynamic Island, Widgets, Sperrbildschirm und Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the last stretch from Dynamic Island, widgets, the Lock Screen and Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el tramo final desde Dynamic Island, los widgets, la pantalla bloqueada y el Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez la dernière ligne droite depuis Dynamic Island, les widgets, l’écran verrouillé et l’Apple Watch."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island, विजेट, लॉक स्क्रीन और Apple Watch से आखिरी पड़ाव देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau bagian terakhir dari Dynamic Island, widget, Layar Terkunci, dan Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui l’ultimo tratto da Dynamic Island, widget, schermata di blocco e Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island、ウィジェット、ロック画面、Apple Watchで最後のひと踏ん張りを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island, 위젯, 잠금 화면, Apple Watch에서 남은 시간을 확인하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island, विजेट, लॉक स्क्रीन आणि Apple Watch वरून शेवटचा टप्पा पाहा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe a reta final pela Dynamic Island, widgets, tela bloqueada e Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за последним отрезком через Dynamic Island, виджеты, экран блокировки и Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามช่วงสุดท้ายจาก Dynamic Island วิดเจ็ต หน้าจอล็อก และ Apple Watch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bölümü Dynamic Island, araç takımları, Kilitli Ekran ve Apple Watch’tan izleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi chặng cuối từ Dynamic Island, tiện ích, Màn hình khóa và Apple Watch."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通过灵动岛、小组件、锁定屏幕和 Apple Watch 掌握最后一段时间。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "透過動態島、小工具、鎖定畫面和 Apple Watch 掌握最後一段時間。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "透過動態島、小工具、鎖定畫面和 Apple Watch 掌握最後一段時間。"
          }
        }
      }
    },

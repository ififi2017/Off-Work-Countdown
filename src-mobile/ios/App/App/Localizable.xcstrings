    "focusLockedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظّم أوقات التركيز والاستراحة بما يناسب ورديتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane konzentrierte Arbeit und Pausen passend zu deiner Schicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan focused work and breaks around your shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza el trabajo concentrado y los descansos según tu turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez vos tâches et vos pauses selon vos horaires de travail."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी शिफ़्ट के हिसाब से एकाग्र काम और ब्रेक की योजना बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencanakan waktu fokus dan istirahat sesuai sif Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica il lavoro concentrato e le pause in base al tuo turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務時間に合わせて、集中する時間と休憩を組み立てましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 일정에 맞춰 집중할 시간과 휴식을 계획하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या शिफ्टनुसार एकाग्र काम आणि विश्रांतीचे नियोजन करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje momentos de concentração e pausas de acordo com seu turno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планируйте сосредоточенную работу и перерывы с учётом своей смены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแผนช่วงทำงานอย่างมีสมาธิและช่วงพักให้เข้ากับกะของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanma ve mola zamanlarını vardiyanıza göre planlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp thời gian tập trung và nghỉ ngơi theo ca làm của bạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "把专注任务与休息安排进你的工作日。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把專注任務與休息安排到你的工作日。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "把專注任務與休息安排進你的工作日。"
          }
        }
      }

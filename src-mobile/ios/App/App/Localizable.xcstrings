    "extendedApplyTemplateMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُعاد تعبئة كل أيام الدورة وفق «{{pattern}}». لن يتغير شيء قبل الحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag des Zyklus wird nach „{{pattern}}“ neu gefüllt. Übernommen wird erst beim Sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day of the cycle is refilled from {{pattern}}. Nothing changes until you save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día del ciclo se rellenará según «{{pattern}}». No cambia nada hasta que guardes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour du cycle sera rempli à nouveau selon « {{pattern}} ». Rien ne change avant l’enregistrement."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "चक्र का हर दिन “{{pattern}}” के अनुसार फिर से भरा जाएगा। सहेजने तक कुछ नहीं बदलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hari dalam siklus akan diisi ulang berdasarkan “{{pattern}}”. Tidak ada yang berubah sebelum disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno del ciclo verrà ricompilato secondo «{{pattern}}». Non cambia nulla finché non salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周期のすべての日を「{{pattern}}」で入れ直します。保存するまでは反映されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기의 모든 날을 「{{pattern}}」 기준으로 다시 채웁니다. 저장해야 적용됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "चक्रातील प्रत्येक दिवस “{{pattern}}” नुसार पुन्हा भरला जाईल. जतन करेपर्यंत काहीही बदलणार नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia do ciclo será preenchido de novo segundo “{{pattern}}”. Nada muda até guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день цикла будет заполнен заново по шаблону «{{pattern}}». Изменения вступят в силу после сохранения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกวันในรอบจะถูกเติมใหม่ตาม “{{pattern}}” และจะยังไม่เปลี่ยนจนกว่าจะบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döngünün her günü “{{pattern}}” düzenine göre yeniden doldurulur. Kaydedene kadar hiçbir şey değişmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ngày trong chu kỳ sẽ được điền lại theo “{{pattern}}”. Chưa có gì thay đổi cho đến khi bạn lưu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "周期里的每一天会按「{{pattern}}」重新填写，保存后才会生效。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "週期入面每一日會按「{{pattern}}」重新填寫，儲存後先會生效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "週期裡的每一天會依「{{pattern}}」重新填寫，儲存後才會生效。"
          }
        }
      }
    },

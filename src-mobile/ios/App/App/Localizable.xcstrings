    "scheduleOffDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّر كل يوم. بلا عطلة مجدولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglich entscheiden. Kein festes Wochenende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide each day. No set weekend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide cada día. Sin fin de semana fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décidez chaque jour. Pas de week-end fixé."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन तय करें। तय सप्ताहांत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putuskan setiap hari. Tanpa akhir pekan tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi ogni giorno. Niente weekend fisso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日決める。決まった週末はない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 정합니다. 미리 짠 주말은 없습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दररोज ठरवा. ठरवलेला शनि-रविवार नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Decida cada dia. Sem fim de semana fixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решайте каждый день. Без заданных выходных."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดสินใจเองทุกวัน ไม่มีเสาร์อาทิตย์ตายตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

    "syncFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل المزامنة. أعد المحاولة بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync konnte nicht abgeschlossen werden. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync could not finish. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización no pudo terminar. Inténtalo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n’a pas abouti. Réessayez dans un instant."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक पूरा नहीं हो सका। थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",

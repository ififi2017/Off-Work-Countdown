    "recordsArchiveQuarantine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عزل الأرشيف التالف والبدء من جديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschädigtes Archiv isolieren und neu beginnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantine the damaged archive and start over"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aislar el archivo dañado y empezar de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isoler l’archive endommagée et recommencer"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "खराब आर्काइव अलग करें और फिर से शुरू करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisahkan arsip yang rusak dan mulai ulang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Isola l’archivio danneggiato e ricomincia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壊れたアーカイブを隔離してやり直す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손상된 보관 파일을 격리하고 다시 시작"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "खराब संग्रह बाजूला काढा आणि पुन्हा सुरू करा"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolar o arquivo danificado e recomeçar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изолировать повреждённый архив и начать заново"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกคลังที่เสียแล้วเริ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk arşivi ayır ve yeniden başla"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách ly kho lưu hỏng và bắt đầu lại"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "隔离损坏档案并重新开始"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "隔離損壞檔案並重新開始"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "隔離損壞檔案並重新開始"
          }
        }
      }
    },
    "recordsArchiveQuarantineConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يعيد السجلات القديمة. يُنحّى الملف التالف كنسخة .corrupt ويبدأ أرشيف جديد على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alten Einträge kommen damit nicht zurück. Die beschädigte Datei wird als .corrupt-Kopie beiseitegelegt, und auf diesem Gerät startet ein neues Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not bring the old records back. It moves the damaged file aside as a .corrupt copy and starts a fresh archive on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no recupera los registros antiguos. Mueve el archivo dañado a un lado como copia .corrupt y empieza un archivo nuevo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ramène pas les anciennes entrées. Le fichier endommagé est mis de côté en copie .corrupt, et une nouvelle archive commence sur cet appareil."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरानी रिकॉर्ड वापस नहीं आएँगी। खराब फ़ाइल .corrupt कॉपी के रूप में एक तरफ़ रखी जाएगी, और इस डिवाइस पर नई आर्काइव शुरू होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak mengembalikan catatan lama. Berkas yang rusak disisihkan sebagai salinan .corrupt, lalu arsip baru dimulai di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non riporta i record precedenti. Sposta il file danneggiato da parte come copia .corrupt e inizia un nuovo archivio su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い記録は戻りません。壊れたファイルを .corrupt 付きのコピーとして脇に移し、この端末で新しいアーカイブを始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 기록은 돌아오지 않습니다. 손상된 파일을 .corrupt 복사본으로 옆으로 옮기고, 이 기기에서 새 보관 파일을 시작합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जुन्या नोंदी परत येणार नाहीत. खराब फाइल .corrupt प्रत म्हणून बाजूला ठेवली जाईल, आणि या उपकरणावर नवीन संग्रह सुरू होईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não traz de volta os registos antigos. Move o ficheiro danificado para o lado como cópia .corrupt e começa um arquivo novo neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые записи не вернутся. Повреждённый файл будет отложен как копия .corrupt, и на этом устройстве начнётся новый архив."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำเช่นนี้จะไม่ดึงบันทึกเก่ากลับมา แต่จะย้ายไฟล์ที่เสียไปข้าง ๆ เป็นสำเนา .corrupt แล้วเริ่มคลังใหม่บนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski kayıtlar geri gelmez. Bozuk dosya .corrupt kopyası olarak kenara alınır ve bu cihazda yeni bir arşiv başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này không lấy lại bản ghi cũ. Tệp hỏng được để sang một bên thành bản .corrupt và máy này bắt đầu một kho lưu mới."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这不会恢复旧记录。它会把损坏文件挪到一边（文件名带 .corrupt），并在这台设备上开始一份新档案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個唔會恢復舊紀錄。會將損壞檔挪到一邊（檔名帶 .corrupt），再喺呢部裝置開始一份新檔案。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這不會還原舊紀錄。它會把損壞檔挪到一邊（檔名帶 .corrupt），並在這台裝置上開始一份新檔案。"
          }
        }
      }
    },
    "recordsArchiveSaveFailedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر تعديل ما زال على الشاشة لكنه لم يصل إلى الملف على هذا الجهاز. جرّب مرة أخرى بعد قليل — لم يُستبدل الأرشيف الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Änderung ist noch auf dem Bildschirm, hat die Datei auf diesem Gerät aber nicht erreicht. Versuch es gleich noch einmal — das vorhandene Archiv wurde nicht ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest change is on screen but did not reach the file on this device. Try again in a moment — the existing archive was not replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último cambio está en pantalla, pero no llegó al archivo de este dispositivo. Prueba de nuevo en un momento: el archivo existente no se ha sustituido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière modification est à l’écran mais n’a pas atteint le fichier sur cet appareil. Réessayez dans un instant — l’archive existante n’a pas été remplacée."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ताज़ा बदलाव स्क्रीन पर है, लेकिन इस डिवाइस की फ़ाइल तक नहीं पहुँचा। थोड़ी देर बाद फिर कोशिश करें — मौजूदा आर्काइव बदली नहीं गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan terbaru masih di layar, tetapi belum masuk ke berkas di perangkat ini. Coba lagi sebentar lagi — arsip yang ada tidak diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima modifica è ancora a schermo, ma non è arrivata al file su questo dispositivo. Riprova tra un attimo: l’archivio esistente non è stato sostituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の変更は画面に残っていますが、この端末のファイルには届いていません。少ししてからもう一度どうぞ。既存のアーカイブは置き換えていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 변경은 화면에 있지만 이 기기의 파일에는 반영되지 않았습니다. 잠시 후 다시 시도해 주세요. 기존 보관 파일은 바뀌지 않았습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन बदल पडद्यावर आहे, पण या उपकरणाच्या फाइलपर्यंत पोहोचला नाही. थोड्या वेळाने पुन्हा प्रयत्न करा — सध्याचा संग्रह बदललेला नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A última alteração está no ecrã, mas não chegou ao ficheiro neste dispositivo. Tenta outra vez daqui a pouco — o arquivo existente não foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее изменение видно на экране, но не попало в файл на этом устройстве. Попробуйте ещё раз чуть позже — текущий архив не заменён."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงล่าสุดยังอยู่บนหน้าจอ แต่ยังไม่ถึงไฟล์บนอุปกรณ์นี้ ลองอีกครั้งในอีกสักครู่ — คลังเดิมไม่ได้ถูกแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son değişiklik ekranda duruyor ama bu cihazdaki dosyaya ulaşmadı. Biraz sonra yeniden dene — mevcut arşiv değiştirilmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi mới nhất vẫn trên màn hình nhưng chưa vào tệp trên máy này. Thử lại sau một lát — kho lưu hiện có không bị thay thế."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "刚才的改动还在屏幕上，但没有写进这台设备上的文件。可以稍后再试一次——现有档案没有被替换。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啱先嘅改動仲喺畫面度，但未寫入呢部裝置上嘅檔案。可以遲啲再試——而家份檔案冇被取代。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "剛才的變更還在畫面上，但沒有寫進這台裝置上的檔案。可以稍後再試一次——現有檔案沒有被取代。"
          }
        }
      }
    },
    "recordsArchiveSaveFailedTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ السجلات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge konnten nicht gespeichert werden"
          }
        },
        "en": {

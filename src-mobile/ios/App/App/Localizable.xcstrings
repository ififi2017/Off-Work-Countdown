    "whatsNewSmartStackBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح للنشاط المباشر الخاص بالعدّ التنازلي تصميم مضغوط خاص به على Apple Watch، ويظل مجانيًا للجميع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Aktivität des Feierabend-Countdowns hat jetzt ihr eigenes kompaktes Layout auf der Apple Watch – und bleibt für alle kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The countdown Live Activity now has its own compact layout on Apple Watch, and it stays free for everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad en vivo de la cuenta atrás ahora tiene su propio diseño compacto en el Apple Watch, y sigue siendo gratis para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité en direct du compte à rebours a désormais sa propre mise en page compacte sur l’Apple Watch, et elle reste gratuite pour tout le monde."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "काउंटडाउन की लाइव ऐक्टिविटी को अब Apple Watch पर अपना खास कॉम्पैक्ट लेआउट मिल गया है, और यह सबके लिए मुफ़्त बनी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity hitung mundur kini punya tata letak ringkasnya sendiri di Apple Watch, dan tetap gratis untuk semua orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività in tempo reale del conto alla rovescia ha ora un suo layout compatto su Apple Watch, e resta gratuita per tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンのライブアクティビティに、Apple Watch専用のコンパクトなレイアウトが追加されました。これからも無料でご利用いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운 실시간 액티비티가 이제 Apple Watch에 맞는 컴팩트한 레이아웃을 갖췄고, 모두에게 계속 무료로 제공됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "काउंटडाउनच्या लाइव्ह ॲक्टिव्हिटीला आता Apple Watch वर स्वतःचा कॉम्पॅक्ट लेआउट मिळाला आहे, आणि तो सर्वांसाठी मोफतच राहतो."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Atividade ao Vivo da contagem regressiva agora tem seu próprio layout compacto no Apple Watch, e continua gratuita para todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-активность обратного отсчёта теперь получила отдельный компактный вид на Apple Watch и остаётся бесплатной для всех."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมสดของตัวนับถอยหลังตอนนี้มีเลย์เอาต์ขนาดกะทัดรัดเฉพาะบน Apple Watch แล้ว และยังคงใช้งานได้ฟรีสำหรับทุกคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayımın Canlı Etkinliği artık Apple Watch’ta kendi kompakt düzenine sahip ve herkes için ücretsiz kalmaya devam ediyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động trực tiếp của bộ đếm ngược giờ đây có bố cục gọn gàng riêng trên Apple Watch, và vẫn miễn phí cho tất cả mọi người."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "倒计时实时活动在 Apple Watch 上有了专属的紧凑样式，所有人都可以免费使用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "倒數即時動態在 Apple Watch 上有了專屬的精簡樣式，所有人都可以免費使用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "倒數即時動態在 Apple Watch 上有了專屬的精簡樣式，所有人都能免費使用。"
          }
        }
      }
    },

    "syncAccountChanged": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر حساب Apple، فتوقفت المزامنة مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Apple-Account hat sich geändert. Der Sync ist angehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple Account changed. Sync is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Apple ha cambiado. La sincronización está en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte Apple a changé. La synchronisation est en pause."

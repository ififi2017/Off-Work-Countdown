    "overtimeDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وقت انتهاء لاحقًا لهذه الوردية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein späteres Ende für diese Schicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a later finish time for this shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora de salida posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une heure de fin plus tardive."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शिफ्ट के लिए बाद का समाप्ति समय चुनें।"
          }
        },
        "id": {
          "stringUnit": {

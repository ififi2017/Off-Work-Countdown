    "focusTemplateSequenceNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُوزَّع المهام على الوردية بهذا الترتيب مع تجاوز الاستراحات. إذا لم يكفِ الوقت، تبقى المهام المتبقية محفوظة في القالب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben werden in dieser Reihenfolge unter Auslassung der Pausen eingeplant. Reicht die Zeit nicht, bleiben die übrigen Aufgaben in der Vorlage erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks fill the shift in this order, skipping breaks. If time runs out, the remaining tasks stay in the template for another day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas se programan en este orden, respetando los descansos. Si no hay tiempo suficiente, las tareas restantes se conservan en la plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches sont placées dans cet ordre, en évitant les pauses. Si le temps manque, les tâches restantes sont conservées dans le modèle."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य इसी क्रम में शिफ़्ट में लगाए जाते हैं और ब्रेक छोड़ दिए जाते हैं। समय कम पड़ने पर बाकी कार्य टेम्पलेट में सुरक्षित रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas mengisi sif sesuai urutan ini dengan melewati waktu istirahat. Jika waktunya tidak cukup, tugas yang tersisa tetap tersimpan di templat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività vengono inserite nel turno in questo ordine, saltando le pause. Se il tempo non basta, le attività rimanenti restano nel modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは休憩を避け、この順番でシフトに配置されます。時間が足りない場合、残りのタスクはテンプレートに保存されたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 시간을 제외하고 이 순서대로 근무 시간에 작업을 배치합니다. 시간이 부족하면 남은 작업은 템플릿에 그대로 보관됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्रांतीची वेळ वगळून कार्ये या क्रमाने शिफ्टमध्ये मांडली जातात. वेळ अपुरा पडल्यास उर्वरित कार्ये साच्यात जतन राहतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas são distribuídas pelo turno nesta ordem, respeitando as pausas. Se não houver tempo suficiente, as tarefas restantes ficam guardadas no modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи заполняют смену в этом порядке, пропуская перерывы. Если времени не хватит, оставшиеся задачи сохранятся в шаблоне."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานจะถูกจัดลงในกะตามลำดับนี้ โดยเว้นช่วงพัก หากเวลาไม่พอ งานที่เหลือจะยังคงอยู่ในแม่แบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevler molalar atlanarak bu sırayla vardiyaya yerleştirilir. Zaman yetmezse kalan görevler şablonda saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ được xếp vào ca theo thứ tự này, bỏ qua giờ nghỉ. Nếu không đủ thời gian, các nhiệm vụ còn lại vẫn được giữ trong mẫu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "任务按顺序填入当天班次，自动避开休息。时间不够时，尾部任务不安排到当天，模板仍完整保留。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任務依序填入當天班次，自動避開休息。時間不足時，尾端任務不安排到當天，範本仍完整保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "任務依序填入當天班次，自動避開休息。時間不足時，尾端任務不安排到當天，範本仍完整保留。"
          }
        }
      }
    },

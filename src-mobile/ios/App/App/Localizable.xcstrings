    "firstRunCloudEmpty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على بيانات DoneAt محفوظة في حساب iCloud هذا. يمكنك الآن إعداد جدولك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem iCloud-Account wurden keine gespeicherten DoneAt-Daten gefunden. Du kannst jetzt deinen Zeitplan einrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved DoneAt data was found in this iCloud account. You can now set up your schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron datos guardados de DoneAt en esta cuenta de iCloud. Ya puedes configurar tu horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée DoneAt enregistrée n’a été trouvée dans ce compte iCloud. Vous pouvez maintenant configurer votre planning."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iCloud खाते में कोई सहेजा हुआ DoneAt डेटा नहीं मिला। अब आप अपना शेड्यूल सेट कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada data DoneAt tersimpan yang ditemukan di akun iCloud ini. Kini Anda dapat menyiapkan jadwal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono stati trovati dati DoneAt salvati in questo account iCloud. Ora puoi configurare il tuo programma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiCloudアカウントには保存済みのDoneAtデータがありません。勤務予定を設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iCloud 계정에서 저장된 DoneAt 데이터를 찾지 못했습니다. 이제 일정을 설정할 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या iCloud खात्यात जतन केलेला DoneAt डेटा सापडला नाही. आता तुम्ही तुमचे वेळापत्रक सेट करू शकता."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontrados dados salvos do DoneAt nesta conta do iCloud. Agora você pode configurar sua jornada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой учётной записи iCloud не найдено сохранённых данных DoneAt. Теперь можно настроить расписание."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อมูล DoneAt ที่บันทึกไว้ในบัญชี iCloud นี้ ตอนนี้คุณตั้งค่าตารางเวลาได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iCloud hesabında kaydedilmiş DoneAt verisi bulunamadı. Artık çalışma düzeninizi ayarlayabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy dữ liệu DoneAt đã lưu trong tài khoản iCloud này. Bây giờ bạn có thể thiết lập lịch làm việc."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 iCloud 账户中没有找到已保存的 DoneAt 数据，可以开始配置排班了。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 iCloud 帳戶中沒有找到已儲存的 DoneAt 資料，現在可以開始設定工作時間。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 iCloud 帳號中沒有找到已儲存的 DoneAt 資料，現在可以開始設定班表。"
          }
        }
      }
    },
    "firstRunCloudNeedsSetup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة سجلاتك، لكننا لم نعثر على إعدادات جدول محفوظة. يمكنك إكمال إعداد هذا الجهاز دون فقدان ما تمت استعادته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufzeichnungen sind wieder da. Gespeicherte Zeitplaneinstellungen wurden nicht gefunden. Du kannst dieses Gerät jetzt fertig einrichten; die wiederhergestellten Daten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records are back. We did not find saved schedule settings, so you can finish setting up this device without losing what was restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros ya están restaurados. No encontramos un horario guardado, así que puedes terminar de configurar este dispositivo sin perder lo restaurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont restaurées. Aucun planning enregistré n’a été trouvé. Vous pouvez terminer la configuration de cet appareil sans perdre les données restaurées."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रिकॉर्ड वापस आ गए हैं, लेकिन सहेजी हुई शेड्यूल सेटिंग नहीं मिली। बहाल किए गए डेटा को खोए बिना इस डिवाइस का सेटअप पूरा किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Anda sudah dipulihkan, tetapi pengaturan jadwal tersimpan tidak ditemukan. Anda dapat menyelesaikan penyiapan perangkat ini tanpa kehilangan data yang dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono stati ripristinati, ma non abbiamo trovato impostazioni di pianificazione salvate. Puoi completare la configurazione di questo dispositivo senza perdere i dati ripristinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を復元しましたが、保存済みの勤務予定は見つかりませんでした。復元した内容を残したまま、このデバイスの設定を完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 복원되었지만 저장된 일정 설정을 찾지 못했습니다. 복원된 내용을 그대로 유지하면서 이 기기 설정을 마칠 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या नोंदी पुनर्स्थापित झाल्या, पण जतन केलेली वेळापत्रक सेटिंग सापडली नाही. पुनर्स्थापित केलेला डेटा न गमावता या उपकरणाचे सेटअप पूर्ण करता येईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus registros foram restaurados, mas não encontramos uma jornada salva. Você pode concluir a configuração deste dispositivo sem perder o que foi restaurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи восстановлены, но сохранённые настройки расписания не найдены. Можно завершить настройку этого устройства — восстановленные данные останутся на месте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนบันทึกของคุณแล้ว แต่ไม่พบการตั้งค่าตารางเวลาที่บันทึกไว้ คุณตั้งค่าอุปกรณ์นี้ต่อได้โดยข้อมูลที่กู้คืนไว้จะไม่สูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınız geri yüklendi ancak kaydedilmiş çalışma düzeni ayarları bulunamadı. Geri yüklenenleri kaybetmeden bu cihazın kurulumunu tamamlayabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của bạn đã được khôi phục, nhưng không tìm thấy lịch làm việc đã lưu. Bạn có thể hoàn tất thiết lập thiết bị này mà không mất nội dung vừa khôi phục."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已经恢复，但没有找到已保存的排班设置。你可以继续配置这台设备，刚刚恢复的内容都会保留。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄已經還原，但沒有找到已儲存的工作時間設定。你可以繼續設定這部裝置，剛剛還原的內容都會保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄已經回復，但沒有找到已儲存的班表設定。你可以繼續設定這台裝置，剛剛回復的內容都會保留。"
          }
        }
      }
    },
    "firstRunCloudRestoring": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ استعادة إعداداتك وسجلاتك. سيُطبق إعدادك بعد التحقق من اكتمال التنزيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen und Aufzeichnungen werden wiederhergestellt. Nach der vollständigen Prüfung des Downloads wird deine Einrichtung angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring your settings and records. Your setup will be applied after the full download is checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurando tus ajustes y registros. La configuración se aplicará después de comprobar la descarga completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauration de vos réglages et enregistrements. Votre configuration sera appliquée une fois le téléchargement complet vérifié."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सेटिंग और रिकॉर्ड वापस लाए जा रहे हैं। पूरा डाउनलोड जाँचने के बाद आपका सेटअप लागू किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan pengaturan dan catatan Anda. Pengaturan akan diterapkan setelah unduhan lengkap diperiksa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo ripristinando impostazioni e registri. La configurazione verrà applicata dopo la verifica del download completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定と記録を復元しています。ダウンロード全体の確認後、このデバイスに設定が反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정과 기록을 복원하고 있습니다. 전체 다운로드를 확인한 뒤 이 기기에 설정이 적용됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या सेटिंग्ज आणि नोंदी पुनर्संचयित करत आहोत. पूर्ण डाउनलोड तपासल्यानंतर तुमचे सेटअप लागू केले जाईल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurando seus ajustes e registros. Sua configuração será aplicada depois que o download completo for verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливаем настройки и записи. Настройка будет применена после проверки полной загрузки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังกู้คืนการตั้งค่าและบันทึก การตั้งค่าของคุณจะถูกนำไปใช้หลังจากตรวจสอบการดาวน์โหลดทั้งหมดแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız ve kayıtlarınız geri yükleniyor. Tam indirme kontrol edildikten sonra kurulumunuz uygulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang khôi phục cài đặt và bản ghi. Thiết lập của bạn sẽ được áp dụng sau khi kiểm tra xong toàn bộ bản tải xuống."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在恢复设置和记录。完整下载并检查后，将一次性应用到这台设备。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在還原設定和記錄。完整下載並檢查後，會一次套用到這部裝置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "正在還原設定和記錄。完整下載並檢查後，會一次套用到這台裝置。"
          }
        }
      }
    },
    "firstRunCloudUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من iCloud. تحقق من اتصالك وتسجيل الدخول إلى iCloud، ثم حاول مرة أخرى. يمكنك أيضًا الإعداد دون اتصال؛ ستبقى إعداداتك على هذا الجهاز إلى أن تختار كيفية ربطها بـ iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud konnte nicht geprüft werden. Prüfe deine Verbindung und die iCloud-Anmeldung und versuche es erneut. Du kannst auch offline einrichten; deine Einstellungen bleiben auf diesem Gerät, bis du entscheidest, wie du sie mit iCloud verbindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not check iCloud. Check your connection and iCloud sign-in, then try again. You can also set up offline; your settings will stay on this device until you choose how to connect them to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos comprobar iCloud. Revisa tu conexión e inicio de sesión de iCloud y vuelve a intentarlo. También puedes configurar sin conexión; tus ajustes se quedarán en este dispositivo hasta que elijas cómo conectarlos con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier iCloud. Vérifiez votre connexion et votre session iCloud, puis réessayez. Vous pouvez aussi configurer l’app hors ligne ; vos réglages resteront sur cet appareil jusqu’à ce que vous choisissiez comment les connecter à iCloud."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud की जाँच नहीं हो सकी। अपना कनेक्शन और iCloud साइन-इन जाँचें, फिर दोबारा कोशिश करें। आप ऑफ़लाइन भी सेट कर सकते हैं; आपकी सेटिंग इस डिवाइस पर रहेगी, जब तक आप उसे iCloud से जोड़ने का तरीका नहीं चुनते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat memeriksa iCloud. Periksa koneksi dan masuk iCloud Anda, lalu coba lagi. Anda juga dapat menyiapkan secara offline; pengaturan akan tetap di perangkat ini sampai Anda memilih cara menghubungkannya ke iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a controllare iCloud. Verifica la connessione e l’accesso a iCloud, poi riprova. Puoi anche configurare offline; le impostazioni resteranno su questo dispositivo finché non scegli come collegarle a iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudを確認できませんでした。接続とiCloudへのサインインを確認して、もう一度お試しください。オフラインで設定することもできます。その場合、iCloudへのつなぎ方を選ぶまで設定はこのデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 확인할 수 없습니다. 연결과 iCloud 로그인 상태를 확인한 뒤 다시 시도하세요. 오프라인으로 설정할 수도 있으며, iCloud에 연결하는 방법을 선택할 때까지 설정은 이 기기에 남아 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud तपासता आले नाही. तुमचे कनेक्शन आणि iCloud साइन-इन तपासून पुन्हा प्रयत्न करा. तुम्ही ऑफलाइनही सेट करू शकता; iCloud शी जोडण्याची पद्धत निवडेपर्यंत तुमच्या सेटिंग्ज या उपकरणावरच राहतील."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o iCloud. Confira sua conexão e sessão do iCloud, depois tente novamente. Você também pode configurar offline; seus ajustes ficarão neste dispositivo até escolher como conectá-los ao iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить iCloud. Проверьте подключение и вход в iCloud, затем попробуйте снова. Можно настроить приложение и без сети; настройки останутся на этом устройстве, пока вы не решите, как подключить их к iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราไม่สามารถตรวจสอบ iCloud ได้ โปรดตรวจสอบการเชื่อมต่อและการลงชื่อเข้าใช้ iCloud แล้วลองอีกครั้ง คุณยังตั้งค่าแบบออฟไลน์ได้ การตั้งค่าจะอยู่ในอุปกรณ์นี้จนกว่าคุณจะเลือกวิธีเชื่อมต่อกับ iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud’u kontrol edemedik. Bağlantınızı ve iCloud girişinizi kontrol edip tekrar deneyin. Çevrimdışı da ayarlayabilirsiniz; ayarlarınız, onları iCloud’a nasıl bağlayacağınızı seçene kadar bu cihazda kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kiểm tra iCloud. Hãy kiểm tra kết nối và đăng nhập iCloud, rồi thử lại. Bạn cũng có thể thiết lập ngoại tuyến; cài đặt sẽ ở lại trên thiết bị này cho đến khi bạn chọn cách kết nối chúng với iCloud."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法检查 iCloud。请检查网络及 iCloud 登录状态后重试。也可以先离线配置；设置会保留在本机，之后由你选择如何与 iCloud 连接。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法檢查 iCloud。請檢查網絡和 iCloud 登入狀態後再試。也可以先離線設定；設定會留在這部裝置上，之後再由你決定如何連接到 iCloud。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法檢查 iCloud。請確認網路和 iCloud 登入狀態後再試。也可以先離線設定；設定會留在這台裝置上，之後再由你決定如何連接到 iCloud。"
          }
        }
      }
    },

            "value": "喺 iPhone 上嘅 Watch App 或者 Apple Watch 上嘅 App Store 安裝 DoneAt。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Watch App 或 Apple Watch 上的 App Store 中安裝 DoneAt。"
          }
        }
      }
    },

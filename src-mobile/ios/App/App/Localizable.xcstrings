            "value": "Limpar tarefas deste dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить задачи этого дня"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างงานของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün görevlerini temizle"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa công việc của ngày này"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清空此天任务"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "清空此日任務"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "清空此日任務"
          }
        }
      }
    },
    "focusClearDayTasksBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة مهام هذا اليوم وجدوله وإيقاف مؤقته الجاري. ستبقى سجلات التركيز المكتملة محفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben und Planung dieses Tages löschen und den laufenden Timer stoppen. Abgeschlossene Fokusaufzeichnungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this day’s tasks and plan, and stop its running timer. Completed focus records will be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las tareas y la planificación de este día y detiene su temporizador activo. Se conservan los registros de concentración completados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les tâches et le planning de ce jour et arrête son minuteur en cours. Les sessions de concentration terminées sont conservées."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन के कार्य और योजना हटाएँ और चल रहा टाइमर रोकें। पूरे किए गए फ़ोकस रिकॉर्ड बने रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus tugas dan jadwal hari ini serta hentikan timer yang sedang berjalan. Catatan fokus yang selesai tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove le attività e il programma del giorno e arresta il timer in corso. I registri di concentrazione completati vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日のタスクと予定を削除し、実行中のタイマーを停止します。完了した集中の記録は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜의 작업과 일정을 지우고 실행 중인 타이머를 중지합니다. 완료한 집중 기록은 유지됩니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या दिवसाची कार्ये आणि नियोजन हटवा व सुरू असलेला टाइमर थांबवा. पूर्ण झालेले फोकस रेकॉर्ड जतन केले जातील."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove as tarefas e o plano deste dia e para o temporizador em curso. Os registos de foco concluídos serão mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить задачи и план этого дня и остановить текущий таймер. Завершённые записи о фокусировке сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบงานและตารางของวันนี้ แล้วหยุดตัวจับเวลาที่กำลังทำงาน บันทึกการโฟกัสที่เสร็จแล้วจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün görevlerini ve planını kaldırır, çalışan zamanlayıcısını durdurur. Tamamlanan odak kayıtları korunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa công việc và lịch của ngày này, đồng thời dừng bộ hẹn giờ đang chạy. Các bản ghi tập trung đã hoàn thành sẽ được giữ lại."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将清空此天的任务和安排，并停止本日正在运行的计时。已完成的专注记录会保留。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將清空此日的任務與安排，並停止當日正在進行的計時。已完成的專注記錄會保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將清空此日的任務與安排，並停止當日正在執行的計時。已完成的專注紀錄會保留。"
          }
        }
      }
    },

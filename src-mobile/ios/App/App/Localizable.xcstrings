    "lifeProfileFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الأرقام هي ما يرسم الشبكة. وتبقى على هذا الجهاز ما لم تُشغّل مزامنة iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus diesen Zahlen entsteht das Raster. Sie bleiben auf diesem Gerät, solange du den iCloud-Sync nicht einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These numbers draw the grid. They stay on this device unless you turn on iCloud sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estos números se dibuja la cuadrícula. Se quedan en este dispositivo mientras no actives la sincronización con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces chiffres dessinent la grille. Ils restent sur cet appareil tant que vous n’activez pas la synchronisation iCloud."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "इन आँकड़ों से नीचे का ग्रिड बनता है। जब तक आप iCloud सिंक चालू न करें, ये इसी डिवाइस पर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka-angka ini yang menggambar kisinya. Semuanya tetap di perangkat ini kecuali kamu menyalakan sinkronisasi iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da questi numeri nasce la griglia. Restano su questo dispositivo finché non attivi la sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この数字からグリッドを描いています。iCloud 同期を入れないかぎり、この端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 숫자들로 아래 격자를 그립니다. iCloud 동기화를 켜지 않으면 이 기기에만 남습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या आकड्यांवरून खालची जाळी तयार होते. तुम्ही iCloud सिंक सुरू करेपर्यंत ते या डिव्हाइसवरच राहतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes números desenham a grelha. Ficam neste dispositivo enquanto não ativar a sincronização com o iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этим числам рисуется сетка. Они остаются на этом устройстве, пока вы не включите синхронизацию с iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขเหล่านี้ใช้วาดตาราง ข้อมูลจะอยู่ในเครื่องนี้ตราบใดที่คุณไม่เปิดการซิงก์ iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgarayı bu sayılar çiziyor. iCloud eşitlemeyi açmadığın sürece bu cihazda kalırlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những con số này vẽ nên lưới bên dưới. Chúng nằm trên thiết bị này trừ khi bạn bật đồng bộ iCloud."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这几个数字用来画出下面的网格。除非你开启 iCloud 同步，它们只留在这台设备上。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢幾個數字用嚟畫下面嘅格。除非你開 iCloud 同步，佢哋只留喺呢部裝置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這幾個數字用來畫出下面的格線。除非你開啟 iCloud 同步，它們只留在這台裝置上。"
          }
        }
      }
    },

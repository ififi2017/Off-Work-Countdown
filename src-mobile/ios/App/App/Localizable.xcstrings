    "onboardingPlusRecordsBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Plus سجلك الكامل، ثم يستخدم ملف تعريف الحياة لوضع العمل في منظوره الصحيح منذ وظيفتك الأولى حتى التقاعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus öffnet Ihre vollständige Akte und verwendet dann ein Lebensprofil, um die Arbeit von Ihrem ersten Job bis zur Pensionierung ins rechte Licht zu rücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus opens your full record, then uses a life profile to put work in perspective from your first job to retirement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus abre su registro completo y luego utiliza un perfil de vida para poner el trabajo en perspectiva desde su primer empleo hasta su jubilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ouvre votre dossier complet, puis utilise un profil de vie pour mettre le travail en perspective depuis votre premier emploi jusqu'à la retraite."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लस आपका पूरा रिकॉर्ड खोलता है, फिर आपकी पहली नौकरी से सेवानिवृत्ति तक के परिप्रेक्ष्य में काम को रखने के लिए एक जीवन प्रोफ़ाइल का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus membuka catatan lengkap Anda, lalu menggunakan profil kehidupan untuk menempatkan pekerjaan dalam perspektif dari pekerjaan pertama Anda hingga pensiun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus apre il tuo record completo, quindi utilizza un profilo di vita per mettere il lavoro in prospettiva dal tuo primo lavoro alla pensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus は完全な記録を開き、人生プロフィールを使用して、最初の仕事から退職までの仕事を大局的に捉えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러스는 전체 기록을 연 다음 인생 프로필을 사용하여 첫 직장부터 은퇴까지의 일을 관점에서 살펴봅니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लस तुमचे संपूर्ण रेकॉर्ड उघडते, नंतर तुमच्या पहिल्या नोकरीपासून ते सेवानिवृत्तीपर्यंत कामाचा दृष्टीकोन ठेवण्यासाठी जीवन प्रोफाइल वापरते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus abre seu registro completo e, em seguida, usa um perfil de vida para colocar o trabalho em perspectiva, desde seu primeiro emprego até a aposentadoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плюс открывает вашу полную запись, а затем использует жизненный профиль, чтобы оценить работу от вашей первой работы до выхода на пенсию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus เปิดบันทึกทั้งหมดของคุณ จากนั้นใช้โปรไฟล์ชีวิตเพื่อนำเสนองานในมุมมองตั้งแต่งานแรกจนถึงวัยเกษียณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tüm kayıtlarınızı açar, ardından ilk işinizden emekliliğinize kadar olan süreci bir perspektife oturtmak için bir yaşam profili kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus mở hồ sơ đầy đủ của bạn, sau đó sử dụng hồ sơ cuộc sống để xem xét công việc từ công việc đầu tiên của bạn cho đến khi nghỉ hưu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 会打开完整记录，再用人生档案把工作放进从入职到退休的长期尺度里。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 會打開你嘅全部記錄，然後用人生簡介去將你由第一份工到退休嘅工作放入透視角度。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 開啟您的完整記錄，然後使用生活檔案來正確看待從您的第一份工作到退休的工作。"
          }
        }
      }
    },
    "onboardingPlusRecordsTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد اليوم الذي خططت له، والذي عشته"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich den Tag an, den Sie geplant haben – und den Tag, an dem Sie gelebt haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the day you planned — and the one you lived"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el día que planeaste y el que viviste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez le jour que vous avez prévu – et celui que vous avez vécu"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "वह दिन देखें जिसकी आपने योजना बनाई थी - और जिसे आपने जीया था"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat hari yang Anda rencanakan - dan hari yang Anda jalani"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda il giorno che hai pianificato e quello che hai vissuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが計画した日、そしてあなたが生きた日を見てください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획한 하루와 살았던 하루를 확인하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नियोजित केलेला दिवस पहा — आणि तुम्ही जगलात"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o dia que você planejou — e aquele que você viveu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увидеть день, который ты запланировал — и тот, который ты прожил"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูวันที่คุณวางแผนไว้ และวันที่คุณมีชีวิตอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planladığınız ve yaşadığınız günü görün"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem ngày bạn đã lên kế hoạch - và ngày bạn đã sống"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "看清计划的一天，也看清实际的一天"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "睇下你計劃嘅日子 — 同埋你過嘅日子"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你計畫的那一天──以及你生活的那一天"
          }
        }
      }
    },
    "onboardingPrivacyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب. العد التنازلي والسجلات تبقى على هذا الجهاز، إلا إذا فتحت الخطط أو شغّلت مزامنة iCloud. ولا تصل بيانات العمل والراتب إلى المطوّر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto. Countdown und Aufzeichnungen bleiben auf diesem Gerät, sofern du nicht selbst Tarife lädst oder den iCloud-Sync einschaltest. Arbeits- und Gehaltsdaten gehen nie an den Entwickler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. The countdown and your records stay on this device unless you choose to load purchases or turn on iCloud sync. Work and salary data are never sent to the developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuentas. La cuenta atrás y los registros se quedan en este dispositivo, salvo que tú mires los planes o actives la sincronización con iCloud. Tus horas y tu sueldo nunca llegan al desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte. Le compte à rebours et les relevés restent sur cet appareil, sauf si vous consultez les offres ou activez la synchronisation iCloud. Vos horaires et votre salaire ne partent jamais chez le développeur."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई खाता नहीं। जब तक आप ख़ुद प्लान न देखें या iCloud सिंक चालू न करें, काउंटडाउन और रिकॉर्ड इसी डिवाइस पर रहते हैं। काम और वेतन का डेटा डेवलपर तक कभी नहीं पहुँचता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun. Hitungan pulang dan catatan tetap di perangkat ini, kecuali kamu membuka paket atau menyalakan sinkronisasi iCloud. Data kerja dan gaji tidak pernah sampai ke pengembang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account. Conto alla rovescia e registri restano su questo dispositivo, a meno che tu guardi i piani o attivi la sincronizzazione iCloud. Orari e stipendio non arrivano mai allo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。自分でプランを見るか iCloud 同期を入れないかぎり、カウントダウンと記録はこの端末に残ります。勤務や給与のデータが開発者に届くことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요 없습니다. 직접 요금제를 보거나 iCloud 동기화를 켜지 않는다면 카운트다운과 기록은 이 기기에 남습니다. 근무와 급여 데이터는 개발자에게 가지 않습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते नको. तुम्ही स्वतः योजना पाहिल्याशिवाय किंवा iCloud सिंक सुरू केल्याशिवाय काउंटडाउन आणि नोंदी या डिव्हाइसवरच राहतात. कामाचा आणि पगाराचा डेटा डेव्हलपरपर्यंत कधीही पोहोचत नाही."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem contas. A contagem decrescente e os registos ficam neste dispositivo, a não ser que veja os planos ou ative a sincronização com o iCloud. As horas e o salário nunca chegam ao desenvolvedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт не нужен. Обратный отсчёт и записи остаются на этом устройстве, пока вы сами не откроете тарифы или не включите синхронизацию с iCloud. Данные о работе и зарплате разработчику не уходят."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี การนับถอยหลังและบันทึกอยู่ในเครื่องนี้ เว้นแต่คุณจะเปิดดูแผนหรือเปิดการซิงก์ iCloud เอง ข้อมูลงานและเงินเดือนไม่เคยไปถึงผู้พัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap gerekmez. Sen planlara bakmadıkça ya da iCloud eşitlemeyi açmadıkça geri sayım ve kayıtlar bu cihazda kalır. Çalışma ve maaş verileri geliştiriciye gitmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Đếm ngược và bản ghi nằm trên thiết bị này, trừ khi bạn tự xem các gói hoặc bật đồng bộ iCloud. Dữ liệu công việc và lương không bao giờ đến nhà phát triển."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "不用账号。倒计时和记录都在这台设备上，除非你自己去查看方案或开启 iCloud 同步。工作和薪资数据不会发给开发者。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "唔使帳戶。倒數計時同紀錄都喺呢部裝置，除非你自己去睇方案或者開 iCloud 同步。工作同薪金資料唔會傳去開發者。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "不用帳號。倒數計時和紀錄都在這台裝置上，除非你自己去查看方案或開啟 iCloud 同步。工作和薪資資料不會傳給開發者。"
          }
        }
      }
    },
    "onboardingPrivacyTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى على هذا الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt auf diesem Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays on this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur cet appareil"
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा इसी डिवाइस पर रहता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap di perangkat ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはこのデバイス内に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 이 기기에만"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा या डिव्हाइसवर राहतो"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica neste dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные остаются на устройстве"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลอยู่บนเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler bu cihazda kalır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở lại trên thiết bị này"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "数据留在这台设备上"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "資料留喺呢部裝置"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "資料留在這台裝置上"
          }
        }
      }
    },
    "onboardingPrivacyWorkBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الساعات والرواتب والسجلات والإعدادات على هذا الجهاز بشكل افتراضي. قم بتشغيل مزامنة iCloud لإبقائهم معًا عبر أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunden, Gehalt, Aufzeichnungen und Einstellungen bleiben standardmäßig auf diesem Gerät. Aktivieren Sie die iCloud-Synchronisierung, um sie auf Ihren Geräten zusammenzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hours, salary, records and settings stay on this device by default. Turn on iCloud sync to keep them together across your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas, el salario, los registros y la configuración permanecen en este dispositivo de forma predeterminada. Active la sincronización de iCloud para mantenerlos juntos en todos sus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures, le salaire, les enregistrements et les paramètres restent sur cet appareil par défaut. Activez la synchronisation iCloud pour les conserver ensemble sur vos appareils."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "घंटे, वेतन, रिकॉर्ड और सेटिंग्स डिफ़ॉल्ट रूप से इस डिवाइस पर रहती हैं। उन्हें अपने डिवाइस पर एक साथ रखने के लिए iCloud सिंक चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam kerja, gaji, catatan, dan pengaturan tetap ada di perangkat ini secara default. Aktifkan sinkronisasi iCloud untuk menyatukannya di seluruh perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orari, stipendio, record e impostazioni rimangono su questo dispositivo per impostazione predefinita. Attiva la sincronizzazione iCloud per tenerli insieme su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間、給与、記録、設定はデフォルトでこのデバイスに残ります。 iCloud 同期をオンにして、デバイス間で同期を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무 시간, 급여, 기록 및 설정은 기본적으로 이 장치에 유지됩니다. iCloud 동기화를 켜서 여러 기기에서 함께 보관하세요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "डीफॉल्टनुसार तास, पगार, रेकॉर्ड आणि सेटिंग्ज या डिव्हाइसवर राहतात. त्यांना तुमच्या डिव्हाइसवर एकत्र ठेवण्यासाठी iCloud सिंक चालू करा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horário, salário, registros e configurações permanecem neste dispositivo por padrão. Ative a sincronização do iCloud para mantê-los juntos em todos os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы, зарплата, записи и настройки по умолчанию остаются на этом устройстве. Включите синхронизацию iCloud, чтобы хранить их вместе на всех ваших устройствах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชั่วโมง เงินเดือน บันทึก และการตั้งค่าจะยังคงอยู่ในอุปกรณ์นี้ตามค่าเริ่มต้น เปิดการซิงค์ iCloud เพื่อรวมไว้ด้วยกันในอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma saatleri, maaş, kayıtlar ve ayarlar varsayılan olarak bu cihazda kalır. Bunları aygıtlarınızda bir arada tutmak için iCloud senkronizasyonunu açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo mặc định, giờ, lương, hồ sơ và cài đặt vẫn được lưu trên thiết bị này. Bật đồng bộ hóa iCloud để giữ chúng cùng nhau trên các thiết bị của bạn."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "工时、薪资、记录和设置默认保存在本机。开启 iCloud 同步，可在你的设备间保持一致。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "工時、人工、記錄同設定預設會保留喺呢部裝置上面。開啟 iCloud 同步功能，將佢哋喺你嘅裝置上面保持一致。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "工時、工資、記錄和設定預設保留在該設備上。開啟 iCloud 同步，使它們在您的裝置上保持在一起。"
          }
        }
      }
    },
    "onboardingRemindersBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستراحة توقف العد التنازلي. التنبيهات تصلك دون إبقاء التطبيق مفتوحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pause hält den Countdown an. Erinnerungen kommen von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch pauses the countdown. Reminders reach you without keeping the app open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almuerzo pausa la cuenta atrás. Los avisos llegan sin tener la app abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pause arrête le compte à rebours. Les rappels arrivent tout seuls."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लंच काउंटडाउन रोक देता है। रिमाइंडर खुद आ जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Istirahat menjeda hitungan mundur. Pengingat datang sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pausa ferma il conto alla rovescia. Gli avvisi arrivano da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩中はカウントダウンが止まります。時間になればお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점심시간에는 카운트다운이 멈춰요. 시간이 되면 알려 드려요."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "लंच उलटगणती थांबवते. रिमाइंडर आपोआप येतात."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O almoço pausa a contagem. Os lembretes chegam sem manter o app aberto."
          }
        },

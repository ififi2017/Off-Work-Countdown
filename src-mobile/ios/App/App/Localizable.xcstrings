        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운을 시작하려면 점심시간 전체가 근무시간 안에 있어야 합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "उलटी गणना सुरू करण्यापूर्वी जेवणाची सुट्टी पूर्णपणे कामाच्या वेळेत असावी."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo de almoço precisa estar totalmente dentro do expediente para iniciar a contagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы запустить отсчёт, обеденный перерыв должен полностью находиться внутри смены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาพักกลางวันต้องอยู่ภายในเวลางานทั้งหมดก่อนเริ่มนับถอยหลัง"

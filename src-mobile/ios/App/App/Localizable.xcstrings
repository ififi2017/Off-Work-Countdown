    "onboardingShiftBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم الأسابيع المتناوبة ودورات العمل والراحة والورديات الليلية واستراحات الغداء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselwochen, Arbeits-/Freizeit-Rhythmen, Nachtschichten und Mittagspausen werden unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternating weeks, work/rest rotations, overnight shifts, and lunch breaks are all supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Admite semanas alternas, rotaciones de trabajo y descanso, turnos nocturnos y pausas para comer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semaines alternées, rotations travail/repos, postes de nuit et pauses déjeuner sont pris en charge."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलते सप्ताह, काम/आराम चक्र, रात की शिफ़्ट और लंच ब्रेक सभी समर्थित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendukung minggu bergantian, rotasi kerja/istirahat, shift malam, dan istirahat makan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono supportati settimane alterne, cicli lavoro/riposo, turni notturni e pause pranzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隔週勤務、勤務・休日ローテーション、日をまたぐシフト、昼休みに対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격주 근무, 근무·휴무 순환, 야간 근무와 점심시간을 모두 지원합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "आलटून-पालटून आठवडे, काम/विश्रांती चक्र, रात्रपाळी आणि जेवणाची सुट्टी समर्थित आहेत."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Semanas alternadas, ciclos de trabalho e descanso, turnos noturnos e intervalos de almoço são compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаются чередующиеся недели, циклы работы и отдыха, ночные смены и обеденные перерывы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับสัปดาห์สลับ รอบทำงาน/พัก กะข้ามคืน และพักกลางวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüşümlü haftalar, çalışma/dinlenme döngüleri, gece vardiyaları ve öğle araları desteklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ tuần xen kẽ, chu kỳ làm/nghỉ, ca qua đêm và giờ nghỉ trưa."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "大小周、轮班轮休、跨夜班次和午休都支持。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "大小周、輪班輪休、通宵班同午飯時間都支援。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "大小週、輪班輪休、跨夜班次和午休都支援。"
          }
        }
      }
    },

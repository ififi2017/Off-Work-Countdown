    "onboardingPlusLifeBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف التواريخ التي تعرفها. DoneAt يفصل بين الوقت المعيش والمتوقع دون تحويل التقديرات إلى تاريخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie die Ihnen bekannten Daten hinzu. DoneAt trennt erlebte und prognostizierte Zeit, ohne Schätzungen in Geschichte umzuwandeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the dates you know. DoneAt separates lived and projected time without turning estimates into history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las fechas que conoces. DoneAt separa el tiempo vivido y proyectado sin convertir las estimaciones en historia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les dates que vous connaissez. DoneAt sépare le temps vécu et projeté sans transformer les estimations en historique."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "वे तारीखें जोड़ें जिन्हें आप जानते हैं। DoneAt अनुमानों को इतिहास में बदले बिना जीवित और अनुमानित समय को अलग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tanggal yang anda ketahui. DoneAt memisahkan waktu hidup dan waktu yang diproyeksikan tanpa mengubah perkiraan menjadi sejarah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le date che conosci. DoneAt separa il tempo vissuto da quello previsto senza trasformare le stime in storia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかっている日付を追加します。 DoneAt は、推定値を履歴に変えることなく、実際の時間と予測時間を分離します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 알고 있는 날짜를 추가하세요. DoneAt는 추정치를 기록으로 전환하지 않고 실제 시간과 예상 시간을 분리합니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला माहीत असलेल्या तारखा जोडा. DoneAt अंदाजांना इतिहासात न बदलता जिवंत आणि प्रक्षेपित वेळ वेगळे करते."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as datas que você conhece. DoneAt separa o tempo vivido do projetado sem transformar estimativas em histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте даты, которые вы знаете. DoneAt разделяет прожитое и прогнозируемое время, не превращая оценки в историю."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มวันที่ที่คุณทราบ DoneAt แยกเวลาจริงและเวลาที่คาดการณ์ไว้โดยไม่ต้องเปลี่ยนการประมาณการให้เป็นประวัติศาสตร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiğiniz tarihleri ekleyin. DoneAt, tahminleri tarihe dönüştürmeden yaşanan ve öngörülen zamanı ayırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ngày tháng mà bạn biết. DoneAt tách biệt thời gian sống và thời gian dự kiến ​​mà không biến ước tính thành lịch sử."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "知道哪些日期就填哪些。DoneAt 会分开已经走过与未来推算，不把估算写成历史。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "加埋你識嘅日期。 DoneAt 將生活同投射嘅時間分開，而唔會將估計轉化為歷史。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "新增您知道的日期。 DoneAt 將生活時間和預計時間分開，而不將估計值變成歷史。"
          }
        }
      }
    },

    "lifeEmptyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنة الميلاد وسن التقاعد يكفيان لرسم حياتك في العمل، أسبوعًا بأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geburtsjahr und Rentenalter genügen, um dein Arbeitsleben Woche für Woche zu zeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A birth year and a retirement age are enough to draw your working life, week by week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el año de nacimiento y la edad de jubilación basta para dibujar tu vida laboral, semana a semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une année de naissance et un âge de retraite suffisent à dessiner votre vie de travail, semaine après semaine."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्म का वर्ष और सेवानिवृत्ति की उम्र भर दें, तो आपका काम का जीवन हफ़्ता-दर-हफ़्ता बन जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahun lahir dan usia pensiun sudah cukup untuk menggambar hidup kerjamu, minggu demi minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastano anno di nascita ed età della pensione per disegnare la tua vita lavorativa, settimana per settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生まれた年と退職の年齢があれば、働く人生を一週ずつ描けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태어난 해와 은퇴 나이만 있으면 일하는 인생을 한 주씩 그릴 수 있습니다."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्माचे वर्ष आणि निवृत्तीचे वय पुरेसे आहे — तुमचे कामाचे आयुष्य आठवड्यागणिक दिसू लागेल."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta o ano de nascimento e a idade da reforma para desenhar a sua vida de trabalho, semana a semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Года рождения и возраста выхода на пенсию достаточно, чтобы нарисовать вашу рабочую жизнь неделя за неделей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แค่ปีเกิดกับอายุเกษียณก็พอวาดชีวิตการทำงานของคุณได้ทีละสัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum yılı ve emeklilik yaşı, çalışma yaşamını hafta hafta çizmek için yeter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần năm sinh và tuổi nghỉ hưu là đã vẽ được cuộc đời đi làm của bạn, từng tuần một."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "有出生年份和退休年龄，就能一周一周地画出你的工作人生。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",

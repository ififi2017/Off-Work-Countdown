{
  "name": "@doneat/billing-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "keys": "node scripts/generate-keys.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply billing --local",
    "db:remote": "node scripts/check-deploy.mjs && wrangler d1 migrations apply billing --remote",
    "secrets": "node scripts/upload-secrets.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "license": "MPL-2.0"
}

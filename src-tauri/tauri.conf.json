{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Off Work Countdown",
  "version": "3.1.1",
  "identifier": "com.rainif.offworkcountdown",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Off Work Countdown",
        "url": "en.html",
        "width": 430,
        "height": 430,
        "minWidth": 420,
        "minHeight": 420,
        "maxWidth": 450,
        "maxHeight": 450,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "French",
          "German",
          "Spanish",
          "Italian",
          "Portuguese",
          "Russian",
          "Turkish",
          "Arabic",
          "Vietnamese"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ififi2017/Off-Work-Countdown/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5N0FBMzA5NDU0RTNCNUEKUldSYU8wNUZDYU42V1hCMWE5b3dwbkZqSDR1UUZsOGtuMDRUMGxSYmlMQlpwZFdJbG5xYXpLaXoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

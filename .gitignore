# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# serwist (generated service worker)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/workbox-*.js

# production
/build

# misc
.DS_Store
*.pem
/.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# Development certificate
devcert.pfx

# npm run pack:msix 把包放在仓库根目录。这台机器的全局 gitignore 恰好忽略了
# *.msix，别人的机器不会——少了这两行，一个 5MB 的包随时可能被 git add . 带进来。
*.msix
*.msixbundle

# 由 scripts/generate-macos-lproj.mjs 从 docs/msstore-listing-titles.csv 生成，
# 每次 beforeBuildCommand 重建。入库会多出一份需要手工同步的名称副本。
/src-tauri/macos-lproj/
